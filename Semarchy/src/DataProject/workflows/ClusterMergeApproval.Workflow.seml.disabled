            notificationsOnTaskAssignment:
              toAssignee: true
              toCandidates: true
            notificationsOnTaskExpiration:
              toAdmin: false
              toCandidatesOrAssignee: false
            notificationsOnWorkflowDueDate:
              toCandidatesOrAssignee: false
            taskType: DATA_AUTHORING
            application: DataProject.applications.CustomerHub
            assigneeRequiredRole: MDM_Digital_Steward
            entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
            stepper: DataProject.entities.CustomerLegalAccount.steppers.ClusterReviewDC
            transitions:
              - _name: SubmitDecision
                _type: UserTaskTransition
                label: Submit Decision
                behaviorOnTransition: KEEP_DATA
                showWaitDialog: true
                transitionParameters:
                  attachmentParamRequired: false
                  attachmentParamSupported: true
                  commentParamRequired: false
                  commentParamSupported: false
                  descriptionParamSupported: false
                  dueDateParamRequired: false
                  dueDateParamSupported: false
                  nextTaskAssigneeRequired: false
                  nextTaskAssigneeSupported: false
                  priorityParamSupported: false
                userTaskCompletionRequired: true
                bendPoints: []
                toStep: DataProject.workflows.ClusterMergeApproval.Review_MT_IZ_LG_CO_PT_DC.DigitalBranch.DigitalEnd
          - _name: DigitalEnd
            _type: BranchEndEvent
            position:
              x: 700
              y: 0
    transition:
      _name: outgoing
      _type: ParallelBlockTransition
      toStep: DataProject.workflows.ClusterMergeApproval.ClustersAgree
      bendPoints: []
  - _name: ClustersAgree
    _type: Router
    label: Any Reject or Remerge?
    position:
      x: 700
      y: 0
    routes:
      - _name: Conflict
        _type: Route
        index: 0
        label: Reject / Remerge - Group Steward decides
        condition: ANY CurrentDataSet.CustomerLegalAccount.MergeApprovalLog HAVE (UPPER(Decision) IN ('REJECTED', 'REMERGE') AND (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate))
        toStep: DataProject.workflows.ClusterMergeApproval.GroupStewardApproval
        bendPoints: []
      - _name: AllConfirmed
        _type: Route
        index: 1
        label: All reviewing clusters confirmed
        toStep: DataProject.workflows.ClusterMergeApproval.SubmitChange
        bendPoints: []
  - _name: GroupStewardApproval
    _type: UserTask
    label: Group Steward Review
    position:
      x: 950
      y: -200
    assigneeCanRelease: true
    myTasksConfiguration:
      collection: DataProject.entities.CustomerLegalAccount.Collections.CustomerDuplicateView
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      toAdmin: false
      toCandidatesOrAssignee: false
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    application: DataProject.applications.CustomerHub
    assigneeRequiredRole: MDM_Group_Steward
    entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
    stepper: DataProject.entities.CustomerLegalAccount.steppers.ClusterReviewGroupSteward
    transitions:
      - _name: SubmitDecision
        _type: UserTaskTransition
        label: Submit Decision
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          attachmentParamRequired: false
          attachmentParamSupported: true
          commentParamRequired: false
          commentParamSupported: false
          descriptionParamSupported: false
          dueDateParamRequired: false
          dueDateParamSupported: false
          nextTaskAssigneeRequired: false
          nextTaskAssigneeSupported: false
          priorityParamSupported: false
        userTaskCompletionRequired: true
        bendPoints: []
        toStep: DataProject.workflows.ClusterMergeApproval.SubmitChange
        transitionValidations:
          - onTransitionFinish: SKIP
            validationType: CHECK
            validator: DataProject.entities.CustomerLegalAccount.Validations.RequireDuplicateCheckConfirmation
          - onTransitionFinish: BLOCK
            validationType: CHECK
            validator: DataProject.entities.CustomerLegalAccount.Validations.RequireGroupStewardDecision
  - _name: SubmitChange
    _type: SubmitAutomation
    label: Publish (submit merge decision)
    position:
      x: 1200
      y: 0
    integrationJob: DataProject.ModelJobs.LoadMergeDecision
    submitUserExpression: WorkflowInstance.InitiatorName
    transition:
      _name: outgoing
      _type: AutomationTransition
      bendPoints: []
      label: Outgoing
      toStep: DataProject.workflows.ClusterMergeApproval.End
  - _name: End
    _type: EndEvent
    position:
      x: 1450
      y: 0
