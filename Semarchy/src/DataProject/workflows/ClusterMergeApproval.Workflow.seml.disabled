# Cluster Merge Approval - started automatically, no manual cluster selection.
#
# Trigger: completion of a LoadCustomer360 batch (the Duplicate Manager job). One instance per golden record
#   that entered PENDING in that batch (MergeApprovalStatus = PENDING and ApprovalRequestedBatchID = BatchID).
#   EvaluateMergeDecision sets PENDING when the golden has more than one master (merged) and its consolidated
#   group spans more than one cluster, unless that composition was already approved or the merge was done by
#   a Group Steward.
# Initiator: replaced right after the start by the user who did the merge (ApprovalRequestedBy, i.e. the
#   steward who submitted the merge), so the final submit and 'Workflows I Initiated' show that user.
# Cluster tasks: router RouteByClusters picks the parallel block for exactly the clusters involved
#   (SelReview<code> = true, computed by DeriveApprovalClusters): 63 blocks Review_<codes>, one for each
#   combination of the 6 clusters, each with one Review Duplicate task per involved cluster.
#   (A router inside a parallel branch is rejected by the Semarchy build, hence the combinations.)
# After all branches: any REJECTED decision in this cycle -> Group Steward (Approve Merge / Take Over);
#   otherwise submit. Submit uses LoadMergeDecision; any decision of this cycle sets MergeApprovalStatus =
#   CONFIRMED, so SyncCustomer / CustomerMerge publish the record at the end of Approve Merge, Take Over or
#   when all clusters confirm. After a Take Over the Group Steward demerges / modifies in the Duplicate
#   Manager; merges done by a Group Steward do not request a new cluster approval.
# Generated file - regenerate rather than edit by hand.
# Previous version (manual cluster selection, 63 parallel blocks): ClusterMergeApproval.Workflow.seml.manual-selection
# Tasks: "<Cluster> Review" (one stepper per cluster: ClusterReview<code>) and "Group Steward Review".
#   One transition "Submit Decision"; the decision (Confirm / Reject / Remerge) and comment are taken from the
#   Merge Approval Log row added in the stepper (RequireClusterDecision<code> / RequireGroupStewardDecision).
_name: ClusterMergeApproval
_type: Workflow
_package: DataProject.workflows
label: Cluster Merge Approval
generalProperties:
  attachmentMimeTypes: '*'
  attachmentMaxFileCount: 5
  attachmentMaxFileSize: 10000
notifications:
  workflowAdminOnDueDate: true
dataScope:
  - _name: CustomerLegalAccount
    _type: RootEntity
    cardinality: SINGLE_RECORD
    entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
    childEntities:
      - ref: DataProject.references.Profile_Cgid
      - ref: DataProject.references.MergeApprovalLogs_CustomerLegalAccount
retentionPolicy:
  retentionTimeUnit: DAYS
  retentionType: FOREVER
steps:
  - _name: StartOnMerge
    _type: StartFromCompleteBatchEvent
    label: Merge done (multi-cluster)
    defaultPriority: NORMAL
    position:
      x: -400
      y: 0
    initiatedAs: MERGE_WORKFLOW_START
    integrationJob: DataProject.ModelJobs.LoadCustomer360
    dataRecordOutputs:
      - _name: MergedCustomer
        _type: DataRecordOutput
        rootEntity: DataProject.workflows.ClusterMergeApproval.CustomerLegalAccount
        dataRecordSourceType: GOLDEN_DATA
        conditionOnDataRecord: MergeApprovalStatus = 'PENDING' AND ApprovalRequestedBatchID = BatchID
    transition:
      _name: outgoing
      _type: StartEventTransition
      toStep: DataProject.workflows.ClusterMergeApproval.SetInitiatorToMerger
      bendPoints: []
  - _name: SetInitiatorToMerger
    _type: SetWorkflowMetadataAutomation
    label: Initiator = user who merged
    position:
      x: -280
      y: 0
    workflowMetadataChanges:
      - workflowMetadata: INITIATOR_NAME
        expression: CurrentDataSet.CustomerLegalAccount.ApprovalRequestedBy
    transition:
      _name: outgoing
      _type: AutomationTransition
      bendPoints: []
      label: Outgoing
      toStep: DataProject.workflows.ClusterMergeApproval.RouteByClusters
  - _name: RouteByClusters
    _type: Router
    label: Which clusters review?
    position:
      x: 0
      y: 0
    routes:
      - _name: R_MT
        _type: Route
        index: 0
        label: Maritime
        condition: CurrentDataSet.CustomerLegalAccount.SelReviewMT = 'true' AND (CurrentDataSet.CustomerLegalAccount.SelReviewIZ IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewIZ <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewLG IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewLG <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewCO IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewCO <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewPT IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewPT <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewDC IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewDC <> 'true')
        toStep: DataProject.workflows.ClusterMergeApproval.Review_MT
        bendPoints: []
      - _name: R_IZ
        _type: Route
        index: 1
        label: Industrial Zone
        condition: (CurrentDataSet.CustomerLegalAccount.SelReviewMT IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewMT <> 'true') AND CurrentDataSet.CustomerLegalAccount.SelReviewIZ = 'true' AND (CurrentDataSet.CustomerLegalAccount.SelReviewLG IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewLG <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewCO IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewCO <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewPT IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewPT <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewDC IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewDC <> 'true')
        toStep: DataProject.workflows.ClusterMergeApproval.Review_IZ
        bendPoints: []
      - _name: R_LG
        _type: Route
        index: 2
        label: Logistics
        condition: (CurrentDataSet.CustomerLegalAccount.SelReviewMT IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewMT <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewIZ IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewIZ <> 'true') AND CurrentDataSet.CustomerLegalAccount.SelReviewLG = 'true' AND (CurrentDataSet.CustomerLegalAccount.SelReviewCO IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewCO <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewPT IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewPT <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewDC IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewDC <> 'true')
        toStep: DataProject.workflows.ClusterMergeApproval.Review_LG
        bendPoints: []
      - _name: R_CO
        _type: Route
        index: 3
        label: Corp
        condition: (CurrentDataSet.CustomerLegalAccount.SelReviewMT IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewMT <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewIZ IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewIZ <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewLG IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewLG <> 'true') AND CurrentDataSet.CustomerLegalAccount.SelReviewCO = 'true' AND (CurrentDataSet.CustomerLegalAccount.SelReviewPT IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewPT <> 'true') AND (CurrentDataSet.CustomerLegalAccount.SelReviewDC IS NULL OR CurrentDataSet.CustomerLegalAccount.SelReviewDC <> 'true')
