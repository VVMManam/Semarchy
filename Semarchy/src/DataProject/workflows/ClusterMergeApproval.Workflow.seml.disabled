  - _name: Review_MT
    _type: ParallelBlock
    label: 'Cluster Reviews: Maritime'
    position:
      x: 240
      y: 0
    branches:
      - _name: MaritimeBranch
        _type: Branch
        label: Maritime Review
        index: 0
        steps:
          - _name: MaritimeStart
            _type: BranchStartEvent
            position:
              x: 0
              y: 0
            transition:
              _name: outgoing
              _type: StartEventTransition
              toStep: DataProject.workflows.ClusterMergeApproval.Review_MT.MaritimeBranch.ReviewDuplicate_Maritime
              bendPoints: []
          - _name: ReviewDuplicate_Maritime
            _type: UserTask
            label: Maritime Review
            position:
              x: 300
              y: 0
            assigneeCanRelease: true
            myTasksConfiguration:
              collection: DataProject.entities.CustomerLegalAccount.Collections.CustomerDuplicateView
            notificationsOnTaskAssignment:
              toAssignee: true
              toCandidates: true
            notificationsOnTaskExpiration:
              toAdmin: false
              toCandidatesOrAssignee: false
            notificationsOnWorkflowDueDate:
              toCandidatesOrAssignee: false
            taskType: DATA_AUTHORING
            application: DataProject.applications.CustomerHub
            assigneeRequiredRole: MDM_Maritime_Steward
            entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
            stepper: DataProject.entities.CustomerLegalAccount.steppers.ClusterReviewMT
            transitions:
              - _name: SubmitDecision
                _type: UserTaskTransition
                label: Submit Decision
                behaviorOnTransition: KEEP_DATA
                showWaitDialog: true
                transitionParameters:
                  attachmentParamRequired: false
                  attachmentParamSupported: true
                  commentParamRequired: false
                  commentParamSupported: false
                  descriptionParamSupported: false
                  dueDateParamRequired: false
                  dueDateParamSupported: false
                  nextTaskAssigneeRequired: false
                  nextTaskAssigneeSupported: false
                  priorityParamSupported: false
                userTaskCompletionRequired: true
                bendPoints: []
                toStep: DataProject.workflows.ClusterMergeApproval.Review_MT.MaritimeBranch.MaritimeEnd
          - _name: MaritimeEnd
            _type: BranchEndEvent
            position:
              x: 700
              y: 0
    transition:
      _name: outgoing
      _type: ParallelBlockTransition
      toStep: DataProject.workflows.ClusterMergeApproval.ClustersAgree
      bendPoints: []
