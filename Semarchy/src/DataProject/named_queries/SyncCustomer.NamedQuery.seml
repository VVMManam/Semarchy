        semQlExpression: Exemption
      - _name: NoVATDeclaration
        _type: ObjectProperty
        type: VALUE
        semQlExpression: NoVATDeclaration
      # --- License fields (flattened: a nested SINGLE_RECORD tag needs a reference, and License is the same record) ---
      - _name: LicenseNumber
        _type: ObjectProperty
        type: VALUE
        semQlExpression: LicenseNumber
      - _name: LicenseIssuingEmirateId
        _type: ObjectProperty
        type: VALUE
        semQlExpression: IssuingEmirateId
      - _name: LicenseIssuingEmirateName
