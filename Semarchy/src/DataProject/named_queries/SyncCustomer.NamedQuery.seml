        _type: ObjectProperty
        type: VALUE
        semQlExpression: LicenseStatusCode
      - _name: LicenseType
        _type: ObjectProperty
        type: VALUE
        semQlExpression: LicenseType
      - _name: LicenseStage
        _type: ObjectProperty
        type: VALUE
        semQlExpression: LicenseStage
      # --- child collections / related records ---
      # TODO verify: relationship role name (child role from Customer -> Identifier)
      - _name: LicenseActivity
        _type: ObjectProperty
        type: MULTI_RECORDS
        semQlExpression: LicenseActivity
        targetObject: DataProject.named_queries.SyncCustomer.LicenseActivity
      # --- child collections / related records ---
      # TODO verify: relationship role name (child role from Customer -> Identifier)
      - _name: Identifier
        _type: ObjectProperty
        type: MULTI_RECORDS
        semQlExpression: Identifier
        targetObject: DataProject.named_queries.SyncCustomer.Identifier
      # --- child collections / related records ---
      # TODO verify: relationship role name (child role from Customer -> VATInfo)
      - _name: TaxRegistration
        _type: ObjectProperty
        type: MULTI_RECORDS
        semQlExpression: TaxRegistration
        targetObject: DataProject.named_queries.SyncCustomer.TaxRegistration
      # TODO verify: relationship role name (child role from Customer -> Address)
      - _name: Address
        _type: ObjectProperty
        type: MULTI_RECORDS
        semQlExpression: Address
        targetObject: DataProject.named_queries.SyncCustomer.Address
      # TODO verify: relationship role name (child role from Customer -> Profile)
      - _name: Profile
        _type: ObjectProperty
        type: MULTI_RECORDS
        semQlExpression: Profile
        targetObject: DataProject.named_queries.SyncCustomer.Profile
      # TODO verify: Contact is a single object in the source JSON - confirm
      # whether this is genuinely a to-one relationship (SINGLE_RECORD) or
      # should be MULTI_RECORDS returning only the first/primary contact
      - _name: Contact
        _type: ObjectProperty
        type: MULTI_RECORDS
        semQlExpression: Contact
        targetObject: DataProject.named_queries.SyncCustomer.Contact
      # TODO verify: relationship role name (child role from Customer -> DepartmentalAccount)
      - _name: CustomerOrgAssignment
        _type: ObjectProperty
        type: MULTI_RECORDS
        semQlExpression: CustomerOrgAssignment
        targetObject: DataProject.named_queries.SyncCustomer.DepartmentalAccount
