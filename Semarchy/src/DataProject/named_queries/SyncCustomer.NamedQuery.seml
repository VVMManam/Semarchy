        semQlExpression: IssuingAuthority
      - _name: LicenseIssuingCountry
        _type: ObjectProperty
        type: VALUE
        semQlExpression: IssuingAuthorityCode.FID_CountryCode
      - _name: LicenseRegistrationDate
        _type: ObjectProperty
        type: VALUE
        semQlExpression: LicenseRegistrationDate
      - _name: LicenseIssueDate
        _type: ObjectProperty
        type: VALUE
        semQlExpression: LicenseIssueDate
