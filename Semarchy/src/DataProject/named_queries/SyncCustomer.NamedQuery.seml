_name: SyncCustomer
_type: NamedQuery
_package: DataProject.named_queries
active: true
queryParameters:
  # Keyset-paging cursor: pass the CustomerLegalAccountID of the LAST record
  # from the previous page. First call = 0. Never repeats a record.
  - _name: LastCustomerLegalAccountID
    _type: QueryParameter
    bindingName: PARAM_LAST_ID
    dataType: NUMBER
    mandatory: false
    defaultValue: '0'
  # Optional batch window. Leave empty to fetch all records.
  - _name: FromBatchID
    _type: QueryParameter
    bindingName: PARAM_FROM_BATCH_ID
    dataType: NUMBER
    mandatory: false
    defaultValue: 'null'
  - _name: ToBatchID
    _type: QueryParameter
    bindingName: PARAM_TO_BATCH_ID
    dataType: NUMBER
    mandatory: false
    defaultValue: 'null'
filter: >-
  CustomerLegalAccountID > Coalesce(:PARAM_LAST_ID, 0)
    and (:PARAM_FROM_BATCH_ID is null or BatchID > :PARAM_FROM_BATCH_ID)
    and (:PARAM_TO_BATCH_ID is null or BatchID <= :PARAM_TO_BATCH_ID)
    and (MergeApprovalStatus is null or MergeApprovalStatus in ('NOT_REQUIRED', 'CONFIRMED'))
sort: CustomerLegalAccountID asc
defaultLimit: 1000
queryObjects:
  # ---------------------------------------------------------------------
  # ROOT: Customer
  # TODO verify: actual entity path for the Customer golden entity
  # ---------------------------------------------------------------------
  - _name: CustomerLegalAccount
    _type: QueryObject
    entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
    objectProperties:
      # Cursor for paging - send the last record's value as LastCustomerLegalAccountID
      - _name: CustomerLegalAccountID
        _type: ObjectProperty
        type: VALUE
        semQlExpression: CustomerLegalAccountID
      - _name: OperationType
        _type: ObjectProperty
        type: VALUE
        semQlExpression: OperationType
      - _name: AccountId
        _type: ObjectProperty
        type: VALUE
        semQlExpression: AccountId
      - _name: AccountCreationDate
