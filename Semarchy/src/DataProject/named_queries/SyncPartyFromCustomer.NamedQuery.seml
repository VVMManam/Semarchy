_name: SyncPartyFromCustomer
_type: NamedQuery
_package: DataProject.named_queries
description: "API 1 of the Party Creation Callback design (ADPG-MDM-INT-PTY-001 v1.1). Golden CustomerLegalAccount records of a batch window that still have no Party, returned with Party attribute names. Published to OSB by a data notification (REST target, trigger on batch completion; FromBatchID = LOW_BATCH_ID, ToBatchID = HIGH_BATCH_ID). Replay: pass CustomerLegalAccountID (one record) or ToBatchID only (reconciliation, page with offset / limit)."
active: true
queryParameters:
  - _name: CustomerLegalAccountID
    _type: QueryParameter
    bindingName: PARAM_ID
    dataType: NUMBER
    mandatory: false
    defaultValue: 'null'
  - _name: FromBatchID
    _type: QueryParameter
    bindingName: PARAM_FROM_BATCH_ID
    dataType: NUMBER
    mandatory: false
    defaultValue: 'null'
  - _name: ToBatchID
    _type: QueryParameter
    bindingName: PARAM_TO_BATCH_ID
    dataType: NUMBER
    mandatory: false
    defaultValue: 'null'
filter: >-
  (:PARAM_ID is not null or :PARAM_TO_BATCH_ID is not null)
  and (:PARAM_ID is null or CustomerLegalAccountID = :PARAM_ID)
  and (:PARAM_FROM_BATCH_ID is null or BatchID > :PARAM_FROM_BATCH_ID)
  and (:PARAM_TO_BATCH_ID is null or BatchID <= :PARAM_TO_BATCH_ID)
  and FID_Pgid is null
  and (MergeApprovalStatus is null or MergeApprovalStatus in ('NOT_REQUIRED', 'CONFIRMED'))
sort: CustomerLegalAccountID asc
defaultLimit: 1000
queryObjects:
  - _name: Record
    _type: QueryObject
    entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
    objectProperties:
      - _name: OperationType
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "'PartyCreation'"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: CustomerLegalAccountID
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "CustomerLegalAccountID"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: SourceID
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "CustomerGoldenId"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: PartyNameEn
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "NameEN"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: PartyNameAr
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "NameAr"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: LicenceKey
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "LicenseNumber"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: LicenceAuthorityCode
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "FID_IssuingAuthorityCode"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: LicenceCountry
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "IssuingAuthorityCode.FID_CountryCode"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: PartyTypeCode
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "CustomerTypeCode"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: RegistrationCountry
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "FID_RegistrationCountry"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: RegistrationEmirateCode
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "FID_RegistrationEmirateCode"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: IsBranch
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "IsBranch"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: BranchQualifier
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "BranchQualifier"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: IsInternalEntity
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "CASE WHEN AccountType IN ('ADPorts ICP', 'ADPorts RP', 'ADQ ICP', 'ADQ RP', 'Internal') THEN 1 ELSE 0 END"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: PartyStatusCode
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "CustomerStatusCode"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
      - _name: PrimaryPublisherCode
        _type: ObjectProperty
        type: VALUE
        semQlExpression: "'CRM'"
        targetObject: DataProject.named_queries.SyncPartyFromCustomer.Record
rootQueryObject: DataProject.named_queries.SyncPartyFromCustomer.Record
