_name: ResolveIdentifierType
_type: JavaPluginEnricher
_package: DataProject.entities.Identifier.enrichers
entity: DataProject.entities.Identifier.Identifier
label: Resolve Identifier Type
enricherExecutionScope: PRE_CONSO
numberOfRetry: 3
onErrorBehavior: SKIP_RECORDS
pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CUSTOM_SQL
    value: select 'SRC|' || upper(trim(identifier_type_code)) LOOKUP_COLUMN,
                   identifier_type_code OUTPUT_COLUMN1
            from gd_identifier_type
            where identifier_type_code is not null
            union
            select 'SRC|' || upper(trim(fusion_code)) LOOKUP_COLUMN,
                   identifier_type_code OUTPUT_COLUMN1
            from gd_identifier_type
            where fusion_code is not null
            union
            select 'SRC|' || upper(trim(crm_code)) LOOKUP_COLUMN,
                   identifier_type_code OUTPUT_COLUMN1
            from gd_identifier_type
            where crm_code is not null
            union
            select 'MDM|' || upper(trim(identifier_type_code)) LOOKUP_COLUMN,
                   identifier_type_code OUTPUT_COLUMN1
            from gd_identifier_type

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_FALLBACK

  - paramName: PARAM_CACHE
    value: LOAD_ON_START

pluginInputs:
  - expression: "CASE WHEN FID_IdentifierType IS NOT NULL THEN 'MDM|' || UPPER(BTRIM(FID_IdentifierType)) WHEN IdentifierTypeSource IS NOT NULL THEN 'SRC|' || UPPER(BTRIM(IdentifierTypeSource)) ELSE NULL END"
    inputName: IN_LOOKUP_VALUE

pluginOutputs:
  - attributeName: FID_IdentifierType
    outputName: OUT_RESULT1

processingBatchSize: 100
threadPoolSize: 1
