_type: SemQLEnricher
_package: DataProject.entities.Address.enrichers
_name: NormalizePoBox
entity: DataProject.entities.Address.Address
label: Normalize PO Box
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
  - attributeName: PoBox
    expression: |-
      NULLIF(REGEXP_REPLACE(COALESCE(PoBox, CASE WHEN REGEXP_LIKE(UPPER(AddressLine1), 'P\.?\s*O\.?\s*BOX\s*[:.#-]?\s*(NO\.?)?\s*[0-9]') THEN REGEXP_REPLACE(UPPER(AddressLine1), '^.*P\.?\s*O\.?\s*BOX\s*[:.#-]?\s*(NO\.?)?\s*([0-9,]+).*$', '\2') END), '[^0-9]', '', 'g'), '')
  - attributeName: CityNormalised
    expression: |-
      BTRIM(REGEXP_REPLACE(REGEXP_REPLACE(UPPER(City), '[^A-Z0-9 ]', ' ', 'g'), '\s+', ' ', 'g'))
