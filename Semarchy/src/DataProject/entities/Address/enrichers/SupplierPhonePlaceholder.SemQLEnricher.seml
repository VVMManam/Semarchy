_name: SupplierPhonePlaceholder
_type: SemQLEnricher
_package: DataProject.entities.Address.enrichers
entity: DataProject.entities.Address.Address
label: Supplier Phone Placeholder
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
  - attributeName: Phone
    expression: |-
      CASE WHEN (FID_SupplierSite IS NOT NULL OR SourceID_SupplierSite IS NOT NULL)
        AND Phone IS NOT NULL
        AND REGEXP_LIKE(
              REGEXP_REPLACE(Phone,'[^0-9]','','g'),
              '^((\d)\2*|1234567890|123456789|12345678|1234567|123456|12345|1234|123|0987654321|987654321|87654321|7654321|654321|54321|4321)$')
        THEN NULL
        ELSE Phone
      END