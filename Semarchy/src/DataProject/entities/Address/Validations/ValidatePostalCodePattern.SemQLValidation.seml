_name: ValidatePostalCodePattern
_type: SemQLValidation
_package: DataProject.entities.Address.Validations
entity: DataProject.entities.Address.Address
label: Validate Postal Code Pattern
condition: >-
  PostalCode is null or (
    (FID_CountryCode = 'US' and REGEXP_LIKE(PostalCode, '^[0-9]{5}(-[0-9]{4})?$'))
    or (FID_CountryCode = 'CA' and REGEXP_LIKE(PostalCode, '^[A-Z][0-9][A-Z] ?[0-9][A-Z][0-9]$'))
    or (FID_CountryCode = 'GB' and REGEXP_LIKE(PostalCode, '^[A-Z]{1,2}[0-9][A-Z0-9]? [0-9][A-Z]{2}$'))
    or (FID_CountryCode = 'IN' and REGEXP_LIKE(PostalCode, '^[0-9]{6}$'))
    or (FID_CountryCode = 'PK' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'EG' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'SA' and REGEXP_LIKE(PostalCode, '^[0-9]{5}(-[0-9]{4})?$'))
    or (FID_CountryCode = 'FR' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'DE' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'IT' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'ES' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'NL' and REGEXP_LIKE(PostalCode, '^[0-9]{4} ?[A-Z]{2}$'))
    or (FID_CountryCode = 'BE' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'CH' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'AT' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'SE' and REGEXP_LIKE(PostalCode, '^[0-9]{3} ?[0-9]{2}$'))
    or (FID_CountryCode = 'NO' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'DK' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'FI' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'PL' and REGEXP_LIKE(PostalCode, '^[0-9]{2}-[0-9]{3}$'))
    or (FID_CountryCode = 'PT' and REGEXP_LIKE(PostalCode, '^[0-9]{4}-[0-9]{3}$'))
    or (FID_CountryCode = 'IE' and REGEXP_LIKE(PostalCode, '^[A-Z0-9]{3} ?[A-Z0-9]{4}$'))
    or (FID_CountryCode = 'AU' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'NZ' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'JP' and REGEXP_LIKE(PostalCode, '^[0-9]{3}-[0-9]{4}$'))
    or (FID_CountryCode = 'CN' and REGEXP_LIKE(PostalCode, '^[0-9]{6}$'))
    or (FID_CountryCode = 'BR' and REGEXP_LIKE(PostalCode, '^[0-9]{5}-[0-9]{3}$'))
    or (FID_CountryCode = 'MX' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'RU' and REGEXP_LIKE(PostalCode, '^[0-9]{6}$'))
    or (FID_CountryCode = 'ZA' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'TR' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'KR' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'SG' and REGEXP_LIKE(PostalCode, '^[0-9]{6}$'))
    or (FID_CountryCode = 'MY' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'PH' and REGEXP_LIKE(PostalCode, '^[0-9]{4}$'))
    or (FID_CountryCode = 'KW' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or (FID_CountryCode = 'BH' and REGEXP_LIKE(PostalCode, '^[0-9]{3,4}$'))
    or (FID_CountryCode = 'OM' and REGEXP_LIKE(PostalCode, '^[0-9]{3}$'))
    or (FID_CountryCode = 'JO' and REGEXP_LIKE(PostalCode, '^[0-9]{5}$'))
    or FID_CountryCode not in (
      'US','CA','GB','IN','PK','EG','SA','FR','DE','IT','ES','NL','BE','CH','AT',
      'SE','NO','DK','FI','PL','PT','IE','AU','NZ','JP','CN','BR','MX','RU','ZA',
      'TR','KR','SG','MY','PH','KW','BH','OM','JO'
    )
  )
validationScope: POST_CONSO