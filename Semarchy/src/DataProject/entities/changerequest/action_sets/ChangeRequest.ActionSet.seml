_name: ChangeRequest
_package: DataProject.entities.changerequest.action_sets
_type: ActionSet
entity: DataProject.entities.changerequest.changerequest
label: Change Request Action Set
defaultActionSet: false
actions:
  - _name: CreateChangeRequest
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: DataProject.entities.changerequest.steppers.ChangeRequest
  - _name: EditChangeRequest
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: DataProject.entities.changerequest.steppers.ChangeRequest
  - _name: CopyChangeRequest
    label: Copy
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CopyAction
    multipleSelectionAllowed: true
    stepper: DataProject.entities.changerequest.steppers.ChangeRequest
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportChangeRequest
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: DataProject.entities.changerequest.steppers.ChangeRequest