_type: SemQLEnricher
_name: FillReviewerDetailsPT
label: Fill Reviewer Details (Ports Review)
_package: DataProject.entities.MergeApprovalLogs.enrichers
entity: DataProject.entities.MergeApprovalLogs.MergeApprovalLogs
enricherExecutionScope: NONE
description: 'PORTS cluster review decision form: cluster, role and task come from the task (not from the user roles). Task Assigned On = when the approval was requested; if the task was reassigned and another steward takes over the row, it is the time that steward picks it up. Reviewer and Decision Taken On always follow the steward who edits the row.'
semQlEnricherExpressions:
  - attributeName: ReviewerUsername
    expression: CASE WHEN (ClusterCode IS NULL OR UPPER(ClusterCode) = 'PORTS') THEN :V_USERNAME ELSE ReviewerUsername END
  - attributeName: ReviewerFullName
    expression: CASE WHEN (ClusterCode IS NULL OR UPPER(ClusterCode) = 'PORTS') AND (ReviewerFullName IS NULL OR (ReviewerUsername IS NOT NULL AND ReviewerUsername <> :V_USERNAME)) THEN BTRIM(COALESCE(:V_USER_FIRSTNAME, '') || ' ' || COALESCE(:V_USER_LASTNAME, '')) ELSE ReviewerFullName END
  - attributeName: ReviewerRole
    expression: COALESCE(ReviewerRole, 'MDM_Ports_Steward')
  - attributeName: ClusterCode
    expression: COALESCE(ClusterCode, 'PORTS')
  - attributeName: ClusterName
    expression: COALESCE(ClusterName, 'Ports')
  - attributeName: TaskStartTime
    expression: CASE WHEN NOT (ClusterCode IS NULL OR UPPER(ClusterCode) = 'PORTS') THEN TaskStartTime WHEN TaskStartTime IS NULL THEN CustomerLegalAccount.ApprovalRequestedOn WHEN (ReviewerUsername IS NOT NULL AND ReviewerUsername <> :V_USERNAME) THEN DATE_TRUNC('second', NOW()) ELSE TaskStartTime END
  - attributeName: DecisionTimestamp
    expression: CASE WHEN (ClusterCode IS NULL OR UPPER(ClusterCode) = 'PORTS') THEN DATE_TRUNC('second', NOW()) ELSE DecisionTimestamp END
  - attributeName: CustomerGoldenId
    expression: COALESCE(CustomerGoldenId, CustomerLegalAccount.CustomerGoldenId)
  - attributeName: CreatedBy
    expression: COALESCE(CreatedBy, :V_USERNAME)
  - attributeName: CreatedDate
    expression: COALESCE(CreatedDate, NOW())
