sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
primaryKey: DataProject.entities.ContactPurpose.ContactPurpose.ContactPurposeId
entityType: FUZZY_MATCHED
matcher:
  _name: SemQLMatcherContactPurpose
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 98
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 95
  mergeThresholdMergingConfirmedWithNewMasters: 95
  mergeThresholdMergingConfirmedWithUnconfirmed: 95
  mergeThresholdMergingUnconfirmed: 95
  mergeThresholdMergingUnconfirmedWithNewMasters: 95
  mergeThresholdNewGroup: 90
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: false
  useTransitiveMatchScore: false
  matchRules:
    - _type: SemQLMatchRule
      _name: SameContactAndRole
      condition: |-
        Record1.FID_ContactId IS NOT NULL
        AND Record2.FID_ContactId IS NOT NULL
        AND Record1.FID_ContactId = Record2.FID_ContactId
        AND Record1.FID_ContactRoleCode IS NOT NULL
        AND Record2.FID_ContactRoleCode IS NOT NULL
        AND Record1.FID_ContactRoleCode = Record2.FID_ContactRoleCode
      label: "Same contact + same role - catches duplicates left behind after a contact-level merge (auto-merge)"
      matchScore: 100
      usingMatchOn: false
