_name: PartyParentNotSelf
_type: SemQLValidation
_package: DataProject.entities.Party.validations
entity: DataProject.entities.Party.Party
label: "A party cannot be its own parent"
validationScope: NONE
validationLabel: "A party cannot be its own parent party."
condition: |-
  FID_ParentPartyID IS NULL OR FID_ParentPartyID <> Pgid
