_name: PartyLicenceIdentityComplete
_type: SemQLValidation
_package: DataProject.entities.Party.validations
entity: DataProject.entities.Party.Party
label: "Party licence identity incomplete"
validationScope: PRE_CONSO
validationLabel: "A party with a licence number must also have the issuing authority and the licence country."
condition: |-
  LicenceKey IS NULL OR (LicenceAuthorityCode IS NOT NULL AND LicenceCountry IS NOT NULL)
