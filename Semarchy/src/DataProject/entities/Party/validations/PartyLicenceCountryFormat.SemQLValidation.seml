_name: PartyLicenceCountryFormat
_type: SemQLValidation
_package: DataProject.entities.Party.validations
entity: DataProject.entities.Party.Party
label: "Licence country is not an ISO-2 code"
validationScope: PRE_CONSO
validationLabel: "Licence country must be a two-letter ISO country code, for example AE."
condition: |-
  LicenceCountry IS NULL OR REGEXP_LIKE(LicenceCountry, '^[A-Z]{2}$')
