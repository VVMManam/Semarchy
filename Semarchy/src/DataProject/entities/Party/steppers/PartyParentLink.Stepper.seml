_name: PartyParentLink
_package: DataProject.entities.Party.steppers
_type: Stepper
entity: DataProject.entities.Party.Party
label: "Link to super party"
rootStep:
  _name: Root
  _type: CollectionStep
  label: "Parties"
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: DataProject.entities.Party.collection_views.PartyGolden
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: false
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations: []
  stepTriggers: []
  childSteps:
    - _name: Main
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: "Link to super party"
      formTab: DataProject.entities.Party.forms.PartyParentLink.Main
      formStepEnrichers: []
      referenceFormFieldConfigs: []
      formStepValidations:
        - validationType: CHECK
          executedOnDataChange: true
          executedOnFormOpen: false
          validator: DataProject.entities.Party.validations.PartyParentNotSelf
        - validationType: CHECK
          executedOnDataChange: true
          executedOnFormOpen: false
          validator: DataProject.entities.Party.validations.PartyParentNoCycle
      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: CHECK
          validator: DataProject.entities.Party.validations.PartyParentNotSelf
        - onStepExit: BLOCK
          validationType: CHECK
          validator: DataProject.entities.Party.validations.PartyParentNoCycle
      stepTriggers: []
stepperFinishValidations: []
triggers: []
