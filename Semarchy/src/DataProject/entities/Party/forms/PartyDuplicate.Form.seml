_package: DataProject.entities.Party.forms
_type: Form
_name: PartyDuplicate
entity: DataProject.entities.Party.Party
default: false
formTabs:
  - _name: Main
    _type: FormTab
    labelWidth: "180px"
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    label: "Party"
    iconUrl: images://mdi/domain.svg
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PartyHeaderSection
        label: "Party"
        layoutDirection: COLUMN
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PartyHeaderC
            layoutDirection: COLUMN
            content:
              - _name: PartyHeader
                value: "'<div style=\"margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45\">' || '<div style=\"display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap\">' || '<div style=\"flex:0 0 52px;width:52px;height:52px;border-radius:8px;background:#0B2A4A;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px\">PTY</div>' || '<div style=\"flex:1;min-width:280px\"><div style=\"font-size:18px;font-weight:500;line-height:1.2\">' || COALESCE(REPLACE(REPLACE(REPLACE(PartyNameEn, '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '—') || '</div>' || '<div style=\"font-size:13px;color:#66727F;margin-top:2px\">' || COALESCE(REPLACE(REPLACE(REPLACE(PartyNameAr, '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), '') || '</div>' || '<div style=\"margin-top:10px\">' || '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#0B2A4A;color:#FFFFFF;font-family:Consolas,Menlo,monospace;\">' || 'Party ID ' || TO_CHAR(Pgid, 'FM999999999999990') || '</span>' || CASE WHEN FID_ParentPartyID IS NULL THEN '' ELSE '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#EDE7F6;color:#3E2A6E;\">' || 'Member of ' || REPLACE(REPLACE(REPLACE(FDN_ParentPartyID, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') || '</span>' END || CASE WHEN LOOKUP count Pgid FROM ChildParty END > 0 THEN '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#3E2A6E;color:#FFFFFF;\">' || 'Super Party' || '</span>' WHEN LOOKUP count CustomerLegalAccountID FROM CustomerLegalAccount END > 0 AND LOOKUP count Sgid FROM SupplierLegalAccount END > 0 THEN '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;\">' || 'Customer &amp; Supplier' || '</span>' WHEN LOOKUP count CustomerLegalAccountID FROM CustomerLegalAccount END > 0 THEN '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#E3F2FD;color:#0D47A1;\">' || 'Customer' || '</span>' WHEN LOOKUP count Sgid FROM SupplierLegalAccount END > 0 THEN '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#EDE7F6;color:#4527A0;\">' || 'Supplier' || '</span>' ELSE '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#FFF8E1;color:#8A5A00;\">' || 'Not linked' || '</span>' END || CASE WHEN LicenceKey IS NULL THEN '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;\">' || 'No licence' || '</span>' ELSE '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;font-family:Consolas,Menlo,monospace;\">' || 'Licence ' || REPLACE(REPLACE(REPLACE(LicenceKey, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') || '</span>' END || CASE WHEN LicenceAuthorityCode IS NULL THEN '' ELSE '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;\">' || 'Authority ' || REPLACE(REPLACE(REPLACE(LicenceAuthorityCode, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') || '</span>' END || CASE WHEN LicenceCountry IS NULL THEN '' ELSE '<span style=\"display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;\">' || REPLACE(REPLACE(REPLACE(LicenceCountry, '&', '&amp;'), '<', '&lt;'), '>', '&gt;') || '</span>' END || '</div>' || '<div style=\"font-size:13px;color:#3C4652;margin-top:6px\">' || TO_CHAR(LOOKUP count CustomerLegalAccountID FROM CustomerLegalAccount END, 'FM999999990') || ' linked customer(s) · ' || TO_CHAR(LOOKUP count Sgid FROM SupplierLegalAccount END, 'FM999999990') || ' linked supplier(s)</div>' || '</div></div></div>'"
                dataType: STRING
                useCustomLabel: true
                label: "Header"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: MarkdownField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  contentHeight: '130'
                  contentHeightValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '0'
                  isVisibleValueInterpreter: LITERAL
      - _type: FormSection
        _name: PartyIdentitySection
        label: "Party identity"
        layoutDirection: ROW
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PartyIdentityC1
            layoutDirection: COLUMN
            content:
              - _name: PartyNameEn
                value: PartyNameEn
                dataType: STRING
                useCustomLabel: true
                label: "Party Name (EN)"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: '0'
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: '3'
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: '1'
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: '0'
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
              - _name: PartyNameAr
                value: PartyNameAr
                dataType: STRING
                useCustomLabel: true
                label: "Party Name (AR)"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: '0'
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: '3'
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: '1'
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: '0'
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
          - _type: FormContainer
            _name: PartyIdentityC2
            layoutDirection: COLUMN
            content:
              - _name: LicenceKey
                value: LicenceKey
                dataType: STRING
                useCustomLabel: true
                label: "Licence Number"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: '0'
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: '3'
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: '1'
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: '0'
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
              - _name: LicenceAuthorityCode
                value: LicenceAuthorityCode
                dataType: STRING
                useCustomLabel: true
                label: "Issuing Authority"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: '0'
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: '3'
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: '1'
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: '0'
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
              - _name: LicenceCountry
                value: LicenceCountry
                dataType: STRING
                useCustomLabel: true
                label: "Licence Country (ISO-2)"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: '0'
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: '3'
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: '1'
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: '0'
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
              - _name: ParentParty
                value: FDN_ParentPartyID
                dataType: STRING
                referencedEntity: DataProject.entities.Party.Party
                useCustomLabel: true
                label: "Parent party (super party)"
                helperText: "Optional: the party this party belongs to. A party with member parties is a super party and cannot have customers or suppliers."
                helperTextValueInterpreter: LITERAL
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: ReferenceField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  displayType: chip
                  displayTypeValueInterpreter: LITERAL
                  useAvatarInChip: '0'
                  useAvatarInChipValueInterpreter: LITERAL
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
