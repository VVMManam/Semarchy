sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
primaryKey: DataProject.entities.SupplierBankAccount.SupplierBankAccount.BankAccountID
entityType: FUZZY_MATCHED
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
matcher:
  _name: SemQLMatcher
  _type: SemQLMatcher
  autoConfirmSingletons: true
  autoConfirmGoldenThreshold: 99
  mergeThresholdMergingConfirmed: 95
  mergeThresholdMergingConfirmedWithNewMasters: 95
  mergeThresholdMergingConfirmedWithUnconfirmed: 98
  mergeThresholdMergingUnconfirmed: 95
  mergeThresholdMergingUnconfirmedWithNewMasters: 98
  mergeThresholdNewGroup: 95
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: false
  useTransitiveMatchScore: false
  matchRules:
    - _type: SemQLMatchRule
      _name: MAT05_IBANExact
      condition: |-
        Record1.IBAN IS NOT NULL
        AND Record2.IBAN IS NOT NULL
        AND UPPER(REPLACE(BTRIM(Record1.IBAN), ' ', '')) = UPPER(REPLACE(BTRIM(Record2.IBAN), ' ', ''))
        AND Record1.FID_Sgid IS NOT NULL
        AND Record2.FID_Sgid IS NOT NULL
        AND Record1.FID_Sgid = Record2.FID_Sgid
      label: "MAT-05 : Same supplier + IBAN - Exact Match"
      matchScore: 98
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT04_AccountNumberBankCountry
      condition: |-
        Record1.AccountNumber IS NOT NULL
        AND Record2.AccountNumber IS NOT NULL
        AND Record1.BicSwift IS NOT NULL
        AND Record2.BicSwift IS NOT NULL
        AND UPPER(BTRIM(Record1.AccountNumber)) = UPPER(BTRIM(Record2.AccountNumber))
        AND UPPER(SUBSTR(BTRIM(Record1.BicSwift), 5, 2)) = UPPER(SUBSTR(BTRIM(Record2.BicSwift), 5, 2))
        AND Record1.FID_Sgid IS NOT NULL
        AND Record2.FID_Sgid IS NOT NULL
        AND Record1.FID_Sgid = Record2.FID_Sgid
      label: "MAT-04 : Same supplier + Account Number + Bank Country - Exact Match"
      matchScore: 96
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT13_AccountNameSharedBank
      condition: |-
        Record1.AccountName IS NOT NULL
        AND Record2.AccountName IS NOT NULL
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.AccountName)), UPPER(BTRIM(Record2.AccountName))) >= 85
        AND (
          (Record1.IBAN IS NOT NULL AND Record2.IBAN IS NOT NULL
            AND UPPER(REPLACE(BTRIM(Record1.IBAN), ' ', '')) = UPPER(REPLACE(BTRIM(Record2.IBAN), ' ', '')))
          OR
          (Record1.AccountNumber IS NOT NULL AND Record2.AccountNumber IS NOT NULL
            AND UPPER(BTRIM(Record1.AccountNumber)) = UPPER(BTRIM(Record2.AccountNumber)))
        )
        AND Record1.FID_Sgid IS NOT NULL
        AND Record2.FID_Sgid IS NOT NULL
        AND Record1.FID_Sgid = Record2.FID_Sgid
      label: "MAT-13 : Same supplier + Account Name (JW >= 85) + Shared IBAN or Account"
      matchScore: 97
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: BNK01_SameSupplierAccountNumber
      condition: |-
        Record1.FID_Sgid IS NOT NULL
        AND Record2.FID_Sgid IS NOT NULL
        AND Record1.FID_Sgid = Record2.FID_Sgid
        AND Record1.AccountNumber IS NOT NULL
        AND Record2.AccountNumber IS NOT NULL
        AND UPPER(BTRIM(Record1.AccountNumber)) = UPPER(BTRIM(Record2.AccountNumber))
        AND (Record1.FID_Currency = Record2.FID_Currency
             OR (Record1.FID_Currency IS NULL AND Record2.FID_Currency IS NULL))
      label: "MAT-BNK-01 : Same supplier + Account Number + Currency (or both null) (auto-merge)"
      matchScore: 100
      usingMatchOn: false
