_type: StandardSurvivorshipRule
entity: DataProject.entities.SupplierBankAccount.SupplierBankAccount
_package: DataProject.entities.SupplierBankAccount.survivorship_rules
defaultRule: false
_name: BankAccountSurvivorshipRule
label: Bank Account Survivorship Rule
description: "SRV-12: bank accounts never blended; golden = active > valid IBAN/account > currency filled > latest start date > complete > oldest."
consolidationSkipNulls: false
consolidationStrategy: CUSTOM_RANKING
consolidationOrderByExpression: |-
  CASE WHEN UPPER(RecordStatusCode) IN ('A', 'ACTIVE', '1', 'Y') THEN 1 ELSE 0 END DESC,
  CASE WHEN (IBAN IS NOT NULL AND LENGTH(BTRIM(IBAN)) >= 15 AND IBAN <> '-1') OR (AccountNumber IS NOT NULL AND AccountNumber <> '-1') THEN 1 ELSE 0 END DESC,
  CASE WHEN CurrencySource IS NOT NULL THEN 1 ELSE 0 END DESC,
  CASE WHEN StartDate IS NULL THEN 0 ELSE 1 END DESC,
  StartDate DESC,
  (
    CASE WHEN BankName IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN CurrencySource IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN BankNumber IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN BranchName IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN BranchNumber IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN BicSwift IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN AccountName IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN AccountNumber IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN IBAN IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN AccountTypeCode IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN BankChargeBearerCode IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN IsPrimary IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN StartDate IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN EndDate IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN RecordStatusCode IS NOT NULL THEN 1 ELSE 0 END +
    CASE WHEN BankCountryCode IS NOT NULL THEN 1 ELSE 0 END
  ) DESC,
  CreationDate ASC
publisherRankings: []
overrideStrategy: UNTIL_NEXT_USER_CHANGE
attributes:
  - attributeName: BankName
  - attributeName: BankNumber
  - attributeName: BranchName
  - attributeName: BranchNumber
  - attributeName: BicSwift
  - attributeName: AccountName
  - attributeName: AccountNumber
  - attributeName: IBAN
  - attributeName: AccountTypeCode
  - attributeName: BankChargeBearerCode
  - attributeName: IsPrimary
  - attributeName: StartDate
  - attributeName: EndDate
  - attributeName: RecordStatusCode
  - attributeName: CurrencySource
  - attributeName: BankCountryCode
