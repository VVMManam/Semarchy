_name: BankAccountNameNumberMandatory
_type: SemQLValidation
_package: DataProject.entities.SupplierBankAccount.validations
entity: DataProject.entities.SupplierBankAccount.SupplierBankAccount
label: VAL-30 Account Name and Number Mandatory
validationScope: POST_CONSO
validationLabel: "VAL-30 - Account (beneficiary) name and account number are required."
condition: |-
  NULLIF(BTRIM(AccountName), '') IS NOT NULL AND NULLIF(BTRIM(AccountNumber), '') IS NOT NULL
