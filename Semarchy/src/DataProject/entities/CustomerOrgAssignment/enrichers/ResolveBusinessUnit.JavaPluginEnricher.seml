_name: ResolveBusinessUnit
_type: JavaPluginEnricher
_package: DataProject.entities.CustomerOrgAssignment.enrichers
entity: DataProject.entities.CustomerOrgAssignment.CustomerOrgAssignment
label: Resolve Business Unit (CRM code)
enricherExecutionScope: PRE_CONSO
numberOfRetry: 3
onErrorBehavior: SKIP_RECORDS
pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CUSTOM_SQL
    value: select 'CRM|' || upper(trim(crm_code)) LOOKUP_COLUMN,
                   business_unit_code OUTPUT_COLUMN1
            from gd_business_unit
            where crm_code is not null
            union all
            select 'MDM|' || upper(trim(business_unit_code)) LOOKUP_COLUMN,
                   business_unit_code OUTPUT_COLUMN1
            from gd_business_unit

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_FALLBACK

  - paramName: PARAM_CACHE
    value: LOAD_ON_START

pluginInputs:
  - expression: "CASE WHEN FID_BusinessUnitCode IS NOT NULL THEN 'MDM|' || UPPER(BTRIM(FID_BusinessUnitCode)) WHEN ERPBUCode IS NOT NULL THEN 'CRM|' || UPPER(BTRIM(ERPBUCode)) ELSE NULL END"
    inputName: IN_LOOKUP_VALUE

pluginOutputs:
  - attributeName: FID_BusinessUnitCode
    outputName: OUT_RESULT1

processingBatchSize: 100
threadPoolSize: 1
