                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: ERPProfile
                value: FDN_ErpProfileCode
                dataType: STRING
                referencedEntity: DataProject.entities.ErpProfile.ErpProfile
                useCustomLabel: true
                label: ERPProfile
                documentationInterpreter: LITERAL
