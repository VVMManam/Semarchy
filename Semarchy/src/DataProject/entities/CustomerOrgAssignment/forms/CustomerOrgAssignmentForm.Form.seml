_package: DataProject.entities.CustomerOrgAssignment.forms
_type: Form
_name: CustomerOrgAssignmentForm
entity: DataProject.entities.CustomerOrgAssignment.CustomerOrgAssignment
default: true
formTabs:
  - _name: Main
    _type: FormTab
    labelWidth: "140px"
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    label: Department Details
    iconUrl: images://AdPorts-ImageLibrary/tab-customer-details.svg
    displayFormTabAs: ICON_LABEL
    content:
