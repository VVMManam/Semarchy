sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
primaryKey: DataProject.entities.CustomerOrgAssignment.CustomerOrgAssignment.CustomerOrgAssignmentID
entityType: FUZZY_MATCHED
matcher:
  _name: SemQLMatcherCustomerOrgAssignment
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 98
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 95
  mergeThresholdMergingConfirmedWithNewMasters: 95
  mergeThresholdMergingConfirmedWithUnconfirmed: 98
  mergeThresholdMergingUnconfirmed: 95
  mergeThresholdMergingUnconfirmedWithNewMasters: 98
  mergeThresholdNewGroup: 95
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: false
  useTransitiveMatchScore: false
  matchRules:
    - _type: SemQLMatchRule
      _name: D02_BuAndDeptCodeUnderSameCustomer
      label: "D-02 BU + DeptCode equal, same customer (Cgid) (auto merge)"
      condition: |-
        Record1.FID_BusinessUnitCode IS NOT NULL
        AND Record2.FID_BusinessUnitCode IS NOT NULL
        AND Record1.FID_BusinessUnitCode = Record2.FID_BusinessUnitCode
        AND Record1.FID_ClusterCode IS NOT NULL
        AND Record2.FID_ClusterCode IS NOT NULL
        AND Record1.FID_ClusterCode = Record2.FID_ClusterCode
        AND Record1.FID_CustomerLegalAccount IS NOT NULL
        AND Record2.FID_CustomerLegalAccount IS NOT NULL
        AND Record1.FID_CustomerLegalAccount = Record2.FID_CustomerLegalAccount
      matchScore: 100
      usingMatchOn: false
