_package: DataProject.entities.TaxRegistration.collection_views
_name: TaxRegistration
_type: CollectionView
entity: DataProject.entities.TaxRegistration.TaxRegistration
displayCard: DataProject.entities.TaxRegistration.display_cards.TaxRegistration
default: true
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: true
tableDisplayCardColumnLabel: Tax Registration
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: ReferenceColumn
    _name: TaxTypeCode
    columnAlign: LEFT
    dataType: STRING
    referencedEntity: DataProject.entities.TaxType.TaxType
    useCustomLabel: true
    value: FDN_TaxTypeCode
    label: Tax Type
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "0"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: Country
    columnAlign: LEFT
    dataType: STRING
    referencedEntity: DataProject.entities.Country.CountryReference
    useCustomLabel: true
    value: "FDN_CountryCode"
    label: "Country"
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: VatStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: CASE WHEN VatStatusCode = '1' THEN 'Registered' WHEN VatStatusCode = '2' THEN 'Not Applicable' WHEN VatStatusCode = '3' THEN 'IN_PROGRESS' ELSE VatStatusCode END
    label: Vat Status
    visibleByDefault: true
  - _type: TextColumn
    _name: RegistrationNo
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: RegistrationNo
    visibleByDefault: true
  - _type: TextColumn
    _name: EffectiveDate
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: EffectiveDate
    visibleByDefault: true
  - _type: DateColumn
    _name: EndDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: true
    value: EndDate
    label: "End Date"
    visibleByDefault: true
  - _type: TextColumn
    _name: IsCurrent
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: IsCurrent
    visibleByDefault: true
  - _type: TextColumn
    _name: RecordStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: CASE WHEN RecordStatusCode = '1' THEN 'Inactive' WHEN RecordStatusCode = '0' THEN 'Active' ELSE RecordStatusCode END
    label: Record Status
    visibleByDefault: true
