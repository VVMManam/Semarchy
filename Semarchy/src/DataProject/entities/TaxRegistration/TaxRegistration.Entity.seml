sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
primaryKey: DataProject.entities.TaxRegistration.TaxRegistration.TaxRegistrationId
entityType: FUZZY_MATCHED
matcher:
  _name: SemQLMatcherTaxRegistration
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 98
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 95
  mergeThresholdMergingConfirmedWithNewMasters: 95
  mergeThresholdMergingConfirmedWithUnconfirmed: 98
  mergeThresholdMergingUnconfirmed: 95
  mergeThresholdMergingUnconfirmedWithNewMasters: 98
  mergeThresholdNewGroup: 95
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: false
  useTransitiveMatchScore: false
  matchRules:
    - _type: SemQLMatchRule
      _name: SameTaxIdUnderSameCustomer
      condition: |-
        Record1.FID_Cgid IS NOT NULL
        AND Record2.FID_Cgid IS NOT NULL
        AND Record1.FID_Cgid = Record2.FID_Cgid
        AND Record1.FID_TaxTypeCode IS NOT NULL
        AND Record2.FID_TaxTypeCode IS NOT NULL
        AND Record1.FID_TaxTypeCode = Record2.FID_TaxTypeCode
        AND Record1.RegistrationNo IS NOT NULL
        AND Record2.RegistrationNo IS NOT NULL
        AND Record1.RegistrationNo =Record2.RegistrationNo
      label: "Same tax registration number (TRN) under the same customer - catches duplicates left behind after a customer-level merge (auto-merge)"
      matchScore: 100
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: SameTaxIdUnderSameSupplier
      condition: |-
        Record1.FID_Sgid IS NOT NULL
        AND Record2.FID_Sgid IS NOT NULL
        AND Record1.FID_Sgid = Record2.FID_Sgid
        AND Record1.FID_TaxTypeCode IS NOT NULL
        AND Record2.FID_TaxTypeCode IS NOT NULL
        AND Record1.FID_TaxTypeCode = Record2.FID_TaxTypeCode
        AND Record1.RegistrationNoNormalised IS NOT NULL
        AND Record2.RegistrationNoNormalised IS NOT NULL
        AND Record1.RegistrationNoNormalised = Record2.RegistrationNoNormalised
      label: "Same tax registration number (normalised) under the same supplier - catches duplicates left behind after a supplier-level merge (auto-merge)"
      matchScore: 100
      usingMatchOn: false
