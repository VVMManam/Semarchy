sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
primaryKey: DataProject.entities.SupplierSite.SupplierSite.SiteId
entityType: FUZZY_MATCHED
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
matcher:
  _name: SemQLMatcherSupplierSite
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 100
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 100
  mergeThresholdMergingConfirmedWithNewMasters: 100
  mergeThresholdMergingConfirmedWithUnconfirmed: 100
  mergeThresholdMergingUnconfirmed: 100
  mergeThresholdMergingUnconfirmedWithNewMasters: 100
  mergeThresholdNewGroup: 100
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: false
  useTransitiveMatchScore: false
  matchRules:
    - _type: SemQLMatchRule
      _name: S01_SameSupplierSameSiteCode
      label: "MAT-SIT-01 Same supplier + procurement BU + normalised site code"
      condition: |-
        Record1.FID_Sgid IS NOT NULL
        AND Record2.FID_Sgid IS NOT NULL
        AND Record1.FID_Sgid = Record2.FID_Sgid
        AND Record1.FID_ProcurementBuCode IS NOT NULL
        AND Record2.FID_ProcurementBuCode IS NOT NULL
        AND Record1.FID_ProcurementBuCode = Record2.FID_ProcurementBuCode
        AND Record1.SiteCode IS NOT NULL
        AND Record2.SiteCode IS NOT NULL
        AND REGEXP_REPLACE(UPPER(Record1.SiteCode), '[^A-Z0-9]', '', 'g') = REGEXP_REPLACE(UPPER(Record2.SiteCode), '[^A-Z0-9]', '', 'g')
      matchScore: 100
      usingMatchOn: false
