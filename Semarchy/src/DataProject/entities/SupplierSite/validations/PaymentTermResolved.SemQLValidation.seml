_name: PaymentTermResolved
_type: SemQLValidation
_package: DataProject.entities.SupplierSite.validations
entity: DataProject.entities.SupplierSite.SupplierSite
label: Payment Term Resolved
validationScope: POST_CONSO
validationLabel: "PAYMENT_TERM_UNMAPPED - source payment term value has no matching reference in MDM."
condition: |-
  PaymentTermName IS NULL
  OR FID_PaymentTermCode IS NOT NULL
