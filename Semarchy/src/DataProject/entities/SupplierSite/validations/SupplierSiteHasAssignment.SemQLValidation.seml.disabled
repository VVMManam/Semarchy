_name: SupplierSiteHasAssignment
_type: SemQLValidation
_package: DataProject.entities.SupplierSite.validations
entity: DataProject.entities.SupplierSite.SupplierSite
label: VAL-54 Site Has Assignment (warning)
validationScope: POST_CONSO
validationLabel: "VAL-54 WARNING - Site is not assigned to any client BU."
condition: |-
  COALESCE(RecordStatusCode, 'A') <> 'A' OR ANY SupplierSiteAssignment HAVE (FID_ClientBuCode IS NOT NULL)
