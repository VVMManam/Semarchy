_package: DataProject.entities.Profile.collection_views
_name: ProfileView
_type: CollectionView
entity: DataProject.entities.Profile.Profile
displayCard: DataProject.entities.Profile.display_cards.Profile
default: true
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: true
tableDisplayCardColumnLabel: Profile
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: ReferenceColumn
    _name: ProfileType
    columnAlign: LEFT
    dataType: STRING
    referencedEntity: DataProject.entities.ProfileType.ProfileType
    useCustomLabel: true
    value: "FDN_ProfileTypeCode"
    label: "Profile Type"
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "0"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: MarkdownColumn
    _name: ClusterCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN Cluster IS NULL THEN NULL ELSE '<div style=\"margin:0;padding:0;line-height:1\">' || CASE WHEN Cluster LIKE '%Corp%' THEN '<span style=\"display:inline-block;background:#009FE3;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Corp</span>' ELSE '' END || CASE WHEN Cluster LIKE '%Digital%' THEN '<span style=\"display:inline-block;background:#A286BF;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Digital Cluster</span>' ELSE '' END || CASE WHEN Cluster LIKE '%Industrial%' THEN '<span style=\"display:inline-block;background:#F9423A;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Industrial Zone</span>' ELSE '' END || CASE WHEN Cluster LIKE '%Logistics%' THEN '<span style=\"display:inline-block;background:#70D547;color:#12330A;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Logistics</span>' ELSE '' END || CASE WHEN Cluster LIKE '%Maritime%' THEN '<span style=\"display:inline-block;background:#14C5BD;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Maritime</span>' ELSE '' END || CASE WHEN Cluster LIKE '%Ports%' THEN '<span style=\"display:inline-block;background:#B0D6E3;color:#0D3B4C;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Ports</span>' ELSE '' END || CASE WHEN Cluster NOT LIKE '%Corp%' AND Cluster NOT LIKE '%Digital%' AND Cluster NOT LIKE '%Industrial%' AND Cluster NOT LIKE '%Logistics%' AND Cluster NOT LIKE '%Maritime%' AND Cluster NOT LIKE '%Ports%' THEN '<span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' || Cluster || '</span>' ELSE '' END || '</div>' END"
    label: "Cluster"
    visibleByDefault: true
  - _type: TextColumn
    _name: ERPBUCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "ERPBUCode"
    label: "ERP BU Code"
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: BusinessUnit
    columnAlign: LEFT
    dataType: STRING
    referencedEntity: DataProject.entities.BusinessUnit.BusinessUnit
    useCustomLabel: true
    value: FDN_BusinessUnitCode
    label: Business Unit
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "0"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: RecordStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: CASE WHEN RecordStatusCode = 'A' THEN 'Active' WHEN RecordStatusCode = 'I' THEN 'Inactive' ELSE RecordStatusCode END
    label: Record Status
    visibleByDefault: true
  - _type: TextColumn
    _name: ApprovalStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: CASE WHEN ApprovalStatusCode = '1' THEN 'Approved' WHEN ApprovalStatusCode = '2' THEN 'In-Progress' WHEN ApprovalStatusCode = '3' THEN 'Rejected' ELSE ApprovalStatusCode END
    label: Approval Status
    visibleByDefault: true
