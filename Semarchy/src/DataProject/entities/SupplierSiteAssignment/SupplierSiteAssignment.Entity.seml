goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
primaryKey: DataProject.entities.SupplierSiteAssignment.SupplierSiteAssignment.AssignmentId
entityType: FUZZY_MATCHED
matcher:
  _name: SemQLMatcherSupplierSiteAssignment
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 95
  mergeThresholdMergingConfirmedWithNewMasters: 95
  mergeThresholdMergingConfirmedWithUnconfirmed: 98
  mergeThresholdMergingUnconfirmed: 95
  mergeThresholdMergingUnconfirmedWithNewMasters: 98
  mergeThresholdNewGroup: 95
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: true
  useTransitiveMatchScore: true
  matchRules:
    - _type: SemQLMatchRule
      _name: SameSiteSameClientBu
      label: "VAL-55 Same site + same client BU"
      condition: |-
        Record1.FID_SupplierSite IS NOT NULL AND Record2.FID_SupplierSite IS NOT NULL
        AND Record1.FID_SupplierSite = Record2.FID_SupplierSite
        AND Record1.FID_ClientBuCode IS NOT NULL AND Record2.FID_ClientBuCode IS NOT NULL
        AND Record1.FID_ClientBuCode = Record2.FID_ClientBuCode
      matchScore: 100
      usingMatchOn: false