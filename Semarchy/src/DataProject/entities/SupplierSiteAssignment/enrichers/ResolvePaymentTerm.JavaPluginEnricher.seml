_name: ResolvePaymentTerm
_type: JavaPluginEnricher
_package: DataProject.entities.SupplierSiteAssignment.enrichers
entity: DataProject.entities.SupplierSiteAssignment.SupplierSiteAssignment
label: Resolve Payment Term
enricherExecutionScope: PRE_CONSO
numberOfRetry: 3
onErrorBehavior: SKIP_RECORDS
pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CUSTOM_SQL
    value: select 'SRC|' || upper(trim(payment_term_code)) LOOKUP_COLUMN,
                   payment_term_code OUTPUT_COLUMN1
            from gd_payment_term
            where payment_term_code is not null
            union
            select 'SRC|' || upper(trim(fusion_code)) LOOKUP_COLUMN,
                   payment_term_code OUTPUT_COLUMN1
            from gd_payment_term
            where fusion_code is not null
            union
            select 'SRC|' || upper(trim(crm_code)) LOOKUP_COLUMN,
                   payment_term_code OUTPUT_COLUMN1
            from gd_payment_term
            where crm_code is not null
            union
            select 'SRC|' || upper(trim(name_en)) LOOKUP_COLUMN,
                   payment_term_code OUTPUT_COLUMN1
            from gd_payment_term
            where name_en is not null
            union
            select 'MDM|' || upper(trim(payment_term_code)) LOOKUP_COLUMN,
                   payment_term_code OUTPUT_COLUMN1
            from gd_payment_term

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_FALLBACK

  - paramName: PARAM_CACHE
    value: LOAD_ON_START

pluginInputs:
  - expression: "CASE WHEN FID_PaymentTermCode IS NOT NULL THEN 'MDM|' || UPPER(BTRIM(FID_PaymentTermCode)) WHEN PaymentTermName IS NOT NULL THEN 'SRC|' || UPPER(BTRIM(PaymentTermName)) ELSE NULL END"
    inputName: IN_LOOKUP_VALUE

pluginOutputs:
  - attributeName: FID_PaymentTermCode
    outputName: OUT_RESULT1

processingBatchSize: 100
threadPoolSize: 1
