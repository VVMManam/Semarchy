_name: ResolveShipToLocation
_type: JavaPluginEnricher
_package: DataProject.entities.SupplierSiteAssignment.enrichers
entity: DataProject.entities.SupplierSiteAssignment.SupplierSiteAssignment
label: Resolve Ship-to Location
enricherExecutionScope: PRE_CONSO
numberOfRetry: 3
onErrorBehavior: SKIP_RECORDS
pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CUSTOM_SQL
    value: select 'SRC|' || upper(trim(location_code)) LOOKUP_COLUMN,
                   location_code OUTPUT_COLUMN1
            from gd_location
            where location_code is not null
            union
            select 'SRC|' || upper(trim(name_en)) LOOKUP_COLUMN,
                   location_code OUTPUT_COLUMN1
            from gd_location
            where name_en is not null
            union
            select 'MDM|' || upper(trim(location_code)) LOOKUP_COLUMN,
                   location_code OUTPUT_COLUMN1
            from gd_location

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_FALLBACK

  - paramName: PARAM_CACHE
    value: LOAD_ON_START

pluginInputs:
  - expression: "CASE WHEN FID_ShipToLocationCode IS NOT NULL THEN 'MDM|' || UPPER(BTRIM(FID_ShipToLocationCode)) WHEN ShipToLocationName IS NOT NULL THEN 'SRC|' || UPPER(BTRIM(ShipToLocationName)) ELSE NULL END"
    inputName: IN_LOOKUP_VALUE

pluginOutputs:
  - attributeName: FID_ShipToLocationCode
    outputName: OUT_RESULT1

processingBatchSize: 100
threadPoolSize: 1
