sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
primaryKey: DataProject.entities.Contact.Contact.ContactId
entityType: FUZZY_MATCHED
matcher:
  _name: SemQLMatcherContact
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 98
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 95
  mergeThresholdMergingConfirmedWithNewMasters: 95
  mergeThresholdMergingConfirmedWithUnconfirmed: 98
  mergeThresholdMergingUnconfirmed: 95
  mergeThresholdMergingUnconfirmedWithNewMasters: 98
  mergeThresholdNewGroup: 95
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: false
  useTransitiveMatchScore: false
  matchRules:
    - _type: SemQLMatchRule
      _name: SameEmailUnderSameCustomer
      condition: |-
        Record1.FID_Cgid IS NOT NULL
        AND Record2.FID_Cgid IS NOT NULL
        AND Record1.FID_Cgid = Record2.FID_Cgid
        AND Record1.Email IS NOT NULL
        AND Record2.Email IS NOT NULL
        AND LOWER(BTRIM(Record1.Email)) = LOWER(BTRIM(Record2.Email))
      label: "Same customer + same e-mail address (auto-merge)"
      matchScore: 98
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: SameEmiratesIdUnderSameCustomer
      condition: |-
        Record1.FID_Cgid IS NOT NULL
        AND Record2.FID_Cgid IS NOT NULL
        AND Record1.FID_Cgid = Record2.FID_Cgid
        AND Record1.EmiratesId IS NOT NULL
        AND Record2.EmiratesId IS NOT NULL
        AND UPPER(REGEXP_REPLACE(Record1.EmiratesId, '[^A-Za-z0-9]', '', 'g')) = UPPER(REGEXP_REPLACE(Record2.EmiratesId, '[^A-Za-z0-9]', '', 'g'))
      label: "Same customer + same Emirates ID (auto-merge)"
      matchScore: 98
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: SamePassportUnderSameCustomer
      condition: |-
        Record1.FID_Cgid IS NOT NULL
        AND Record2.FID_Cgid IS NOT NULL
        AND Record1.FID_Cgid = Record2.FID_Cgid
        AND Record1.PassportNumber IS NOT NULL
        AND Record2.PassportNumber IS NOT NULL
        AND UPPER(REGEXP_REPLACE(Record1.PassportNumber, '[^A-Za-z0-9]', '', 'g')) = UPPER(REGEXP_REPLACE(Record2.PassportNumber, '[^A-Za-z0-9]', '', 'g'))
        AND (Record1.FID_NationalityCode IS NULL OR Record2.FID_NationalityCode IS NULL OR Record1.FID_NationalityCode = Record2.FID_NationalityCode)
      label: "Same customer + same passport number + same nationality (auto-merge)"
      matchScore: 95
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: SameContactUniqueIdUnderSameCustomerAndAssignment
      condition: |-
        Record1.FID_CustomerOrgAssignment IS NOT NULL
        AND Record2.FID_CustomerOrgAssignment IS NOT NULL
        AND Record1.FID_CustomerOrgAssignment = Record2.FID_CustomerOrgAssignment
        AND Record1.ContactUniqueId IS NOT NULL
        AND Record2.ContactUniqueId IS NOT NULL
        AND Record1.ContactUniqueId = Record2.ContactUniqueId
      label: "Same customer + same departmental assignment + same source contact identifier - fallback for records without an Emirates ID (auto-merge)"
      matchScore: 100
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: SameEmailUnderSameSupplierSite
      condition: |-
        Record1.FID_SupplierSite IS NOT NULL
        AND Record2.FID_SupplierSite IS NOT NULL
        AND Record1.FID_SupplierSite = Record2.FID_SupplierSite
        AND Record1.Email IS NOT NULL AND Record2.Email IS NOT NULL
        AND LOWER(BTRIM(Record1.Email)) = LOWER(BTRIM(Record2.Email))
        AND NOT (Record1.HasUserAccount IS NOT NULL AND Record1.HasUserAccount = '1' AND Record2.HasUserAccount IS NOT NULL AND Record2.HasUserAccount = '1')
      label: "MAT-CON-01 Same supplier site + same e-mail (auto-merge)"
      matchScore: 100
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MATCON01B_SameEmailBothUserAccounts
      condition: |-
        Record1.FID_SupplierSite IS NOT NULL
        AND Record2.FID_SupplierSite IS NOT NULL
        AND Record1.FID_SupplierSite = Record2.FID_SupplierSite
        AND Record1.Email IS NOT NULL AND Record2.Email IS NOT NULL
        AND LOWER(BTRIM(Record1.Email)) = LOWER(BTRIM(Record2.Email))
        AND Record1.HasUserAccount = '1' AND Record2.HasUserAccount = '1'
      label: "MAT-CON-01 Same supplier site + same e-mail, both with a supplier user account (steward)"
      matchScore: 90
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MATCON02_NamePhone
      condition: |-
        Record1.FID_SupplierSite IS NOT NULL
        AND Record2.FID_SupplierSite IS NOT NULL
        AND Record1.FID_SupplierSite = Record2.FID_SupplierSite
        AND Record1.LastName IS NOT NULL AND Record2.LastName IS NOT NULL
        AND SEM_EDIT_DISTANCE_SIMILARITY(BTRIM(UPPER(COALESCE(Record1.FirstName, '') || ' ' || COALESCE(Record1.LastName, ''))), BTRIM(UPPER(COALESCE(Record2.FirstName, '') || ' ' || COALESCE(Record2.LastName, '')))) >= 90
        AND (
        (LENGTH(REGEXP_REPLACE(COALESCE(Record1.Mobile, ''), '[^0-9]', '', 'g')) >= 8 AND LENGTH(REGEXP_REPLACE(COALESCE(Record2.Mobile, ''), '[^0-9]', '', 'g')) >= 8
        AND SUBSTR(REGEXP_REPLACE(Record1.Mobile, '[^0-9]', '', 'g'), LENGTH(REGEXP_REPLACE(Record1.Mobile, '[^0-9]', '', 'g')) - 7) = SUBSTR(REGEXP_REPLACE(Record2.Mobile, '[^0-9]', '', 'g'), LENGTH(REGEXP_REPLACE(Record2.Mobile, '[^0-9]', '', 'g')) - 7))
        OR
        (LENGTH(REGEXP_REPLACE(COALESCE(Record1.BusinessPhone, ''), '[^0-9]', '', 'g')) >= 8 AND LENGTH(REGEXP_REPLACE(COALESCE(Record2.BusinessPhone, ''), '[^0-9]', '', 'g')) >= 8
        AND SUBSTR(REGEXP_REPLACE(Record1.BusinessPhone, '[^0-9]', '', 'g'), LENGTH(REGEXP_REPLACE(Record1.BusinessPhone, '[^0-9]', '', 'g')) - 7) = SUBSTR(REGEXP_REPLACE(Record2.BusinessPhone, '[^0-9]', '', 'g'), LENGTH(REGEXP_REPLACE(Record2.BusinessPhone, '[^0-9]', '', 'g')) - 7))
        )
      label: "MAT-CON-02 Same supplier site + name (>= 90) + last 8 phone digits (steward)"
      matchScore: 85
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MATCON03_NameCorporateDomain
      condition: |-
        Record1.FID_SupplierSite IS NOT NULL
        AND Record2.FID_SupplierSite IS NOT NULL
        AND Record1.FID_SupplierSite = Record2.FID_SupplierSite
        AND Record1.LastName IS NOT NULL AND Record2.LastName IS NOT NULL
        AND SEM_EDIT_DISTANCE_SIMILARITY(BTRIM(UPPER(COALESCE(Record1.FirstName, '') || ' ' || COALESCE(Record1.LastName, ''))), BTRIM(UPPER(COALESCE(Record2.FirstName, '') || ' ' || COALESCE(Record2.LastName, '')))) >= 92
        AND Record1.EmailDomain IS NOT NULL AND Record1.EmailDomain = Record2.EmailDomain
        AND (Record1.IsGenericEmailDomain IS NULL OR Record1.IsGenericEmailDomain = '0') AND (Record2.IsGenericEmailDomain IS NULL OR Record2.IsGenericEmailDomain = '0')
      label: "MAT-CON-03 Same supplier site + name (>= 92) + corporate e-mail domain (steward)"
      matchScore: 85
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: SameVendorContactIdUnderSameSupplierSite
      condition: |-
        Record1.FID_SupplierSite IS NOT NULL
        AND Record2.FID_SupplierSite IS NOT NULL
        AND Record1.FID_SupplierSite = Record2.FID_SupplierSite
        AND Record1.VendorContactId IS NOT NULL
        AND Record2.VendorContactId IS NOT NULL
        AND Record1.VendorContactId = Record2.VendorContactId
      label: "Same supplier site + same Fusion vendor contact id (auto-merge)"
      matchScore: 100
      usingMatchOn: false
