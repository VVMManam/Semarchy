_type: SemQLEnricher
_package: DataProject.entities.Contact.enrichers
_name: NormalizeEmiratesIdEmailDomain
entity: DataProject.entities.Contact.Contact
label: Normalize Emirates ID and Email Domain
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
  - attributeName: EmiratesId
    expression: |-
      CASE WHEN UPPER(BTRIM(EmiratesId)) LIKE 'CON%' THEN NULL ELSE REGEXP_REPLACE(EmiratesId, '[^0-9]', '', 'g') END
  - attributeName: EmailDomain
    expression: |-
      CASE WHEN Email IS NULL THEN EmailDomain ELSE LOWER(REGEXP_REPLACE(Email, '^[^@]*@', '')) END
  - attributeName: IsGenericEmailDomain
    expression: |-
      CASE
        WHEN Email IS NULL THEN NULL
        WHEN REGEXP_LIKE(LOWER(REGEXP_REPLACE(Email, '^[^@]*@', '')), '(gmail|hotmail|yahoo|outlook|icloud|emirates\.net\.ae|eim\.ae)') THEN 1
        ELSE 0
      END
  - attributeName: MobileDialCode
    expression: |-
      CASE WHEN REGEXP_LIKE(MobilePhoneCountryCode, '^\s*\+?[0-9]{1,4}\s*$') THEN '+' || REGEXP_REPLACE(MobilePhoneCountryCode, '[^0-9]', '', 'g') ELSE MobileDialCode END
  - attributeName: BusinessPhoneDialCode
    expression: |-
      CASE WHEN REGEXP_LIKE(TelephoneNumberCountryCode, '^\s*\+?[0-9]{1,4}\s*$') THEN '+' || REGEXP_REPLACE(TelephoneNumberCountryCode, '[^0-9]', '', 'g') ELSE BusinessPhoneDialCode END
