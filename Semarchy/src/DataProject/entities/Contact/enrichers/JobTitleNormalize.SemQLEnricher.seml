_name: JobTitleNormalize
_package: DataProject.entities.Contact.enrichers
entity: DataProject.entities.Contact.Contact
label: Job Title Normalize
_type: SemQLEnricher
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
  - attributeName: JobTitle
    expression: |-
      CASE
        WHEN JobTitle IS NULL THEN JobTitle
        ELSE INITCAP(LTRIM(REGEXP_REPLACE(JobTitle, ' +', ' ')))
      END
