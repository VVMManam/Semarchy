_name: EmiratesIdFormatCheck
_type: SemQLValidation
_package: DataProject.entities.Contact.validations
entity: DataProject.entities.Contact.Contact
label: Emirates ID Format Check
validationScope: POST_CONSO
validationLabel: "Emirates ID must be 15 digits starting with 784."
condition: |-
  (FID_Cgid IS NULL AND FID_CustomerOrgAssignment IS NULL) OR EmiratesId IS NULL OR REGEXP_LIKE(EmiratesId, '^784[0-9]{12}$')
