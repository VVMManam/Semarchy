_package: DataProject.entities.OutstandingRefreshRequest.forms
_type: Form
_name: OutstandingRefresh
entity: DataProject.entities.OutstandingRefreshRequest.OutstandingRefreshRequest
default: true
formTabs:
  - _name: Main
    _type: FormTab
    labelWidth: "140px"
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    label: Refresh Outstanding
    displayFormTabAs: LABEL
    content:
      - _type: FormSection
        _name: RefreshSection
        label: "Click Finish to refresh the ERP outstanding of every customer in Review Duplicates (about 1 minute)."
        layoutDirection: ROW
        documentationInterpreter: LITERAL
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: Container
            layoutDirection: COLUMN
            content:
              - _name: RequestedBy
                value: RequestedBy
                dataType: STRING
                useCustomLabel: true
                label: Requested By
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "3"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: RequestedAtText
                value: TO_CHAR(RequestedAt, 'DD-Mon-YYYY HH24:MI')
                dataType: STRING
                useCustomLabel: true
                label: Requested At
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "3"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: RequestStatus
                value: RequestStatus
                dataType: STRING
                useCustomLabel: true
                label: Status
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
