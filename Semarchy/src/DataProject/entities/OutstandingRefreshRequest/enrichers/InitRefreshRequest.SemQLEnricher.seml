_type: SemQLEnricher
_package: DataProject.entities.OutstandingRefreshRequest.enrichers
_name: InitRefreshRequest
entity: DataProject.entities.OutstandingRefreshRequest.OutstandingRefreshRequest
label: Init Refresh Request
description: 'Runs when the steward opens the Refresh Outstanding screen (and again in the job): fills who/when and status NEW. The request ID is generated by Semarchy (sequence).'
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
  - attributeName: RequestedBy
    expression: COALESCE(RequestedBy, :V_USERNAME)
  - attributeName: RequestedAt
    expression: "COALESCE(RequestedAt, DATE_TRUNC('second', NOW()))"
  - attributeName: RequestStatus
    expression: "COALESCE(RequestStatus, 'NEW')"
