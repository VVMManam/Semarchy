_name: ResolveActivityType
_type: JavaPluginEnricher
_package: DataProject.entities.LicenseActivity.enrichers
entity: DataProject.entities.LicenseActivity.LicenseActivity
label: Resolve Activity Type
enricherExecutionScope: PRE_CONSO
numberOfRetry: 3
onErrorBehavior: SKIP_RECORDS
pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CUSTOM_SQL
    value: "select upper(trim(v)) LOOKUP_COLUMN, min(c) OUTPUT_COLUMN1 from (select activity_scheme_code c, unnest(array[activity_scheme_code, activity_code, crm_code, ded_code]) v from gd_license_activity_type) a where v is not null group by 1"

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_FALLBACK

  - paramName: PARAM_CACHE
    value: LOAD_ON_START

pluginInputs:
  - expression: "UPPER(BTRIM(COALESCE(FID_ActivityType, ActivityCode)))"
    inputName: IN_LOOKUP_VALUE

pluginOutputs:
  - attributeName: FID_ActivityType
    outputName: OUT_RESULT1

processingBatchSize: 100
threadPoolSize: 1
