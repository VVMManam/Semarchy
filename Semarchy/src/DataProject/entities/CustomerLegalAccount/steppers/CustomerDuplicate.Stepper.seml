_name: CustomerDuplicate
_package: DataProject.entities.CustomerLegalAccount.steppers
_type: Stepper
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
label: Author Customer Legal Accounts
triggers: []
rootStep:
  _name: Customers
  _type: CollectionStep
  label: Customer Legal Accounts
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: DataProject.entities.CustomerLegalAccount.Collections.CustomerGoldenView
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: false
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTriggers: []
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.NameEN
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.CustomerGoldenId
    - onStepExit: SKIP
      validationType: DETECT_DUPS
      matcher: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.SemlQLMatcherCustomer
    - onStepExit: SKIP
      validationType: LOV
      attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.AccountStatus
    - onStepExit: SKIP
      validationType: LOV
      attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.AccountType
    - onStepExit: SKIP
      validationType: LOV
      attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.CustomerState
  childSteps:
    - _name: Main
      _type: FormStep
      label: Customer Details
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      formTab: DataProject.entities.CustomerLegalAccount.Forms.CustomerGoldenView.Main
      referenceFormFieldConfigs: []
      stepTriggers: []
      formStepEnrichers:
        - enricher: DataProject.entities.CustomerLegalAccount.enrichers.StanderdizeEmailNameAddress
          executedOnDataChange: true
          executedOnFormOpen: true
      formStepValidations:
        - validationType: MANDATORY
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.NameEN
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: MANDATORY
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.CustomerGoldenId
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: LOV
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.AccountStatus
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: LOV
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.AccountType
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: LOV
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.CustomerState
          executedOnDataChange: true
          executedOnFormOpen: true
      stepTransitionValidations:
        - onStepExit: WARN
          validationType: MANDATORY
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.NameEN
        - onStepExit: WARN
          validationType: MANDATORY
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.CustomerGoldenId
        - onStepExit: WARN
          validationType: LOV
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.AccountStatus
        - onStepExit: WARN
          validationType: LOV
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.AccountType
        - onStepExit: WARN
          validationType: LOV
          attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.CustomerState
        - onStepExit: WARN
          validationType: DETECT_DUPS
          matcher: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.SemlQLMatcherCustomer
    - _name: MergeApprovalLogs
      _type: CollectionStep
      label: Merge Approval Decision
      oneToManyReference: DataProject.references.MergeApprovalLogs_CustomerLegalAccount
      collectionView: DataProject.entities.MergeApprovalLogs.collection_views.MergeApprovalLogs
      canFinishSubLevel: true
      childDeleteType: HARD_DELETE
      childImportModeOnParentEdit: CREATE_AND_UPDATE
      enableChildCopyOnParentCreate: false
      enableChildCopyOnParentEdit: false
      enableChildCreationOnParentCreate: false
      enableChildCreationOnParentEdit: true
      enableChildDeleteOnParentEdit: false
      enableChildEditOnParentCreate: false
      enableChildEditOnParentEdit: true
      enableChildImportOnParentCreate: false
      enableChildImportOnParentEdit: false
      enableChildRemoveOnParentCreate: false
      enableChildRemoveOnParentEdit: false
      skipToChildCreationOnParentCreate: false
      skipToChildEditingOnParentEdit: false
      customSortEnabled: false
      defaultDisplayType: TABLE
      displayGridAllowed: false
      displayListAllowed: false
      displayTableAllowed: true
      enabledOnParentCreate: false
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      linear: false
      useCustomCollectionLabel: false
      userDefinedSortEnabled: true
      stepTransitionValidations: []
      stepTriggers: []
      childSteps:
        - _name: MergeApprovalLogDetails
          _type: FormStep
          label: Log Review Decision
          formTab: DataProject.entities.MergeApprovalLogs.forms.MergeApprovalLogs.Main
          canFinishSubLevel: true
          enabledOnParentCreate: true
          enabledOnParentEdit: true
          enableMasterValuePicking: false
          formFieldsMode: AUTO
          formStepEnrichers: []
          referenceFormFieldConfigs: []
          formStepValidations: []
          stepTransitionValidations: []
          stepTriggers: []
stepperFinishValidations:
  - onStepperFinish: WARN
    validationType: MANDATORY
    attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.NameEN
  - onStepperFinish: WARN
    validationType: MANDATORY
    attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.CustomerGoldenId
  - onStepperFinish: SKIP
    validationType: LOV
    attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.AccountStatus
  - onStepperFinish: SKIP
    validationType: LOV
    attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.AccountType
  - onStepperFinish: SKIP
    validationType: LOV
    attribute: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount.CustomerState
  - onStepperFinish: WARN
    validationType: DETECT_DUPS