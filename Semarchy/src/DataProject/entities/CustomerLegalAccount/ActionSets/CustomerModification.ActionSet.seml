_name: CustomerModification
_package: DataProject.entities.CustomerLegalAccount.ActionSets
_type: ActionSet
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
label: Customer Legal Account Action Set
defaultActionSet: false
actions:
  - _name: EditCustomerLegalAccount
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: DataProject.entities.CustomerLegalAccount.steppers.CustomerGolden
  - _name: CopyCustomerLegalAccount
    label: Copy
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CopyAction
    multipleSelectionAllowed: true
    stepper: DataProject.entities.CustomerLegalAccount.steppers.CustomerGolden
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: DataProject.entities.CustomerLegalAccount.display_cards.CustomerLegalAccount
    formTab: DataProject.entities.CustomerLegalAccount.Forms.CustomerGoldenOverview.Main
