_name: IssuingAuthorityCodeResolved
_type: SemQLValidation
_package: DataProject.entities.CustomerLegalAccount.Validations
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
label: Issuing Authority Code Resolved
validationScope: POST_CONSO
validationLabel: "ISSUING_AUTHORITY_UNMAPPED - CRM issuing authority code has no matching Issuing Authority in MDM."
condition: |-
  (IsFreeZone IS NOT NULL AND IsFreeZone = '1')
  OR (IssuingAuthority IS NULL OR FID_IssuingAuthorityCode IS NOT NULL)
