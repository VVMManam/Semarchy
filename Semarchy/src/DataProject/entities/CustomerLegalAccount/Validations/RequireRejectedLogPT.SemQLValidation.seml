_name: RequireRejectedLogPT
_package: DataProject.entities.CustomerLegalAccount.Validations
_type: SemQLValidation
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
label: Require Rejected Log - Ports
validationScope: NONE
condition: ANY MergeApprovalLog HAVE (UPPER(Decision) = 'REJECTED' AND FinalMergeApproved IS NULL AND (UPPER(ClusterCode) IN ('PT', 'PORTS') OR UPPER(ClusterName) IN ('PT', 'PORTS')))
validationLabel: "Add a Merge Approval Decision row for Ports with Decision = REJECTED before using Reject Merge."
