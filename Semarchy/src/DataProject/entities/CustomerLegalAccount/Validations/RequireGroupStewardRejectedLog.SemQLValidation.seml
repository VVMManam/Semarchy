_name: RequireGroupStewardRejectedLog
_package: DataProject.entities.CustomerLegalAccount.Validations
_type: SemQLValidation
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
label: Require Group Steward Rejected Log
validationScope: NONE
condition: ANY MergeApprovalLog HAVE (UPPER(ReviewerRole) = 'MDM_GROUP_STEWARD' AND UPPER(Decision) = 'REJECTED' AND (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate))
validationLabel: "Add a Merge Approval Decision row with Reviewer Role = MDM_Group_Steward and Decision = REJECTED before using Reject Merge."
