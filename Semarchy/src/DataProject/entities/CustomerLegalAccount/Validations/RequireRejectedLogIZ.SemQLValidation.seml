_name: RequireRejectedLogIZ
_package: DataProject.entities.CustomerLegalAccount.Validations
_type: SemQLValidation
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
label: Require Rejected Log - Industrial Zone
validationScope: NONE
condition: ANY MergeApprovalLog HAVE (UPPER(Decision) = 'REJECTED' AND FinalMergeApproved IS NULL AND (UPPER(ClusterCode) IN ('IZ', 'INDUSTRIAL ZONE') OR UPPER(ClusterName) IN ('IZ', 'INDUSTRIAL ZONE')))
validationLabel: "Add a Merge Approval Decision row for Industrial Zone with Decision = REJECTED before using Reject Merge."
