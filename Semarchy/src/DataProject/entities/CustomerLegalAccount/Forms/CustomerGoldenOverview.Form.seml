                  isVisibleValueInterpreter: LITERAL
              - _name: OvPrimaryAddress
                value: "LOOKUP first CASE WHEN EnrichedAddress IS NOT NULL THEN EnrichedAddress ELSE AddressLine1 END FROM Address ORDER BY IsPrimary DESC END"
                dataType: STRING
                useCustomLabel: true
                label: Primary Address
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "1"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "6"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: OvDqStatus
                value: "'●'"
                dataType: STRING
                useCustomLabel: true
                label: "Data Quality"
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textColor: "CASE WHEN LOOKUP count ConstraintName FROM Errors END > 0 THEN 'md: red 700' ELSE 'md: green 500' END"
                  textColorValueInterpreter: SEMQL
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: display-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "20"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: OvDqIssues
                value: "LOOKUP distinct_string_agg CASE WHEN ConstraintName LIKE '%BusinessPhoneFormateCheck%' THEN 'Business phone format is invalid' WHEN ConstraintName LIKE '%EmailInvalidCheck%' THEN 'Email address is invalid' WHEN ConstraintName LIKE '%EmailMultipleCheck%' THEN 'More than one email address in the email field' WHEN ConstraintName LIKE '%LicenseExpiryDateValid%' THEN 'License expiry date is invalid or expired' WHEN ConstraintName LIKE '%MobileFormatCheck%' THEN 'Mobile number format is invalid' WHEN ConstraintName LIKE '%NameJunkCheck%' THEN 'Customer name contains junk characters' WHEN ConstraintName LIKE '%WebsiteInvalidCheck%' THEN 'Website address is invalid' WHEN ConstraintName LIKE '%PaymentTermResolved%' THEN 'Payment term is not available in MDM' WHEN ConstraintName LIKE '%LicenseTypeResolved%' THEN 'License type is not available in MDM' WHEN ConstraintName LIKE '%IssuingAuthorityCodeResolved%' THEN 'Issuing authority is not available in MDM' WHEN ConstraintName LIKE '%RegistrationEmirateResolved%' THEN 'Issuing emirate is not available in MDM' ELSE ConstraintName || ' (' || ConstraintType || ')' END SEPARATED BY '\n' FROM Errors END"
                dataType: STRING
                useCustomLabel: true
                label: "Data Quality Issues"
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  contentBackgroundColor: "md: red 50"
                  contentBackgroundColorValueInterpreter: LITERAL
                  textColor: "md: red 700"
                  textColorValueInterpreter: LITERAL
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "1"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "20"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
          - _type: FormContainer
            _name: OvContainer2
            layoutDirection: COLUMN
            content:
              - _name: OvPcName
                value: "LOOKUP first CASE WHEN LastName IS NULL THEN FirstName ELSE FirstName || ' ' || LastName END FROM Contact ORDER BY PrimaryFocalPoint DESC, ContactId END"
                dataType: STRING
                useCustomLabel: true
                label: "Primary Contact"
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "6"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: OvTags
                value: "'<div style=\"margin:0;padding:0;line-height:1\">' || '<div style=\"display:flex;align-items:flex-start;margin:0 0 6px 0\"><div style=\"flex:0 0 228px;text-align:left;padding:4px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px\">Status</div><div style=\"flex:1\">' || CASE WHEN Status = 'Active' THEN '<span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">Active</span>' WHEN Status = 'Inactive' THEN '<span style=\"display:inline-block;background:#FFCDD2;color:#B71C1C;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">Inactive</span>' WHEN Status IS NULL THEN '-' ELSE '<span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' || Status || '</span>' END || '</div></div>' || '<div style=\"display:flex;align-items:flex-start;margin:0 0 6px 0\"><div style=\"flex:0 0 228px;text-align:left;padding:4px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px\">Customer State</div><div style=\"flex:1\">' || CASE WHEN CustomerState = 'C02' THEN '<span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">Approved</span>' WHEN CustomerState = 'C01' THEN '<span style=\"display:inline-block;background:#FFF59D;color:#6D4C00;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">Under Process</span>' WHEN CustomerState = 'C03' THEN '<span style=\"display:inline-block;background:#FFCDD2;color:#B71C1C;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">Denied</span>' WHEN CustomerState IS NULL THEN '-' ELSE '<span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' || CustomerState || '</span>' END || '</div></div>' || '<div style=\"display:flex;align-items:flex-start;margin:0 0 6px 0\"><div style=\"flex:0 0 228px;text-align:left;padding:4px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px\">Clusters</div><div style=\"flex:1\">' || COALESCE(LOOKUP distinct_string_agg (CASE WHEN Cluster LIKE '%Corp%' THEN '<span style=\"display:inline-block;background:#009FE3;color:#FFFFFF;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Digital%' THEN '<span style=\"display:inline-block;background:#A286BF;color:#FFFFFF;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Industrial%' THEN '<span style=\"display:inline-block;background:#F9423A;color:#FFFFFF;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Logistics%' THEN '<span style=\"display:inline-block;background:#70D547;color:#12330A;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Maritime%' THEN '<span style=\"display:inline-block;background:#14C5BD;color:#FFFFFF;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Ports%' THEN '<span style=\"display:inline-block;background:#B0D6E3;color:#0D3B4C;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' ELSE '<span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' END) || Cluster || '</span>' SEPARATED BY ' ' FROM CustomerOrgAssignment WHERE Cluster IS NOT NULL END, '-') || '</div></div>' || '<div style=\"display:flex;align-items:flex-start;margin:0 0 6px 0\"><div style=\"flex:0 0 228px;text-align:left;padding:4px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px\">Business Units</div><div style=\"flex:1\">' || COALESCE(LOOKUP distinct_string_agg (CASE WHEN Cluster LIKE '%Corp%' THEN '<span style=\"display:inline-block;background:#009FE3;color:#FFFFFF;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Digital%' THEN '<span style=\"display:inline-block;background:#A286BF;color:#FFFFFF;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Industrial%' THEN '<span style=\"display:inline-block;background:#F9423A;color:#FFFFFF;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Logistics%' THEN '<span style=\"display:inline-block;background:#70D547;color:#12330A;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Maritime%' THEN '<span style=\"display:inline-block;background:#14C5BD;color:#FFFFFF;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' WHEN Cluster LIKE '%Ports%' THEN '<span style=\"display:inline-block;background:#B0D6E3;color:#0D3B4C;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' ELSE '<span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:13px;font-weight:500;line-height:20px;white-space:nowrap\">' END) || FDN_BusinessUnitCode || '</span>' SEPARATED BY ' ' FROM CustomerOrgAssignment WHERE FDN_BusinessUnitCode IS NOT NULL END, '-') || '</div></div>' || '<div style=\"display:flex;align-items:flex-start;margin:0 0 6px 0\"><div style=\"flex:0 0 228px;text-align:left;padding:4px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px\">Profile Types</div><div style=\"flex:1\">' || COALESCE(LOOKUP distinct_string_agg '<span style=\"display:inline-block;background:#e0e0e0;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:14px;line-height:20px\">' || FDN_ProfileTypeCode || '</span>' SEPARATED BY ' ' FROM Profile WHERE FDN_ProfileTypeCode IS NOT NULL END, '-') || '</div></div>' || '<div style=\"display:flex;align-items:flex-start;margin:0 0 6px 0\"><div style=\"flex:0 0 228px;text-align:left;padding:4px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px\">Contact Purposes</div><div style=\"flex:1\">' || COALESCE(LOOKUP distinct_string_agg '<span style=\"display:inline-block;background:#e0e0e0;border-radius:16px;padding:3px 12px;margin:0 6px 4px 0;font-size:14px;line-height:20px\">' || FDN_ContactRoleCode || '</span>' SEPARATED BY ' ' FROM Contact.ContactPurpose WHERE FDN_ContactRoleCode IS NOT NULL END, '-') || '</div></div>' || '</div>'"
                dataType: STRING
                useCustomLabel: true
                label: "Key Details"
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: MarkdownField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  contentHeight: "'276'"
                  contentHeightValueInterpreter: SEMQL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: "0"
                  isVisibleValueInterpreter: LITERAL
