73%22  font-size=%2210%22 fill=%22rgb(97,110,124)%22%3Ereject / remerge%3C/text%3E%3Cg transform=%22translate(655,287)%22%3E%3Crect x=%220%22 y=%220%22 width=%22175%22 height=%2244%22 rx=%2210%22 filter=%22url(%23sh)%22 ' || (CASE WHEN COALESCE(LOOKUP FIRST UPPER(Decision) FROM MergeApprovalLog WHERE UPPER(ClusterCode) = 'GROUP' AND UPPER(Decision) IN ('CONFIRMED', 'REJECTED', 'REMERGE') AND (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) ORDER BY DecisionTimestamp DESC END, 'P') IN ('REJECTED', 'REMERGE') THEN 'fill=%22white%22 stroke=%22rgb(226,232,240)%22 stroke-width=%221%22' ELSE 'fill=%22white%22 stroke=%22rgb(154,165,177)%22 stroke-width=%221.2%22 stroke-dasharray=%225,4%22' END) || '/%3E%3Crect x=%220%22 y=%220%22 width=%226%22 height=%2244%22 rx=%223%22 ' || ('fill=%22rgb(123,31,162)%22') || '/%3E%3Ctext x=%2216%22 y=%2219%22  font-size=%2213%22 font-weight=%22600%22 fill=%22rgb(31,41,51)%22%3EGroup Steward Review view%3C/text%3E%3Ctext x=%2216%22 y=%2235%22  font-size=%2211%22 ' || (CASE WHEN COALESCE(LOOKUP FIRST UPPER(Decision) FROM MergeApprovalLog WHERE UPPER(ClusterCode) = 'GROUP' AND UPPER(Decision) IN ('CONFIRMED', 'REJECTED', 'REMERGE') AND (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) ORDER BY DecisionTimestamp DESC END, 'P') IN ('REJECTED', 'REMERGE') THEN 'fill=%22rgb(123,31,162)%22%3EDemerge / remerge here' ELSE 'fill=%22rgb(97,110,124)%22%3EDemerge / remerge, then publish' END) || '%3C/text%3E%3C/g%3E%3Cg transform=%22translate(850,185)%22%3E%3Crect x=%220%22 y=%220%22 width=%22125%22 height=%2244%22 rx=%2210%22 filter=%22url(%23sh)%22 ' || ('fill=%22white%22 stroke=%22rgb(154,165,177)%22 stroke-width=%221.2%22 stroke-dasharray=%225,4%22') || '/%3E%3Crect x=%220%22 y=%220%22 width=%226%22 height=%2244%22 rx=%223%22 ' || ('fill=%22rgb(154,165,177)%22') || '/%3E%3Ctext x=%2216%22 y=%2219%22  font-size=%2213%22 font-weight=%22600%22 fill=%22rgb(31,41,51)%22%3EPublish%3C/text%3E%3Ctext x=%2216%22 y=%2235%22  font-size=%2211%22 ' || ('fill=%22rgb(97,110,124)%22%3EAfter the decisions') || '%3C/text%3E%3C/g%3E%3C/svg%3E'
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                componentProperties:
                  imageSourceType: url
                  imageSourceTypeValueInterpreter: LITERAL
                  imageMode: fit
                  imageModeValueInterpreter: LITERAL
                  imageAlign: top-left
                  imageAlignValueInterpreter: LITERAL
                  imageHeight: '262'
                  imageHeightValueInterpreter: LITERAL
                  showFullSizeOnClick: '1'
                  showFullSizeOnClickValueInterpreter: LITERAL
                labelProperties:
                  isVisible: '0'
                  isVisibleValueInterpreter: LITERAL
              - _type: FormContainer
                _name: WfIdsPT
                layoutDirection: ROW
                content:
                  - _type: FormContainer
                    _name: WfIdsLPT
                    layoutDirection: COLUMN
                    relativeWidth: 50
                    content:
                      - _name: WorkflowRefPT
                        value: '''Cluster Merge Approval'''
                        dataType: STRING
                        useCustomLabel: true
                        label: Workflow
                        visibleValue: '1'
                        visibleValueInterpreter: LITERAL
                        _type: TextField
                        labelProperties:
                          typography: body-1
                          typographyValueInterpreter: LITERAL
                        authoringMode: force-browsing
                        authoringModeValueInterpreter: LITERAL
                      - _name: TaskNamePT
                        value: CASE WHEN 1 = 0 THEN 'Group Steward Review' ELSE 'Ports' || ' Review' END
                        dataType: STRING
                        useCustomLabel: true
                        label: Task
                        visibleValue: '1'
                        visibleValueInterpreter: LITERAL
                        _type: TextField
                        labelProperties:
                          typography: body-1
                          typographyValueInterpreter: LITERAL
                        authoringMode: force-browsing
                        authoringModeValueInterpreter: LITERAL
                  - _type: FormContainer
                    _name: WfIdsRPT
                    layoutDirection: COLUMN
                    relativeWidth: 50
                    content:
                      - _name: TaskAssignedPT
                        value: |-
                          CASE WHEN 1 = 0 THEN COALESCE(LOOKUP MAX DecisionTimestamp FROM MergeApprovalLog WHERE UPPER(ClusterCode) <> 'GROUP' AND UPPER(Decision) IN ('CONFIRMED', 'REJECTED', 'REMERGE') AND (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) END, ApprovalRequestedOn) ELSE ApprovalRequestedOn END
                        dataType: TIMESTAMP
                        useCustomLabel: true
                        label: Task assigned on
                        visibleValue: '1'
                        visibleValueInterpreter: LITERAL
                        _type: DateField
                        labelProperties:
                          typography: body-1
                          typographyValueInterpreter: LITERAL
                        authoringMode: force-browsing
                        authoringModeValueInterpreter: LITERAL
                        componentProperties:
                          useTimePicker: '1'
                          useTimePickerValueInterpreter: LITERAL
                      - _name: MergedByPT
                        value: COALESCE(ApprovalRequestedByInfo, ApprovalRequestedBy, 'a cluster steward')
                        dataType: STRING
                        useCustomLabel: true
                        label: Merged by
                        visibleValue: '1'
                        visibleValueInterpreter: LITERAL
                        _type: TextField
                        labelProperties:
                          typography: body-1
                          typographyValueInterpreter: LITERAL
                        authoringMode: force-browsing
                        authoringModeValueInterpreter: LITERAL
          - _type: FormSection
            _name: ReviewSectionPT
            label: Review the merge
            layoutDirection: COLUMN
            documentationInterpreter: LITERAL
            visibleValue: '1'
            visibleValueInterpreter: LITERAL
            relativeWidth: 50
            content:
              - _name: ExplainRecordPT
                _type: HyperlinkField
                labelProperties:
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                label: Explain Record
                useCustomLabel: true
                dataType: STRING
                value: |-
                  'https://adpg-mdm-dev.eu.semarchy.net/dm/mdm-app/' || COALESCE(:V_DATALOCATION, 'adpg_model1') || '/CustomerHub/explain/CustomerLegalAccount/FindAndMergeDuplicates_ExplainRecord/' || CustomerLegalAccountID || '?fromAction=BrowseDuplicate&browsingPath=CustomerDuplicateView'
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                componentProperties:
                  linkTarget: new-window
                  linkTargetValueInterpreter: LITERAL
                  linkSourceType: url
                  linkSourceTypeValueInterpreter: LITERAL
                  linkDisplayText: Open Explain Record (opens in a new tab)
                  linkDisplayTextValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
              - _name: GuidancePT
                _type: MarkdownField
                label: Guidance
                useCustomLabel: true
                dataType: STRING
                value: |-
                  '#### Merge approval - Ports' || '
                  ' || '' || '
                  ' || '**Merged by:** ' || COALESCE(ApprovalRequestedByInfo, ApprovalRequestedBy, 'A cluster steward') || '  ' || '
                  ' || '**Customer:** ' || COALESCE(NameEN, '') || ' (' || COALESCE(CustomerGoldenId, '') || ')  ' || '
                  ' || '**Clusters reviewing:** ' || SUBSTR(CASE WHEN SelReviewMT = 'true' THEN ', Maritime' ELSE '' END || CASE WHEN SelReviewIZ = 'true' THEN ', Industrial Zone' ELSE '' END || CASE WHEN SelReviewLG = 'true' THEN ', Logistics' ELSE '' END || CASE WHEN SelReviewCO = 'true' THEN ', Corp' ELSE '' END || CASE WHEN SelReviewPT = 'true' THEN ', Ports' ELSE '' END || CASE WHEN SelReviewDC = 'true' THEN ', Digital' ELSE '' END, 3) || '  ' || '
                  ' || '**Your decision:** **' || CASE UPPER(COALESCE(LOOKUP FIRST Decision FROM MergeApprovalLog WHERE UPPER(ClusterCode) = 'PORTS' AND (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) ORDER BY DecisionTimestamp DESC END, '')) WHEN 'CONFIRMED' THEN 'Confirm' WHEN 'REJECTED' THEN 'Reject' WHEN 'REMERGE' THEN 'Remerge' ELSE 'Not recorded yet' END || '**' || '
                  ' || '' || '
                  ' || '1. Open **Explain Record** - check why the masters matched and which values were kept.' || '
                  ' || '2. Click **Next**, then **+** - choose **Confirm**, **Reject** or **Remerge** (comment required for Reject / Remerge).' || '
                  ' || '3. Click **Submit Decision**.'
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                labelProperties:
                  isVisible: '0'
                  isVisibleValueInterpreter: LITERAL
