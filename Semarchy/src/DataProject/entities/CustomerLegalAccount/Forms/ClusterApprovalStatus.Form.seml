          - _type: FormSection
            _name: WorkflowSectionDC
            label: Approval workflow
            layoutDirection: COLUMN
            documentationInterpreter: LITERAL
            visibleValue: '1'
            visibleValueInterpreter: LITERAL
            relativeWidth: 50
            content:
              - _name: DiagramDC
                _type: ImageField
                label: Workflow
                useCustomLabel: true
                dataType: STRING
