_name: CustomerMerge
_package: DataProject.entities.CustomerLegalAccount.BusinessViews
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
rootLabel: Customer Merge
rootPluralLabel: Customer Merge
useHierarchyOnOpen: false
label: Customer Merge
rootBusinessViewEntity:
  _name: Customer
  _type: BusinessViewEntity
  collection: DataProject.entities.CustomerLegalAccount.Collections.CustomerDuplicateView
