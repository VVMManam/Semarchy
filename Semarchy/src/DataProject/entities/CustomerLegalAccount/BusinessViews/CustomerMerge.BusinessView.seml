rootFilter: |-
  CustomerState = 'C02'
  AND (
      SEM_INSTR(:V_USER_ROLES, 'semarchyAdmin') > 0
      OR (SEM_INSTR(:V_USER_ROLES, 'MDM_Group_Steward') > 0 AND SEM_INSTR(Cluster, ',') > 0)
      OR (SEM_INSTR(:V_USER_ROLES, 'MDM_Ports_Steward') > 0 AND Cluster like '%Ports%')
      OR (SEM_INSTR(:V_USER_ROLES, 'MDM_Corp_Steward') > 0 AND Cluster like '%Corp%')
      OR (SEM_INSTR(:V_USER_ROLES, 'MDM_Maritime_Steward') > 0 AND Cluster like '%Maritime%')
      OR (SEM_INSTR(:V_USER_ROLES, 'MDM_IndustrialZone_Steward') > 0 AND Cluster like '%Industrial Zone%')
      OR (SEM_INSTR(:V_USER_ROLES, 'MDM_Logistics_Steward') > 0 AND Cluster like '%Logistics%')
      OR (SEM_INSTR(:V_USER_ROLES, 'MDM_Digital_Steward') > 0 AND Cluster like '%Digital Cluster%')
  )
