_name: GoldenErrorView
_package: DataProject.entities.CustomerLegalAccount.BusinessViews
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
rootLabel: Customer Records With Errors
rootPluralLabel: Customer Records With Errors
useHierarchyOnOpen: false
label: Customer Records With Errors
rootBusinessViewEntity:
  _name: Customer
  _type: BusinessViewEntity
  collection: DataProject.entities.CustomerLegalAccount.Collections.GoldenErrorView
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
  form: DataProject.entities.CustomerLegalAccount.Forms.CustomerGoldenOverview
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: false
  tableAllowed: true
  actionSet: DataProject.entities.CustomerLegalAccount.ActionSets.CustomerGolden
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs: []
  transitions: []
rootFilter: |-
  LOOKUP count ConstraintName FROM Errors END > 0
