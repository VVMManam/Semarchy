_name: DeriveCountryFromAuthority
_type: JavaPluginEnricher
_package: DataProject.entities.CustomerLegalAccount.enrichers
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
label: Derive registration country from issuing authority
description: "When the customer arrives without a registration country, sets it to the country of its issuing authority (IssuingAuthority reference data). A country that was sent is kept as sent (lookup fallback = the input value), so an invalid country is still rejected by the reference check as before. FID_IssuingAuthorityCode is always a valid MDM code or empty (ResolveIssuingAuthority), so the authority branch always finds its row."
enricherExecutionScope: PRE_CONSO
numberOfRetry: 3
onErrorBehavior: SKIP_RECORDS
pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CUSTOM_SQL
    value: select 'IA|' || upper(trim(issuing_authority_code)) LOOKUP_COLUMN,
                   f_country_code OUTPUT_COLUMN1
            from gd_issuing_authority

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_LOOKUP_VALUE

  - paramName: PARAM_CACHE
    value: LOAD_ON_START

pluginInputs:
  - expression: "CASE WHEN FID_RegistrationCountry IS NOT NULL THEN FID_RegistrationCountry WHEN FID_IssuingAuthorityCode IS NOT NULL THEN 'IA|' || UPPER(BTRIM(FID_IssuingAuthorityCode)) ELSE NULL END"
    inputName: IN_LOOKUP_VALUE

pluginOutputs:
  - attributeName: FID_RegistrationCountry
    outputName: OUT_RESULT1

processingBatchSize: 100
threadPoolSize: 1
