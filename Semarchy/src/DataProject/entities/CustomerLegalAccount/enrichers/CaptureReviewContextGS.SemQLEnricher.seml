_type: SemQLEnricher
_name: CaptureReviewContextGS
label: Capture Review Context (Group Steward Review)
_package: DataProject.entities.CustomerLegalAccount.enrichers
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
enricherExecutionScope: NONE
description: 'Merge Overview step of the Group Steward Review task: sets only the task code (a short text) used by the Merge Overview form; no date/time is written to the customer.'
semQlEnricherExpressions:
  - attributeName: ReviewTaskCode
    expression: '''GS'''
