_name: PartyLinkedCustomers
_type: CollectionView
_package: DataProject.entities.CustomerLegalAccount.Collections
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
default: false
displayCard: DataProject.entities.CustomerLegalAccount.display_cards.CustomerLegalAccount
tableDisplayCardColumnWidth: 50
tableAllowed: true
tableRowLines: 2
tableShowDisplayCard: false
tableDisplayCardColumnLabel: "Customer"
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: HyperlinkColumn
    _name: OpenCustomerId
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: "Customer ID"
    value: "CASE WHEN COALESCE(CustomerGoldenId, SEM_NUMBER_TO_CHAR(CustomerLegalAccountID)) IS NULL THEN NULL ELSE COALESCE(CustomerGoldenId, SEM_NUMBER_TO_CHAR(CustomerLegalAccountID)) || '|' || '/dm/mdm-app/' || COALESCE(:V_DATALOCATION, 'adpg_model1') || '/CustomerApplication/browsing/CustomerGoldenView/' || SEM_NUMBER_TO_CHAR(CustomerLegalAccountID) || '?fromAction=BrowseCustomerLegalAccounts' END"
    visibleByDefault: true
    componentProperties:
      linkSourceType: url
      linkSourceTypeValueInterpreter: LITERAL
      linkTarget: new-window
      linkTargetValueInterpreter: LITERAL
  - _type: HyperlinkColumn
    _name: OpenCustomerName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: "Customer Name"
    value: "CASE WHEN NameEN IS NULL THEN NULL ELSE NameEN || '|' || '/dm/mdm-app/' || COALESCE(:V_DATALOCATION, 'adpg_model1') || '/CustomerApplication/browsing/CustomerGoldenView/' || SEM_NUMBER_TO_CHAR(CustomerLegalAccountID) || '?fromAction=BrowseCustomerLegalAccounts' END"
    visibleByDefault: true
    componentProperties:
      linkSourceType: url
      linkSourceTypeValueInterpreter: LITERAL
      linkTarget: new-window
      linkTargetValueInterpreter: LITERAL
  - _type: TextColumn
    _name: NameAr
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NameAr
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: CustomerState
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN CustomerState = 'C02' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Approved</span></div>' WHEN CustomerState = 'C01' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFF59D;color:#6D4C00;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Under Process</span></div>' WHEN CustomerState = 'C03' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFCDD2;color:#B71C1C;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Denied</span></div>' WHEN CustomerState IS NULL THEN NULL ELSE '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' || CustomerState || '</span></div>' END"
    label: Customer State
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: Status
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN Status = 'Active' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Active</span></div>' WHEN Status = 'Inactive' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFCDD2;color:#B71C1C;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Inactive</span></div>' WHEN Status IS NULL THEN NULL ELSE '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' || Status || '</span></div>' END"
    label: Status
    visibleByDefault: true
  - _type: TextColumn
    _name: PaymentTerm
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PaymentTerm
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: LicenseExpiryDate
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN LicenseExpiryDate IS NULL THEN NULL WHEN LicenseExpiryDate < NOW() THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFCDD2;color:#B71C1C;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Expired · ' || TO_CHAR(LicenseExpiryDate, 'DD Mon YYYY') || '</span></div>' ELSE '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' || TO_CHAR(LicenseExpiryDate, 'DD Mon YYYY') || '</span></div>' END"
    label: "Licence Expiry"
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: Vat
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN TaxRegistrationNumber IS NOT NULL THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Registered</span></div>' ELSE '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFF59D;color:#6D4C00;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Not provided</span></div>' END"
    label: "VAT"
    visibleByDefault: true
  - _type: TextColumn
    _name: FusionId
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN LOOKUP string_agg Value SEPARATED BY ', ' FROM Identifier WHERE FID_IdentifierType = 'FUSION_AR_CUSTOMER_ID' END IS NULL THEN 'Not onboarded' ELSE LOOKUP string_agg Value SEPARATED BY ', ' FROM Identifier WHERE FID_IdentifierType = 'FUSION_AR_CUSTOMER_ID' END END"
    label: "Fusion AR Customer Id"
    visibleByDefault: true
    componentProperties:
      textColor: "CASE WHEN LOOKUP string_agg Value SEPARATED BY ', ' FROM Identifier WHERE FID_IdentifierType = 'FUSION_AR_CUSTOMER_ID' END IS NULL THEN 'md: orange 800' ELSE 'md: grey 900' END"
      textColorValueInterpreter: SEMQL
  - _type: MarkdownColumn
    _name: Departments
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "'<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' || SEM_NUMBER_TO_CHAR(LOOKUP count CustomerOrgAssignmentID FROM CustomerOrgAssignment END) || '</span></div>'"
    label: "Departments"
    visibleByDefault: true
  - _type: TextColumn
    _name: PrimaryContact
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "LOOKUP first CASE WHEN LastName IS NULL THEN FirstName ELSE FirstName || ' ' || LastName END FROM Contact ORDER BY PrimaryFocalPoint DESC, ContactId END"
    label: "Primary Contact"
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: Errors
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN LOOKUP count ConstraintName FROM Errors END > 0 THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFCDD2;color:#B71C1C;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' || SEM_NUMBER_TO_CHAR(LOOKUP count ConstraintName FROM Errors END) || ' error(s)</span></div>' ELSE '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">No errors</span></div>' END"
    label: "Errors"
    visibleByDefault: true
  - _type: DateColumn
    _name: AccountCreationDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: true
    value: AccountCreationDate
    label: "Creation Date"
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LicenseNumber
    visibleByDefault: true
  - _type: TextColumn
    _name: IssuingAuthorityCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: FDN_IssuingAuthorityCode
    label: Issuing Authority
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: IssuingEmirateCode
    columnAlign: LEFT
    dataType: STRING
    referencedEntity: DataProject.entities.Emirate.Emirate
    useCustomLabel: true
    value: FDN_RegistrationEmirateCode
    label: Issuing Emirate
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "0"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: IssuingCountry
    columnAlign: LEFT
    dataType: STRING
    referencedEntity: DataProject.entities.Country.CountryReference
    useCustomLabel: true
    value: FDN_RegistrationCountry
    label: Issuing Country
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: LicenseStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LicenseStatusCode
    visibleByDefault: true
  - _type: TextColumn
    _name: TaxRegistrationNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: TaxRegistrationNumber
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: Cluster
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "'<div style=\"margin:0;padding:0 4px 0 0;line-height:1;max-height:40px;overflow-y:auto\">' || LOOKUP distinct_string_agg (CASE WHEN Cluster LIKE '%Corp%' THEN '<span style=\"display:inline-block;background:#009FE3;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Digital%' THEN '<span style=\"display:inline-block;background:#A286BF;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Industrial%' THEN '<span style=\"display:inline-block;background:#F9423A;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Logistics%' THEN '<span style=\"display:inline-block;background:#70D547;color:#12330A;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Maritime%' THEN '<span style=\"display:inline-block;background:#14C5BD;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Ports%' THEN '<span style=\"display:inline-block;background:#B0D6E3;color:#0D3B4C;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' ELSE '<span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' END) || Cluster || '</span>' SEPARATED BY ' ' FROM CustomerOrgAssignment WHERE Cluster IS NOT NULL END || '</div>'"
    label: "Cluster"
    visibleByDefault: true
    defaultWidth: 260
  - _type: TextColumn
    _name: Email
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Email
    visibleByDefault: true
  - _type: TextColumn
    _name: EstablishmentAddress
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: EstablishmentAddress
    visibleByDefault: false
  - _type: DateColumn
    _name: LicenseRegistrationDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: LicenseRegistrationDate
    visibleByDefault: false
  - _type: DateColumn
    _name: LicenseIssueDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: LicenseIssueDate
    visibleByDefault: false
  - _type: DateColumn
    _name: LicenseStartDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: LicenseStartDate
    visibleByDefault: false
  - _type: TextColumn
    _name: LicenseValidityStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LicenseValidityStatusCode
    visibleByDefault: false
  - _type: TextColumn
    _name: NoVATDeclaration
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NoVATDeclaration
    visibleByDefault: false
  - _type: TextColumn
    _name: Website
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Website
    visibleByDefault: false
  - _type: TextColumn
    _name: Fax
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Fax
    visibleByDefault: false
  - _type: TextColumn
    _name: CustomerCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: CustomerCode
    visibleByDefault: false
  - _type: TextColumn
    _name: IsVip
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: IsVip
    visibleByDefault: false
  - _type: TextColumn
    _name: IsBranch
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: IsBranch
    visibleByDefault: false
