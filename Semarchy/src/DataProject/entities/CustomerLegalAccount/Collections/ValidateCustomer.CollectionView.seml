_name: ValidateCustomer
_type: CollectionView
_package: DataProject.entities.CustomerLegalAccount.Collections
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
default: false
displayCard: DataProject.entities.CustomerLegalAccount.display_cards.CustomerLegalAccount
tableDisplayCardColumnWidth: 50
tableAllowed: true
tableRowLines: 2
tableShowDisplayCard: true
tableDisplayCardColumnLabel: "Customer"
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: Status
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: CASE WHEN Status = 'Inactive' THEN 'Inactive' WHEN Status = 'Active' THEN 'Active' ELSE Status END
    label: Status
    visibleByDefault: true
  - _type: TextColumn
    _name: CustomerState
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Customer State
    value: CASE WHEN CustomerState = 'C01' THEN 'Under Process' WHEN CustomerState = 'C02' THEN 'Approved' WHEN CustomerState = 'C03' THEN 'Denied' ELSE CustomerState END
    visibleByDefault: true
  - _type: TextColumn
    _name: NameAr
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NameAr
    visibleByDefault: true
