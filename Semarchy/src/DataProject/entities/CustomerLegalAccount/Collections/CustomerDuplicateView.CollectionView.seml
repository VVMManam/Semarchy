_name: CustomerDuplicateView
_type: CollectionView
_package: DataProject.entities.CustomerLegalAccount.Collections
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
default: false
displayCard: DataProject.entities.CustomerLegalAccount.display_cards.CustomerDuplicate
tableDisplayCardColumnWidth: 50
tableAllowed: true
tableRowLines: 2
tableShowDisplayCard: true
tableDisplayCardColumnLabel: "Customer"
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: MarkdownColumn
    _name: MatchScore
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN SuggestedMergeConfidenceScore IS NOT NULL THEN '<span style=\"display:inline-block;background:#E0E0E0;color:#424242;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px\">' || SuggestedMergeConfidenceScore || '%</span>' END"
    label: Match Score
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: Outstanding
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE COALESCE(LOOKUP max CASE WHEN OutstandingStatus = 'YES' THEN 3 WHEN OutstandingStatus = 'ERROR' THEN 2 WHEN OutstandingStatus = 'NO' THEN 1 ELSE 0 END FROM CustomerOutstanding WHERE RecordType = 'RESULT' END, 0) WHEN 3 THEN '<span style=\"display:inline-block;background:#FDECEA;color:#B71C1C;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px\">Outstanding</span>' WHEN 2 THEN '<span style=\"display:inline-block;background:#FFF4E5;color:#8A4B00;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px\">Check failed</span>' WHEN 1 THEN '<span style=\"display:inline-block;background:#E8F5E9;color:#1B5E20;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px\">No outstanding</span>' ELSE '<span style=\"display:inline-block;background:#EEEEEE;color:#616161;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px\">Not checked</span>' END"
    label: Outstanding
    visibleByDefault: true
  - _type: TextColumn
    _name: OpenTransactions
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "'' || LOOKUP sum OpenTransactions FROM CustomerOutstanding WHERE RecordType = 'RESULT' END"
    label: Open Transactions
    visibleByDefault: true
  - _type: DateColumn
    _name: OutstandingCheckedAt
    columnAlign: LEFT
    dataType: TIMESTAMP
    useCustomLabel: true
    value: "LOOKUP min CheckedAt FROM CustomerOutstanding WHERE RecordType = 'RESULT' END"
    label: Outstanding Checked At
    visibleByDefault: true
  - _type: TextColumn
    _name: NameAr
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NameAr
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LicenseNumber
    visibleByDefault: true
  - _type: TextColumn
    _name: IssuingAuthorityCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: FDN_IssuingAuthorityCode
    label: Issuing Authority
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: IssuingEmirateCode
    columnAlign: LEFT
    dataType: STRING
    referencedEntity: DataProject.entities.Emirate.Emirate
    useCustomLabel: true
    value: FDN_RegistrationEmirateCode
    label: Issuing Emirate
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "0"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: IssuingCountry
    columnAlign: LEFT
    dataType: STRING
    referencedEntity: DataProject.entities.Country.CountryReference
    useCustomLabel: true
    value: FDN_RegistrationCountry
    label: Issuing Country
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: LicenseStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LicenseStatusCode
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: CustomerState
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN CustomerState = 'C02' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Approved</span></div>' WHEN CustomerState = 'C01' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFF59D;color:#6D4C00;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Under Process</span></div>' WHEN CustomerState = 'C03' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFCDD2;color:#B71C1C;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Denied</span></div>' WHEN CustomerState IS NULL THEN NULL ELSE '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' || CustomerState || '</span></div>' END"
    label: Customer State
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: Status
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "CASE WHEN Status = 'Active' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#C8E6C9;color:#1B5E20;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Active</span></div>' WHEN Status = 'Inactive' THEN '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#FFCDD2;color:#B71C1C;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">Inactive</span></div>' WHEN Status IS NULL THEN NULL ELSE '<div style=\"margin:0;padding:0;line-height:1\"><span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:1px 10px;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' || Status || '</span></div>' END"
    label: Status
    visibleByDefault: true
  - _type: TextColumn
    _name: MergeApprovalStatus
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Merge Approval Status
    value: |-
      CASE WHEN (SelReviewMT = 'true' OR SelReviewIZ = 'true' OR SelReviewLG = 'true' OR SelReviewCO = 'true' OR SelReviewPT = 'true' OR SelReviewDC = 'true') THEN
        CASE WHEN LENGTH(CASE WHEN SelReviewMT = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'MT' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Maritime' ELSE '' END || CASE WHEN SelReviewIZ = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'IZ' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Industrial Zone' ELSE '' END || CASE WHEN SelReviewLG = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'LGSTS' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Logistics' ELSE '' END || CASE WHEN SelReviewCO = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'CORP' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Corp' ELSE '' END || CASE WHEN SelReviewPT = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'PORTS' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Ports' ELSE '' END || CASE WHEN SelReviewDC = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'DC' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Digital Cluster' ELSE '' END) > 0 THEN 'In Progress - Pending: ' || SUBSTR(CASE WHEN SelReviewMT = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'MT' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Maritime' ELSE '' END || CASE WHEN SelReviewIZ = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'IZ' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Industrial Zone' ELSE '' END || CASE WHEN SelReviewLG = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'LGSTS' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Logistics' ELSE '' END || CASE WHEN SelReviewCO = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'CORP' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Corp' ELSE '' END || CASE WHEN SelReviewPT = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'PORTS' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Ports' ELSE '' END || CASE WHEN SelReviewDC = 'true' AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'DC' AND UPPER(Decision) IN ('CONFIRMED','REJECTED') END IS NULL THEN ', Digital Cluster' ELSE '' END, 3)
             WHEN LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND UPPER(Decision) = 'CONFIRMED' AND ClusterCode <> 'GROUP' END IS NOT NULL AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND UPPER(Decision) = 'REJECTED' AND ClusterCode <> 'GROUP' END IS NOT NULL AND LOOKUP FIRST ClusterCode FROM MergeApprovalLog WHERE (CustomerLegalAccount.MergeDecisionDate IS NULL OR DecisionTimestamp > CustomerLegalAccount.MergeDecisionDate) AND ClusterCode = 'GROUP' END IS NULL THEN 'In Progress - Pending: Group Steward Approval'
             ELSE 'In Progress - Pending: Submit Change' END
      WHEN MergeDecisionDate IS NOT NULL AND ApprovalCheck = 'true' THEN 'Confirmed'
      WHEN MergeDecisionDate IS NOT NULL AND ApprovalCheck = 'false' THEN 'Rejected'
      ELSE NULL END
    visibleByDefault: true
  - _type: TextColumn
    _name: TaxRegistrationNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: TaxRegistrationNumber
    visibleByDefault: true
  - _type: MarkdownColumn
    _name: Cluster
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "'<div style=\"margin:0;padding:0 4px 0 0;line-height:1;max-height:40px;overflow-y:auto\">' || LOOKUP distinct_string_agg (CASE WHEN Cluster LIKE '%Corp%' THEN '<span style=\"display:inline-block;background:#009FE3;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Digital%' THEN '<span style=\"display:inline-block;background:#A286BF;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Industrial%' THEN '<span style=\"display:inline-block;background:#F9423A;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Logistics%' THEN '<span style=\"display:inline-block;background:#70D547;color:#12330A;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Maritime%' THEN '<span style=\"display:inline-block;background:#14C5BD;color:#FFFFFF;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' WHEN Cluster LIKE '%Ports%' THEN '<span style=\"display:inline-block;background:#B0D6E3;color:#0D3B4C;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' ELSE '<span style=\"display:inline-block;background:#E0E0E0;color:#212121;border-radius:16px;padding:1px 10px;margin:0 4px 2px 0;font-size:12px;font-weight:500;line-height:16px;white-space:nowrap\">' END) || Cluster || '</span>' SEPARATED BY ' ' FROM CustomerOrgAssignment WHERE Cluster IS NOT NULL END || '</div>'"
    label: "Cluster"
    visibleByDefault: true
    defaultWidth: 260
  - _type: TextColumn
    _name: Email
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Email
    visibleByDefault: true
  - _type: TextColumn
    _name: EstablishmentAddress
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: EstablishmentAddress
    visibleByDefault: true
  - _type: DateColumn
    _name: LicenseRegistrationDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: LicenseRegistrationDate
    visibleByDefault: true
  - _type: DateColumn
    _name: LicenseIssueDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: LicenseIssueDate
    visibleByDefault: true
  - _type: DateColumn
    _name: LicenseStartDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: LicenseStartDate
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseValidityStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LicenseValidityStatusCode
    visibleByDefault: false
  - _type: TextColumn
    _name: NoVATDeclaration
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NoVATDeclaration
    visibleByDefault: true
  - _type: TextColumn
    _name: Website
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Website
    visibleByDefault: true
  - _type: TextColumn
    _name: Fax
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Fax
    visibleByDefault: true
  - _type: TextColumn
    _name: PaymentTerm
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PaymentTerm
    visibleByDefault: true
  - _type: TextColumn
    _name: CustomerCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: CustomerCode
    visibleByDefault: true
  - _type: TextColumn
    _name: IsVip
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: IsVip
    visibleByDefault: true
  - _type: TextColumn
    _name: IsBranch
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: IsBranch
    visibleByDefault: true
  - _type: TextColumn
    _name: KeyIdentifiers
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Identifiers
    value: "LOOKUP distinct_string_agg Value SEPARATED BY ', ' FROM Identifier END"
    visibleByDefault: true
  - _type: TextColumn
    _name: KeyTaxRegistrations
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Tax Registration Nos
    value: "LOOKUP distinct_string_agg RegistrationNo SEPARATED BY ', ' FROM TaxRegistration END"
    visibleByDefault: true
  - _type: TextColumn
    _name: KeyClusters
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Clusters
    value: "LOOKUP distinct_string_agg Cluster SEPARATED BY ', ' FROM Profile END"
    visibleByDefault: true
  - _type: TextColumn
    _name: KeyDepartments
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Departments
    value: "LOOKUP distinct_string_agg DeptCode SEPARATED BY ', ' FROM CustomerOrgAssignment END"
    visibleByDefault: true
  - _type: TextColumn
    _name: KeyAddresses
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Addresses
    value: "LOOKUP distinct_string_agg CASE WHEN AddressUsageCode IS NULL THEN '-' ELSE AddressUsageCode END || ': ' || CASE WHEN AddressLine1 IS NULL THEN '' ELSE AddressLine1 END SEPARATED BY ', ' FROM Address END"
    visibleByDefault: false
  - _type: TextColumn
    _name: KeyContacts
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Contacts
    value: "LOOKUP distinct_string_agg CASE WHEN FirstName IS NULL THEN '' ELSE FirstName END || ' ' || CASE WHEN LastName IS NULL THEN '' ELSE LastName END SEPARATED BY ', ' FROM Contact END"
    visibleByDefault: false
  - _type: TextColumn
    _name: KeyContactEmiratesIds
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Contact Emirates IDs
    value: "LOOKUP distinct_string_agg EmiratesId SEPARATED BY ', ' FROM Contact END"
    visibleByDefault: true
  - _type: TextColumn
    _name: KeyContactEmails
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Contact Emails
    value: "LOOKUP distinct_string_agg Email SEPARATED BY ', ' FROM Contact END"
    visibleByDefault: false
  - _type: TextColumn
    _name: KeyLicenseActivities
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: License Activities
    value: "LOOKUP distinct_string_agg Name SEPARATED BY ', ' FROM LicenseActivity END"
    visibleByDefault: false
