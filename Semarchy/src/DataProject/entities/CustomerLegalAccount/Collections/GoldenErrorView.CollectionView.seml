    _name: CustomerType
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: CustomerType
    visibleByDefault: true
  - _type: TextColumn
    _name: AccountType
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: CASE WHEN AccountType = 'Normal' THEN 'Normal' WHEN AccountType = 'ADPorts ICP' THEN 'ADPorts ICP' WHEN AccountType = 'ADPorts RP' THEN 'ADPorts RP' WHEN AccountType = 'ADQ ICP' THEN 'ADQ ICP' WHEN AccountType = 'Internal' THEN 'Internal' WHEN AccountType = 'Government' THEN 'Government' WHEN AccountType = 'ADQ RP' THEN 'ADQ RP' ELSE AccountType END
    label: Account Type
    visibleByDefault: true
  - _type: TextColumn
    _name: Website
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Website
    visibleByDefault: true
