_name: GoldenErrorView
_type: CollectionView
_package: DataProject.entities.CustomerLegalAccount.Collections
entity: DataProject.entities.CustomerLegalAccount.CustomerLegalAccount
default: false
displayCard: DataProject.entities.CustomerLegalAccount.display_cards.CustomerLegalAccount
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: true
tableDisplayCardColumnLabel: "Customer"
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: ErrorDetails
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: "LOOKUP string_agg ConstraintName SEPARATED BY ', ' FROM Errors END"
    label: Error Details
    visibleByDefault: true
  - _type: TextColumn
    _name: AccountStatus
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    value: CASE WHEN AccountStatus = 'I' THEN 'Inactive' WHEN AccountStatus = 'A' THEN 'Active' ELSE AccountStatus END
    label: Account Status
    visibleByDefault: true
  - _type: TextColumn
    _name: NameEN
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NameEN
    visibleByDefault: true
  - _type: TextColumn
    _name: NameAr
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NameAr
    visibleByDefault: true
