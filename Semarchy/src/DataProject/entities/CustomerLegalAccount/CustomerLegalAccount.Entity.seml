    physicalName: MERGE_DECISION_DATE
    dataType: Timestamp
    precision: 3
    goldenAttribute: true
    mandatory: false
    label: Merge Decision Date
    searchable: true
  - _type: EntityAttribute
    _name: MergeApprovalStatus
    physicalName: MERGE_APPROVAL_STATUS
    dataType: DataProject.List_of_values.MergeWorkflowStatus
    goldenAttribute: true
    mandatory: false
    label: Merge Approval Status
    length: 20
    lovValidationScope: POST_CONSO
    searchable: true
    description: 'NOT_REQUIRED (not merged or single cluster), PENDING (cluster approval open), CONFIRMED. Set by EvaluateMergeDecision. SyncCustomer and CustomerMerge do not publish PENDING records.'
  - _type: EntityAttribute
    _name: ApprovalMastersCount
    physicalName: APPROVAL_MASTERS_COUNT
    dataType: Integer
    goldenAttribute: true
    mandatory: false
    label: Approval Masters Count
    precision: 10
    searchable: true
    description: 'Number of masters (merged customers) of the composition requested / approved. A merge that changes it requests a new approval.'
  - _type: EntityAttribute
    _name: ApprovalRequestedBatchID
    physicalName: APPROVAL_REQ_BATCH_ID
    dataType: LongInteger
    goldenAttribute: true
    mandatory: false
    label: Approval Requested Batch ID
    precision: 38
    searchable: true
    description: 'Batch in which the merge approval was requested. ClusterMergeApproval starts only for records whose request is in the batch just completed.'
  - _type: EntityAttribute
    _name: LkpMastersCount
    physicalName: LKP_MASTERS_COUNT
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Masters Count (lookup)
    length: 10
    searchable: false
    description: 'Number of master records consolidated into this golden record (enricher ResolveMastersCount). Used to detect a merge.'
  - _type: EntityAttribute
    _name: PrevApprovalStatus
    physicalName: PREV_APPR_STATUS
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Previous Merge Approval Status (lookup)
    length: 20
    searchable: false
    description: 'Merge approval status published before this batch (enricher ResolveMastersCount, read from the golden table). Used by EvaluateMergeDecision so that an approval already requested or confirmed is kept.'
  - _type: EntityAttribute
    _name: PrevApprovalMastersCount
    physicalName: PREV_APPR_MASTERS_CNT
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Previous Approval Masters Count (lookup)
    length: 10
    searchable: false
    description: 'Approval masters count published before this batch (enricher ResolveMastersCount).'
  - _type: EntityAttribute
    _name: PrevApprovalReqBatchID
    physicalName: PREV_APPR_REQ_BATCH_ID
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Previous Approval Request Batch (lookup)
    length: 20
    searchable: false
    description: 'Approval request batch published before this batch (enricher ResolveMastersCount).'
  - _type: EntityAttribute
    _name: PrevApprovalReqBy
    physicalName: PREV_APPR_REQ_BY
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Previous Approval Requested By (lookup)
    length: 128
    searchable: false
    description: 'Approval requester published before this batch (enricher ResolveMastersCount).'
  - _type: EntityAttribute
    _name: ApprovalRequestedOn
    physicalName: APPROVAL_REQ_ON
    dataType: Timestamp
    precision: 3
    goldenAttribute: true
    mandatory: false
    label: Merge Done On
    searchable: false
    description: 'When the merge that requested the cluster approval was done (EvaluateMergeDecision). Shown as Task Assigned On for the cluster review tasks.'
  - _type: EntityAttribute
    _name: ApprovalRequestedByInfo
    physicalName: APPROVAL_REQ_BY_INFO
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Merged By
    length: 200
    searchable: false
    description: 'Full name and steward cluster(s) of the user who did the merge (EvaluateMergeDecision), shown to the reviewers.'
  - _type: EntityAttribute
    _name: PrevApprovalReqOn
    physicalName: PREV_APPR_REQ_ON
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Previous Merge Done On (lookup)
    length: 30
    searchable: false
    description: 'Published ApprovalRequestedOn before this batch (ResolveMastersCount), text YYYY-MM-DD HH24:MI:SS.'
  - _type: EntityAttribute
    _name: PrevApprovalReqByInfo
    physicalName: PREV_APPR_REQ_BY_INFO
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Previous Merged By (lookup)
    length: 200
    searchable: false
    description: 'Published ApprovalRequestedByInfo before this batch (ResolveMastersCount).'
  - _type: EntityAttribute
    _name: LkpCycleStatus
    physicalName: LKP_CYCLE_STATUS
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Cycle Outcome (lookup)
    length: 20
    searchable: false
    description: 'Outcome of the decisions of the running approval round, including the Merge Approval Log rows submitted in the same batch (ResolveCycleDecision): GROUP_REVIEW (Group Steward Reject / Remerge) or CONFIRMED. Empty = no decision in this batch.'
  - _type: EntityAttribute
    _name: LkpCycleDecisionOn
    physicalName: LKP_CYCLE_DEC_ON
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Cycle Last Decision On (lookup)
    length: 30
    searchable: false
    description: 'Latest decision time of the running approval round, YYYY-MM-DD HH24:MI:SS (ResolveCycleDecision).'
  - _type: EntityAttribute
    _name: LkpCycleDecision
    physicalName: LKP_CYCLE_DECISION
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Cycle Final Decision (lookup)
    length: 20
    searchable: false
    description: 'Final decision of the running approval round: the Group Steward decision, otherwise the latest cluster decision (ResolveCycleDecision).'
  - _type: EntityAttribute
    _name: ReviewWorkflowLoadId
    physicalName: REVIEW_WF_LOAD_ID
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Review Workflow Load
    length: 40
    searchable: false
    description: 'Load (data set) of the merge approval workflow the review task belongs to; set when a reviewer opens the task (CaptureReviewContext enrichers).'
  - _type: EntityAttribute
    _name: ReviewTaskCode
    physicalName: REVIEW_TASK_CODE
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Review Task
    length: 10
    searchable: false
    description: 'Code of the review task being opened (MT, IZ, LG, CO, PT, DC or GS); set by the CaptureReviewContext enricher of the task stepper and used by the Merge Overview form.'
  - _type: EntityAttribute
    _name: ReviewStatusMT
    physicalName: REVIEW_STATUS_MT
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Review Status MT
    length: 1
    searchable: false
    description: 'Saved decision of the MT review in the current cycle, read from all parallel tasks (LookupReviewStatuses): C confirm, R reject, M remerge, empty = pending.'
  - _type: EntityAttribute
    _name: ReviewStatusIZ
    physicalName: REVIEW_STATUS_IZ
