    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: LicenseFormatValid
    label: License Format Valid
    physicalName: FORMAT_VALID
    dataType: Boolean
    goldenAttribute: true
    i18ned: false
    mandatory: false
    length: 0
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: LicenseValidatedBy
    label: License Validated By
    physicalName: VALIDATED_BY
    dataType: String
    goldenAttribute: true
    i18ned: false
    mandatory: false
    length: 100
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: LicenseValidatedOn
    label: License Validated On
    physicalName: VALIDATED_ON
    dataType: Date
    goldenAttribute: true
    i18ned: false
    mandatory: false
    length: 0
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: NameMatchKey
    label: Name Match Key
    physicalName: NAME_MATCH_KEY
    dataType: String
    goldenAttribute: true
    i18ned: false
    mandatory: false
    length: 200
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: IssuingAuthority
    label: Issuing Authority
    physicalName: ISSUING_AUTH
    dataType: String
    goldenAttribute: true
    i18ned: false
    mandatory: false
    length: 100
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: OutstandingCheckResult
    physicalName: OUTSTANDING_CHECK_RES
    dataType: String
    goldenAttribute: true
    mandatory: false
    label: Outstanding Check Result
    length: 20
    searchable: false
    description: 'Result of the outstanding-balance API call made when a steward merges this customer (CheckOutstandingOnMerge): true = outstanding found (merge blocked), false = clear. Overwritten on every merge attempt; not a balance.'
matcher:
         
  _name: SemlQLMatcherCustomer
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 100
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 100
  mergeThresholdMergingConfirmedWithNewMasters: 100
  mergeThresholdMergingConfirmedWithUnconfirmed: 100
  mergeThresholdMergingUnconfirmed: 100
  mergeThresholdMergingUnconfirmedWithNewMasters: 100
  mergeThresholdNewGroup: 100
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: false
  useTransitiveMatchScore: false
  matchRules:
 
    - _type: SemQLMatchRule
      _name: MR01_Same_name_licence_authority_and_country
      condition: |-
        (
          Record1.NameMatchKey IS NOT NULL
          AND Record2.NameMatchKey IS NOT NULL
          AND Record1.LicenseNumber IS NOT NULL
          AND Record2.LicenseNumber IS NOT NULL
          AND Record1.FID_IssuingAuthorityCode IS NOT NULL
          AND Record2.FID_IssuingAuthorityCode IS NOT NULL
          AND Record1.FID_RegistrationCountry IS NOT NULL
          AND Record2.FID_RegistrationCountry IS NOT NULL
          AND UPPER(BTRIM(Record1.NameMatchKey)) = UPPER(BTRIM(Record2.NameMatchKey))
          AND UPPER(BTRIM(Record1.LicenseNumber)) = UPPER(BTRIM(Record2.LicenseNumber))
          AND UPPER(BTRIM(Record1.FID_IssuingAuthorityCode)) = UPPER(BTRIM(Record2.FID_IssuingAuthorityCode))
          AND UPPER(BTRIM(Record1.FID_RegistrationCountry)) = UPPER(BTRIM(Record2.FID_RegistrationCountry))
          AND (Record1.LicenseIsPlaceholder IS NULL OR Record1.LicenseIsPlaceholder = '0')
          AND (Record2.LicenseIsPlaceholder IS NULL OR Record2.LicenseIsPlaceholder = '0')
        )
        AND (Record1.Status IS NULL OR Record1.Status <> 'Inactive')
        AND (Record2.Status IS NULL OR Record2.Status <> 'Inactive')
        AND (Record1.IsBranch = '0' OR Record2.IsBranch = '0')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.IsFreeZone, '0') = COALESCE(Record2.IsFreeZone, '0')
      label: "MR-01 Exact licence match"
      description: "The two records have the same English name, the same trade licence number, the same issuing authority and the same country of registration. Placeholder licence numbers are ignored. This is the strongest evidence that both records are the same legal entity."
      documentation: "The two records have the same English name, the same trade licence number, the same issuing authority and the same country of registration. Placeholder licence numbers are ignored. This is the strongest evidence that both records are the same legal entity."
      matchScore: 98
      usingMatchOn: false
 
 
    - _type: SemQLMatchRule
      _name: MR02_Same_licence_authority_country_and_similar_name
      condition: |-
        (
          Record1.LicenseNumber IS NOT NULL
          AND Record2.LicenseNumber IS NOT NULL
          AND UPPER(BTRIM(Record1.LicenseNumber)) = UPPER(BTRIM(Record2.LicenseNumber))
          AND Record1.FID_IssuingAuthorityCode IS NOT NULL
          AND Record2.FID_IssuingAuthorityCode IS NOT NULL
          AND UPPER(BTRIM(Record1.FID_IssuingAuthorityCode)) = UPPER(BTRIM(Record2.FID_IssuingAuthorityCode))
          AND Record1.FID_RegistrationCountry IS NOT NULL
          AND Record2.FID_RegistrationCountry IS NOT NULL
          AND UPPER(BTRIM(Record1.FID_RegistrationCountry)) = UPPER(BTRIM(Record2.FID_RegistrationCountry))
          AND Record1.NameMatchKey IS NOT NULL
          AND Record2.NameMatchKey IS NOT NULL
          AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(Record1.NameMatchKey), UPPER(Record2.NameMatchKey)) >= 85
          AND (Record1.LicenseIsPlaceholder IS NULL OR Record1.LicenseIsPlaceholder = '0')
          AND (Record2.LicenseIsPlaceholder IS NULL OR Record2.LicenseIsPlaceholder = '0')
        )
        AND (Record1.Status IS NULL OR Record1.Status <> 'Inactive')
        AND (Record2.Status IS NULL OR Record2.Status <> 'Inactive')
        AND (Record1.IsBranch = '0' OR Record2.IsBranch = '0')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.IsFreeZone, '0') = COALESCE(Record2.IsFreeZone, '0')
      label: "MR-02 Licence, similar name"
      description: "Both records have the same trade licence number, the same issuing authority and the same country of registration, and the names are at least 85% alike. Placeholder licence numbers are ignored. A data steward reviews before merging."
      documentation: "Both records have the same trade licence number, the same issuing authority and the same country of registration, and the names are at least 85% alike. Placeholder licence numbers are ignored. A data steward reviews before merging."
      matchScore: 95
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MR03_Same_Fusion_or_ERP_customer_ID
      condition: |-
        (
          (
             Record1.FID_IdentifierType IS NOT NULL
             AND Record2.FID_IdentifierType IS NOT NULL
             AND Record1.FID_IdentifierType = 'FUSION_AR_CUSTOMER_ID'
             AND Record2.FID_IdentifierType = 'FUSION_AR_CUSTOMER_ID'
            AND Record1.Value IS NOT NULL
            AND Record2.Value IS NOT NULL
            AND Record1.Value = Record2.Value
          )
          OR
          (
            Record1.FID_IdentifierType IS NOT NULL
             AND Record2.FID_IdentifierType IS NOT NULL
             AND Record1.FID_IdentifierType = 'ERP_CUSTOMER_ID'
             AND Record2.FID_IdentifierType = 'ERP_CUSTOMER_ID'
            AND Record1.Value IS NOT NULL
            AND Record2.Value IS NOT NULL
            AND Record1.Value = Record2.Value
          )
        )
        AND (Record1.CustomerID.Status IS NULL OR Record1.CustomerID.Status <> 'Inactive')
        AND (Record2.CustomerID.Status IS NULL OR Record2.CustomerID.Status <> 'Inactive')
        AND COALESCE(Record1.CustomerID.IsFreeZone, '0') = COALESCE(Record2.CustomerID.IsFreeZone, '0')
      label: "MR-03 Same ERP/Fusion ID"
      description: "Both records carry the same Oracle Fusion AR customer ID, or the same ERP customer ID. The source system already treats them as one customer, so they are the same legal entity."
      documentation: "Both records carry the same Oracle Fusion AR customer ID, or the same ERP customer ID. The source system already treats them as one customer, so they are the same legal entity."
      matchScore: 98
      usingMatchOn: true
      matchOnExpression: Identifier
 
    - _type: SemQLMatchRule
      _name: MR04_Same_TRN_and_very_similar_name
      condition: |-
        (
          Record1.FID_TaxTypeCode IS NOT NULL
          AND Record2.FID_TaxTypeCode IS NOT NULL
          AND Record1.FID_TaxTypeCode = 'AE_VAT'
          AND Record2.FID_TaxTypeCode = 'AE_VAT'
          AND Record1.Cgid.TaxRegistrationNumber IS NOT NULL
          AND Record2.Cgid.TaxRegistrationNumber IS NOT NULL
          AND Record1.Cgid.TaxRegistrationNumber = Record2.Cgid.TaxRegistrationNumber
          AND (Record1.Cgid.IsBranch = '0' OR Record2.Cgid.IsBranch = '0')
          AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(Record1.Cgid.NameEN), UPPER(Record2.Cgid.NameEN)) >= 90
        )
        AND (Record1.Cgid.Status IS NULL OR Record1.Cgid.Status <> 'Inactive')
        AND (Record2.Cgid.Status IS NULL OR Record2.Cgid.Status <> 'Inactive')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.Cgid.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.Cgid.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.Cgid.IsFreeZone, '0') = COALESCE(Record2.Cgid.IsFreeZone, '0')
      label: "MR-04 Same TRN"
      description: "Both records have the same UAE VAT registration number and their English names are at least 90% alike. At least one of the two must be a head office (not a branch), so branches sharing a group TRN are not merged with each other."
      documentation: "Both records have the same UAE VAT registration number and their English names are at least 90% alike. At least one of the two must be a head office (not a branch), so branches sharing a group TRN are not merged with each other."
      matchScore: 95
      usingMatchOn: true
      matchOnExpression: TaxRegistration
 
    - _type: SemQLMatchRule
      _name: MR05_Same_licence_and_country_different_authority_very_similar_name
      condition: |-
        (
          Record1.LicenseNumber IS NOT NULL
          AND Record2.LicenseNumber IS NOT NULL
          AND Record1.LicenseNumber = Record2.LicenseNumber
          AND Record1.FID_RegistrationCountry IS NOT NULL
          AND Record2.FID_RegistrationCountry IS NOT NULL
          AND Record1.FID_RegistrationCountry = Record2.FID_RegistrationCountry
          AND Record1.FID_IssuingAuthorityCode IS NOT NULL
          AND Record2.FID_IssuingAuthorityCode IS NOT NULL
          AND Record1.FID_IssuingAuthorityCode <> Record2.FID_IssuingAuthorityCode
          AND Record1.NameMatchKey IS NOT NULL
          AND Record2.NameMatchKey IS NOT NULL
          AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(Record1.NameMatchKey), UPPER(Record2.NameMatchKey)) >= 95
        )
        AND (Record1.Status IS NULL OR Record1.Status <> 'Inactive')
        AND (Record2.Status IS NULL OR Record2.Status <> 'Inactive')
        AND (Record1.IsBranch = '0' OR Record2.IsBranch = '0')
        AND (Record1.LicenseIsPlaceholder IS NULL OR Record1.LicenseIsPlaceholder = '0')
        AND (Record2.LicenseIsPlaceholder IS NULL OR Record2.LicenseIsPlaceholder = '0')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.IsFreeZone, '0') = COALESCE(Record2.IsFreeZone, '0')
      label: "MR-05 Licence, diff authority"
      description: "Both records have the same trade licence number and country, but the issuing authority is recorded differently. The names are at least 95% alike. Usually the authority was captured wrongly in one source. A data steward reviews before merging."
      documentation: "Both records have the same trade licence number and country, but the issuing authority is recorded differently. The names are at least 95% alike. Usually the authority was captured wrongly in one source. A data steward reviews before merging."
      matchScore: 95
      usingMatchOn: false
 
    - _type: SemQLMatchRule
      _name: MR06_Same_licence_and_country_different_authority_loosely_similar_name
      condition: |-
        (
          Record1.LicenseNumber IS NOT NULL
          AND Record2.LicenseNumber IS NOT NULL
          AND Record1.LicenseNumber = Record2.LicenseNumber
          AND Record1.FID_RegistrationCountry IS NOT NULL
          AND Record2.FID_RegistrationCountry IS NOT NULL
          AND Record1.FID_RegistrationCountry = Record2.FID_RegistrationCountry
          AND Record1.FID_IssuingAuthorityCode IS NOT NULL
          AND Record2.FID_IssuingAuthorityCode IS NOT NULL
          AND Record1.FID_IssuingAuthorityCode <> Record2.FID_IssuingAuthorityCode
          AND Record1.NameMatchKey IS NOT NULL
          AND Record2.NameMatchKey IS NOT NULL
          AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(Record1.NameMatchKey), UPPER(Record2.NameMatchKey)) >= 75
          AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(Record1.NameMatchKey), UPPER(Record2.NameMatchKey)) < 90
        )
        AND (Record1.Status IS NULL OR Record1.Status <> 'Inactive')
        AND (Record2.Status IS NULL OR Record2.Status <> 'Inactive')
        AND (Record1.IsBranch = '0' OR Record2.IsBranch = '0')
        AND (Record1.LicenseIsPlaceholder IS NULL OR Record1.LicenseIsPlaceholder = '0')
        AND (Record2.LicenseIsPlaceholder IS NULL OR Record2.LicenseIsPlaceholder = '0')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.IsFreeZone, '0') = COALESCE(Record2.IsFreeZone, '0')
      label: "MR-06 Licence, loose name"
      description: "Both records have the same trade licence number and country, the issuing authority differs, and the names are only 75% to 89% alike. This may be the same company or two companies with a coincidental licence number. A data steward must review."
      documentation: "Both records have the same trade licence number and country, the issuing authority differs, and the names are only 75% to 89% alike. This may be the same company or two companies with a coincidental licence number. A data steward must review."
      matchScore: 85
      usingMatchOn: false
 
    - _type: SemQLMatchRule
      _name: MR07_Same_name_and_same_MOL_number
      condition: |-
        (
          Record1.FID_IdentifierType IS NOT NULL
          AND Record2.FID_IdentifierType IS NOT NULL
          AND Record1.FID_IdentifierType = 'MOL'
          AND Record2.FID_IdentifierType = 'MOL'
          AND Record1.CustomerID.NameMatchKey IS NOT NULL
          AND Record2.CustomerID.NameMatchKey IS NOT NULL
          AND Record1.Value IS NOT NULL
          AND Record2.Value IS NOT NULL
          AND UPPER(BTRIM(Record1.CustomerID.NameMatchKey)) = UPPER(BTRIM(Record2.CustomerID.NameMatchKey))
          AND UPPER(BTRIM(Record1.Value)) = UPPER(BTRIM(Record2.Value))
        )
        AND (Record1.CustomerID.Status IS NULL OR Record1.CustomerID.Status <> 'Inactive')
        AND (Record2.CustomerID.Status IS NULL OR Record2.CustomerID.Status <> 'Inactive')
        AND (Record1.CustomerID.IsBranch = '0' OR Record2.CustomerID.IsBranch = '0')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.CustomerID.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.CustomerID.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.CustomerID.IsFreeZone, '0') = COALESCE(Record2.CustomerID.IsFreeZone, '0')
      label: "MR-07 Name + MOL number"
      description: "Both records have the same standardised name and the same Ministry of Labour (MOL) establishment number, whatever their licence details say. A data steward reviews before merging."
      documentation: "Both records have the same standardised name and the same Ministry of Labour (MOL) establishment number, whatever their licence details say. A data steward reviews before merging."
      matchScore: 88
      usingMatchOn: true
      matchOnExpression: Identifier


 
 
    - _type: SemQLMatchRule
      _name: MR08_Same_MOL_number_only
      condition: |-
        (
          Record1.FID_IdentifierType IS NOT NULL
          AND Record2.FID_IdentifierType IS NOT NULL
          AND Record1.FID_IdentifierType = 'MOL'
          AND Record2.FID_IdentifierType = 'MOL'
          AND Record1.Value IS NOT NULL
          AND Record2.Value IS NOT NULL
          AND UPPER(BTRIM(Record1.Value)) = UPPER(BTRIM(Record2.Value))
        )
        AND (Record1.CustomerID.Status IS NULL OR Record1.CustomerID.Status <> 'Inactive')
        AND (Record2.CustomerID.Status IS NULL OR Record2.CustomerID.Status <> 'Inactive')
        AND COALESCE(Record1.CustomerID.IsFreeZone, '0') = COALESCE(Record2.CustomerID.IsFreeZone, '0')
      label: "MR-08 MOL number only"
      description: "Both records have the same Ministry of Labour (MOL) establishment number, but the name is not compared. This is a backup rule for records with poor name or licence data. A data steward must review."
      documentation: "Both records have the same Ministry of Labour (MOL) establishment number, but the name is not compared. This is a backup rule for records with poor name or licence data. A data steward must review."
      matchScore: 80
      usingMatchOn: true
      matchOnExpression: Identifier
    
    - _type: SemQLMatchRule
      _name: MR09_Same_email_and_same_name
      condition: |-
        (
          Record1.Email IS NOT NULL
          AND Record2.Email IS NOT NULL
          AND Record1.NameEN IS NOT NULL
          AND Record2.NameEN IS NOT NULL
          AND LOWER(BTRIM(Record1.Email)) = LOWER(BTRIM(Record2.Email))
          AND (Record1.IsBranch = '0' OR Record2.IsBranch = '0')
          AND UPPER(BTRIM(Record1.NameEN)) = UPPER(BTRIM(Record2.NameEN))
        )
        AND (Record1.Status IS NULL OR Record1.Status <> 'Inactive')
        AND (Record2.Status IS NULL OR Record2.Status <> 'Inactive')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.IsFreeZone, '0') = COALESCE(Record2.IsFreeZone, '0')
      label: "MR-09 E-mail + name"
      description: "Both records have the same e-mail address and the same English name, and at least one of them is a head office (not a branch). There is no licence or tax evidence, so a data steward reviews before merging."
      documentation: "Both records have the same e-mail address and the same English name, and at least one of them is a head office (not a branch). There is no licence or tax evidence, so a data steward reviews before merging."
      matchScore: 75
      usingMatchOn: false
      
    - _type: SemQLMatchRule
      _name: MR10_Nearly_identical_licence_and_very_similar_name
      condition: |-
        (
          Record1.LicenseNumber IS NOT NULL
          AND Record2.LicenseNumber IS NOT NULL
          AND Record1.NameMatchKey IS NOT NULL
          AND Record2.NameMatchKey IS NOT NULL
          AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.LicenseNumber)), UPPER(BTRIM(Record2.LicenseNumber))) > 90
          AND (Record1.IsBranch = '0' OR Record2.IsBranch = '0')
          AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(Record1.NameMatchKey), UPPER(Record2.NameMatchKey)) > 90
        )
        AND (Record1.Status IS NULL OR Record1.Status <> 'Inactive')
        AND (Record2.Status IS NULL OR Record2.Status <> 'Inactive')
        AND (Record1.LicenseIsPlaceholder IS NULL OR Record1.LicenseIsPlaceholder = '0')
        AND (Record2.LicenseIsPlaceholder IS NULL OR Record2.LicenseIsPlaceholder = '0')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.IsFreeZone, '0') = COALESCE(Record2.IsFreeZone, '0')
      label: "MR-10 Near licence + name"
      description: "The licence numbers are more than 90% alike (for example a typing error or a missing prefix) and the names are more than 90% alike. At least one record must be a head office. A data steward reviews before merging."
      documentation: "The licence numbers are more than 90% alike (for example a typing error or a missing prefix) and the names are more than 90% alike. At least one record must be a head office. A data steward reviews before merging."
      matchScore: 80
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MR11_Very_similar_name_same_country_and_one_supporting_detail
      condition: |-
        (
          Record1.NameEN IS NOT NULL
          AND Record2.NameEN IS NOT NULL
          AND Record1.NameMatchKey IS NOT NULL
          AND Record2.NameMatchKey IS NOT NULL
          AND SEM_NGRAMS_SIMILARITY(UPPER(Record1.NameMatchKey), UPPER(Record2.NameMatchKey)) >= 93
          AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameEN)), UPPER(BTRIM(Record2.NameEN))) >= 85
          AND Record1.FID_RegistrationCountry IS NOT NULL
          AND Record2.FID_RegistrationCountry IS NOT NULL
          AND Record1.FID_RegistrationCountry = Record2.FID_RegistrationCountry
          AND (
            (Record1.FID_RegistrationEmirateCode IS NOT NULL
             AND Record1.FID_RegistrationEmirateCode = Record2.FID_RegistrationEmirateCode)
            OR (Record1.EmailDomain IS NOT NULL
             AND LOWER(BTRIM(Record1.EmailDomain)) = LOWER(BTRIM(Record2.EmailDomain))
             AND (Record1.IsGenericEmailDomain IS NULL OR Record1.IsGenericEmailDomain = '0'))
            OR (Record1.BusinessPhone IS NOT NULL
             AND REGEXP_REPLACE(Record1.BusinessPhone, '[^0-9]', '', 'g') = REGEXP_REPLACE(Record2.BusinessPhone, '[^0-9]', '', 'g'))
            OR (Record1.Mobile IS NOT NULL
             AND REGEXP_REPLACE(Record1.Mobile, '[^0-9]', '', 'g') = REGEXP_REPLACE(Record2.Mobile, '[^0-9]', '', 'g'))
            OR (Record1.EstablishmentAddress IS NOT NULL
             AND UPPER(BTRIM(Record1.EstablishmentAddress)) = UPPER(BTRIM(Record2.EstablishmentAddress)))
          )
        )
        AND (Record1.Status IS NULL OR Record1.Status <> 'Inactive')
        AND (Record2.Status IS NULL OR Record2.Status <> 'Inactive')
        AND (Record1.IsBranch = '0' OR Record2.IsBranch = '0')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record1.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND NOT REGEXP_LIKE(UPPER(BTRIM(Record2.NameEN)), '^([^A-Z\u0600-\u06FF]*|.{0,2}|TEST|MIS CUSTOMER|DUMMY|NA)$')
        AND COALESCE(Record1.IsFreeZone, '0') = COALESCE(Record2.IsFreeZone, '0')
      label: "MR-11 Name + other detail"
      description: "The names are very similar and both records are registered in the same country. In addition, at least one other detail agrees: the same emirate, the same company e-mail domain (not a public domain such as Gmail), the same business phone, the same mobile, or the same establishment address. A data steward must review."
      documentation: "The names are very similar and both records are registered in the same country. In addition, at least one other detail agrees: the same emirate, the same company e-mail domain (not a public domain such as Gmail), the same business phone, the same mobile, or the same establishment address. A data steward must review."
      matchScore: 82
      usingMatchOn: false

