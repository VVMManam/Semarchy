    visibleByDefault: true
  - _type: TextColumn
    _name: SourceSystemCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FID_SourceSystemCode
    visibleByDefault: true
  - _type: TextColumn
    _name: AllowWithholdingTax
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: AllowWithholdingTax
    visibleByDefault: true
  - _type: TextColumn
    _name: WithholdingTaxGroupCode
    columnAlign: LEFT
    dataType: STRING
