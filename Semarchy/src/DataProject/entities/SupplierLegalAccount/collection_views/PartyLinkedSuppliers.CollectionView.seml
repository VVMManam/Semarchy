    useCustomLabel: false
    value: Website
    visibleByDefault: true
  - _type: TextColumn
    _name: YearEstablished
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: YearEstablished
    visibleByDefault: true
  - _type: TextColumn
