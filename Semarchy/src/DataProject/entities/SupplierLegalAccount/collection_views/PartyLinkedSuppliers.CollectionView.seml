    visibleByDefault: true
  - _type: TextColumn
    _name: IssuingAuthorityCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FID_IssuingAuthorityCode
    visibleByDefault: true
  - _type: TextColumn
    _name: IssuingCountry
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FID_RegistrationCountry
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseTypeCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FID_LicenseTypeCode
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseStartDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: LicenseStartDate
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseExpiryDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: LicenseExpiryDate
    visibleByDefault: true
    componentProperties:
      textColor: "CASE WHEN LicenseExpiryDate IS NULL THEN 'md: grey 600' WHEN LicenseExpiryDate < NOW() THEN 'md: red 700' ELSE 'md: green 700' END"
      textColorValueInterpreter: SEMQL
  - _type: TextColumn
    _name: IsPrimaryLicense
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: IsPrimaryLicense
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseValidityStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LicenseValidityStatusCode
    visibleByDefault: true
    componentProperties:
      textColor: "CASE WHEN UPPER(LicenseValidityStatusCode) = 'VALID' THEN 'md: green 700' WHEN UPPER(LicenseValidityStatusCode) IN ('EXPIRED', 'CANCELLED') THEN 'md: red 700' ELSE 'md: grey 600' END"
      textColorValueInterpreter: SEMQL