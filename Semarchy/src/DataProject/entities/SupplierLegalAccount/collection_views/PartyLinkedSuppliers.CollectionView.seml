_name: PartyLinkedSuppliers
_type: CollectionView
_package: DataProject.entities.SupplierLegalAccount.collection_views
entity: DataProject.entities.SupplierLegalAccount.SupplierLegalAccount
default: false
displayCard: DataProject.entities.SupplierLegalAccount.display_cards.SupplierLegalAccount
tableDisplayCardColumnLabel: Supplier
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: false
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: HyperlinkColumn
    _name: OpenSupplierId
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: "Supplier ID"
    value: "CASE WHEN SupplierAccountId IS NULL THEN NULL ELSE SupplierAccountId || '|' || '/dm/mdm-app/' || COALESCE(:V_DATALOCATION, 'adpg_model1') || '/SupplierApplication/browsing/Supplier360View/' || SEM_NUMBER_TO_CHAR(Sgid) || '?fromAction=BrowseSupplier360View' END"
    visibleByDefault: true
    componentProperties:
      linkSourceType: url
      linkSourceTypeValueInterpreter: LITERAL
      linkTarget: new-window
      linkTargetValueInterpreter: LITERAL
  - _type: HyperlinkColumn
    _name: OpenSupplierName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: "Supplier Name"
    value: "CASE WHEN NameEn IS NULL THEN NULL ELSE NameEn || '|' || '/dm/mdm-app/' || COALESCE(:V_DATALOCATION, 'adpg_model1') || '/SupplierApplication/browsing/Supplier360View/' || SEM_NUMBER_TO_CHAR(Sgid) || '?fromAction=BrowseSupplier360View' END"
    visibleByDefault: true
    componentProperties:
      linkSourceType: url
      linkSourceTypeValueInterpreter: LITERAL
      linkTarget: new-window
      linkTargetValueInterpreter: LITERAL
  - _type: TextColumn
    _name: SupplierNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierNumber
    visibleByDefault: true
  - _type: TextColumn
    _name: FusionSupplierId
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FusionSupplierId
    visibleByDefault: true
    componentProperties:
      textColor: "CASE WHEN FusionSupplierId IS NULL THEN 'md: orange 800' ELSE 'md: grey 900' END"
      textColorValueInterpreter: SEMQL
  - _type: TextColumn
    _name: SupplierCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierCode
    visibleByDefault: true
  - _type: TextColumn
    _name: NameAlternate
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NameAlternate
    visibleByDefault: true
  - _type: TextColumn
    _name: SupplierTypeCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierTypeCode
    visibleByDefault: true
  - _type: TextColumn
    _name: BusinessRelationshipCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: BusinessRelationshipCode
    visibleByDefault: true
  - _type: TextColumn
    _name: OrganizationTypeCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: OrganizationTypeCode
    visibleByDefault: true
  - _type: TextColumn
    _name: AccountStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: AccountStatusCode
    visibleByDefault: true
    componentProperties:
      textColor: "CASE WHEN UPPER(AccountStatusCode) IN ('ACTIVE', 'A') THEN 'md: green 700' WHEN UPPER(AccountStatusCode) IN ('INACTIVE', 'I') THEN 'md: red 700' ELSE 'md: grey 600' END"
      textColorValueInterpreter: SEMQL
  - _type: TextColumn
    _name: SupplierState
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierState
    visibleByDefault: true
  - _type: TextColumn
    _name: IsOneTimeSupplier
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: IsOneTimeSupplier
    visibleByDefault: true
  - _type: TextColumn
