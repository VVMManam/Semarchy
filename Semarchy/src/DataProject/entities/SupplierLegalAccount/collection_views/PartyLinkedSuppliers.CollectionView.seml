  - _type: TextColumn
    _name: ChiefExecutiveTitle
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: ChiefExecutiveTitle
    visibleByDefault: true
  - _type: TextColumn
    _name: VATRegistrationNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: VATRegistrationNumber
    visibleByDefault: true
    componentProperties:
      textColor: "CASE WHEN VATRegistrationNumber IS NOT NULL THEN 'md: green 700' ELSE 'md: orange 800' END"
      textColorValueInterpreter: SEMQL
  - _type: TextColumn
    _name: StartDateActive
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: StartDateActive
    visibleByDefault: true
  - _type: TextColumn
