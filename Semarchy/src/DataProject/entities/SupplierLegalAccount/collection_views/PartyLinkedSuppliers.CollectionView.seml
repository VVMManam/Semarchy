  - _type: TextColumn
    _name: RemitAdviceDeliveryCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: RemitAdviceDeliveryCode
    visibleByDefault: true
  - _type: TextColumn
    _name: PaymentTermCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FID_PaymentTermCode
    visibleByDefault: true
  - _type: TextColumn
    _name: CurrenyCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FID_Currency
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LicenseNumber
    visibleByDefault: true
  - _type: TextColumn
    _name: LicenseStatusCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
