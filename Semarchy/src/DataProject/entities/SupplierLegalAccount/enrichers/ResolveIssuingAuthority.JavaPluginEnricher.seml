_name: ResolveIssuingAuthority
_type: JavaPluginEnricher
_package: DataProject.entities.SupplierLegalAccount.enrichers
entity: DataProject.entities.SupplierLegalAccount.SupplierLegalAccount
label: Resolve Issuing Authority (Fusion code, mapped to CRM authority)
enricherExecutionScope: PRE_CONSO
numberOfRetry: 3
onErrorBehavior: SKIP_RECORDS
pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CUSTOM_SQL
    value: select 'FUS|' || upper(trim(fusion_code)) LOOKUP_COLUMN,
                   coalesce(nullif(trim(maps_to_authority_code), ''), issuing_authority_code) OUTPUT_COLUMN1
            from gd_issuing_authority
            where fusion_code is not null
            union all
            select 'FUS|' || upper(trim(issuing_authority_code)) LOOKUP_COLUMN,
                   coalesce(nullif(trim(maps_to_authority_code), ''), issuing_authority_code) OUTPUT_COLUMN1
            from gd_issuing_authority
            union all
            select 'MDM|' || upper(trim(issuing_authority_code)) LOOKUP_COLUMN,
                   coalesce(nullif(trim(maps_to_authority_code), ''), issuing_authority_code) OUTPUT_COLUMN1
            from gd_issuing_authority

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_FALLBACK

  - paramName: PARAM_CACHE
    value: LOAD_ON_START

pluginInputs:
  - expression: "CASE WHEN FID_IssuingAuthorityCode IS NOT NULL THEN 'MDM|' || UPPER(BTRIM(FID_IssuingAuthorityCode)) WHEN IssuingAuthority IS NOT NULL THEN 'FUS|' || UPPER(BTRIM(IssuingAuthority)) ELSE NULL END"
    inputName: IN_LOOKUP_VALUE

pluginOutputs:
  - attributeName: FID_IssuingAuthorityCode
    outputName: OUT_RESULT1

processingBatchSize: 100
threadPoolSize: 1
