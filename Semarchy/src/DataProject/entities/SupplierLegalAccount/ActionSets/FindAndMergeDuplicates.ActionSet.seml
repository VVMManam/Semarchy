_name: FindAndMergeDuplicates
_type: ActionSet
_package: DataProject.entities.SupplierLegalAccount.ActionSets
entity: DataProject.entities.SupplierLegalAccount.SupplierLegalAccount
label: Find & Merge Duplicates
actions:
  - _name: FindAndMergeDuplicates
    useCustomLabel: true
    _type: MergeOrSplit
    label: Find & Merge Duplicates
    iconUrl: images://mdi/account-multiple-check.svg
    dupsManager: DataProject.entities.SupplierLegalAccount.DuplicateManager.SupplierLegalAccountDupsManager

  - _name: MergeDuplicates
    _type: ReviewAndConfirm
    label: Merge
    useCustomLabel: true
    iconUrl: images://mdi/call-merge.svg
    dupsManager: DataProject.entities.SupplierLegalAccount.DuplicateManager.SupplierLegalAccountDupsManager

  - _name: ReviewSuggestions
    _type: ReviewSuggestions
    label: Review Suggestions
    iconUrl: images://mdi/call-split.svg
    useCustomLabel: true
    dupsManager: DataProject.entities.SupplierLegalAccount.DuplicateManager.SupplierLegalAccountDupsManager
  
  - _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: DataProject.entities.SupplierLegalAccount.display_cards.SupplierLegalAccount
    formTab: DataProject.entities.SupplierLegalAccount.forms.SupplierMergeForm.Main