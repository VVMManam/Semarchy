goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1
sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
primaryKey: DataProject.entities.SupplierLegalAccount.SupplierLegalAccount.Sgid
entityType: FUZZY_MATCHED
matcher:
  _name: SemQLMatcherSupplierLegalAccount
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 100
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 100
  mergeThresholdMergingConfirmedWithNewMasters: 100
  mergeThresholdMergingConfirmedWithUnconfirmed: 100
  mergeThresholdMergingUnconfirmed: 100
  mergeThresholdMergingUnconfirmedWithNewMasters: 100
  mergeThresholdNewGroup: 100
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: true
  useTransitiveMatchScore: true
  matchRules:
    - _type: SemQLMatchRule
      _name: MAT02_TradeLicenceExact
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND Record1.LicenseNoNormalised IS NOT NULL
        AND Record2.LicenseNoNormalised IS NOT NULL
        AND UPPER(BTRIM(Record1.NameMatchKey)) = UPPER(BTRIM(Record2.NameMatchKey))
        AND UPPER(BTRIM(Record1.LicenseNoNormalised)) = UPPER(BTRIM(Record2.LicenseNoNormalised))
        AND (NULLIF(UPPER(BTRIM(Record1.FID_IssuingAuthorityCode)), '-1') IS NULL
             OR NULLIF(UPPER(BTRIM(Record2.FID_IssuingAuthorityCode)), '-1') IS NULL
             OR NULLIF(UPPER(BTRIM(Record1.FID_IssuingAuthorityCode)), '-1') = NULLIF(UPPER(BTRIM(Record2.FID_IssuingAuthorityCode)), '-1'))
        AND Record1.FID_RegistrationCountry IS NOT NULL
        AND Record2.FID_RegistrationCountry IS NOT NULL
        AND UPPER(BTRIM(Record1.FID_RegistrationCountry)) = UPPER(BTRIM(Record2.FID_RegistrationCountry))
        AND (Record1.LicenseIsPlaceholder IS NULL OR Record1.LicenseIsPlaceholder = '0')
        AND (Record2.LicenseIsPlaceholder IS NULL OR Record2.LicenseIsPlaceholder = '0')
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
      label: "MAT-02 : Name Match Key + Normalised Licence + Country + Authority (or null / Other) - Exact Match"
      matchScore: 98
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT06_ExactNameCountry
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND Record1.FID_RegistrationCountry IS NOT NULL
        AND Record2.FID_RegistrationCountry IS NOT NULL
        AND UPPER(BTRIM(Record1.NameMatchKey)) = UPPER(BTRIM(Record2.NameMatchKey))
        AND UPPER(BTRIM(Record1.FID_RegistrationCountry)) = UPPER(BTRIM(Record2.FID_RegistrationCountry))
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
      label: "MAT-06 : NameMatchKey + Country - Exact Match (steward review: name + country alone is not enough to auto-merge, legal-form suffixes are stripped from the key)"
      matchScore: 90
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT07_FuzzyNameCountry
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND Record1.FID_RegistrationCountry IS NOT NULL
        AND Record2.FID_RegistrationCountry IS NOT NULL
        AND UPPER(BTRIM(Record1.FID_RegistrationCountry)) = UPPER(BTRIM(Record2.FID_RegistrationCountry))
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameMatchKey)), UPPER(BTRIM(Record2.NameMatchKey))) >= 92
        AND SEM_EDIT_DISTANCE_SIMILARITY(REGEXP_REPLACE(UPPER(BTRIM(Record1.NameMatchKey)), ' .*$', ''), REGEXP_REPLACE(UPPER(BTRIM(Record2.NameMatchKey)), ' .*$', '')) >= 80
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
      label: "MAT-07 : Fuzzy Name (JW >= 92) + Country"
      matchScore: 80
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT10_FuzzyNameLicencePrefix
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND Record1.LicenseNoNormalised IS NOT NULL
        AND Record2.LicenseNoNormalised IS NOT NULL
        AND NULLIF(UPPER(BTRIM(Record1.FID_IssuingAuthorityCode)), '-1') IS NOT NULL
        AND NULLIF(UPPER(BTRIM(Record1.FID_IssuingAuthorityCode)), '-1') = NULLIF(UPPER(BTRIM(Record2.FID_IssuingAuthorityCode)), '-1')
        AND UPPER(BTRIM(Record1.LicenseNoNormalised)) = UPPER(BTRIM(Record2.LicenseNoNormalised))
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameMatchKey)), UPPER(BTRIM(Record2.NameMatchKey))) >= 90
        AND (Record1.LicenseIsPlaceholder IS NULL OR Record1.LicenseIsPlaceholder = '0')
        AND (Record2.LicenseIsPlaceholder IS NULL OR Record2.LicenseIsPlaceholder = '0')
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
      label: "MAT-10 : Fuzzy Name (JW >= 90) + Licence Prefix + Authority"
      matchScore: 95
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT01_NameTrnCountry
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND Record1.TrnMatchKey IS NOT NULL
        AND Record2.TrnMatchKey IS NOT NULL
        AND UPPER(BTRIM(Record1.NameMatchKey)) = UPPER(BTRIM(Record2.NameMatchKey))
        AND Record1.TrnMatchKey = Record2.TrnMatchKey
        AND Record1.FID_RegistrationCountry IS NOT NULL
        AND Record2.FID_RegistrationCountry IS NOT NULL
        AND UPPER(BTRIM(Record1.FID_RegistrationCountry)) = UPPER(BTRIM(Record2.FID_RegistrationCountry))
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
      label: "MAT-01 : NameMatchKey + TRN (match key) + Country - Exact Match"
      matchScore: 98
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT02B_NameLicenceAuthorityDiffers
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND Record1.LicenseNoNormalised IS NOT NULL
        AND Record2.LicenseNoNormalised IS NOT NULL
        AND UPPER(BTRIM(Record1.NameMatchKey)) = UPPER(BTRIM(Record2.NameMatchKey))
        AND UPPER(BTRIM(Record1.LicenseNoNormalised)) = UPPER(BTRIM(Record2.LicenseNoNormalised))
        AND Record1.FID_RegistrationCountry IS NOT NULL
        AND Record2.FID_RegistrationCountry IS NOT NULL
        AND UPPER(BTRIM(Record1.FID_RegistrationCountry)) = UPPER(BTRIM(Record2.FID_RegistrationCountry))
        AND NULLIF(UPPER(BTRIM(Record1.FID_IssuingAuthorityCode)), '-1') IS NOT NULL
        AND NULLIF(UPPER(BTRIM(Record2.FID_IssuingAuthorityCode)), '-1') IS NOT NULL
        AND NULLIF(UPPER(BTRIM(Record1.FID_IssuingAuthorityCode)), '-1') <> NULLIF(UPPER(BTRIM(Record2.FID_IssuingAuthorityCode)), '-1')
        AND (Record1.LicenseIsPlaceholder IS NULL OR Record1.LicenseIsPlaceholder = '0')
        AND (Record2.LicenseIsPlaceholder IS NULL OR Record2.LicenseIsPlaceholder = '0')
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
      label: "MAT-02 (2nd row) : Name Match Key + Normalised Licence + Country, Issuing Authority differs"
      matchScore: 80
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT08_ReorderedNameCountry
      condition: |-
        Record1.NameTokenKey IS NOT NULL
        AND Record2.NameTokenKey IS NOT NULL
        AND Record1.FID_RegistrationCountry IS NOT NULL
        AND Record2.FID_RegistrationCountry IS NOT NULL
        AND UPPER(BTRIM(Record1.FID_RegistrationCountry)) = UPPER(BTRIM(Record2.FID_RegistrationCountry))
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameTokenKey)), UPPER(BTRIM(Record2.NameTokenKey))) >= 90
        AND Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND ' ' || UPPER(BTRIM(Record2.NameTokenKey)) || ' ' LIKE '% ' || REGEXP_REPLACE(UPPER(BTRIM(Record1.NameMatchKey)), ' .*$', '') || ' %'
        AND ' ' || UPPER(BTRIM(Record1.NameTokenKey)) || ' ' LIKE '% ' || REGEXP_REPLACE(UPPER(BTRIM(Record2.NameMatchKey)), ' .*$', '') || ' %'
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
      label: "MAT-08 : Word-order-insensitive name (>= 90) + Country"
      matchScore: 70
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT09_FuzzyNameTrnPrefix
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND Record1.TrnMatchKey IS NOT NULL
        AND Record2.TrnMatchKey IS NOT NULL
        AND LENGTH(Record1.TrnMatchKey) >= 8
        AND LENGTH(Record2.TrnMatchKey) >= 8
        AND SUBSTR(Record1.TrnMatchKey, 1, 8) = SUBSTR(Record2.TrnMatchKey, 1, 8)
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameMatchKey)), UPPER(BTRIM(Record2.NameMatchKey))) >= 90
        AND SEM_EDIT_DISTANCE_SIMILARITY(REGEXP_REPLACE(UPPER(BTRIM(Record1.NameMatchKey)), ' .*$', ''), REGEXP_REPLACE(UPPER(BTRIM(Record2.NameMatchKey)), ' .*$', '')) >= 80
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
      label: "MAT-09 : Fuzzy Name (>= 90) + first 8 TRN digits"
      matchScore: 80
      usingMatchOn: false

    - _type: SemQLMatchRule
      _name: MAT14_WebsiteDomainName
      condition: |-
        Record1.WebsiteDomain IS NOT NULL
        AND Record2.WebsiteDomain IS NOT NULL
        AND Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND Record1.WebsiteDomain = Record2.WebsiteDomain
        AND UPPER(Record1.WebsiteDomain) NOT IN ('FACEBOOK.COM','LINKEDIN.COM','INSTAGRAM.COM','TWITTER.COM','X.COM','GOOGLE.COM','GMAIL.COM','YAHOO.COM','HOTMAIL.COM','OUTLOOK.COM','WORDPRESS.COM','WIX.COM','BLOGSPOT.COM','YOUTUBE.COM')
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameMatchKey)), UPPER(BTRIM(Record2.NameMatchKey))) >= 85
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
      label: "MAT-14 : Website domain (non-generic) + Name (>= 85)"
      matchScore: 70
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MAT04_NameAccountBankCountry
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND UPPER(BTRIM(Record1.NameMatchKey)) = UPPER(BTRIM(Record2.NameMatchKey))
        AND (
          (Record1.PrimaryAccountKey IS NOT NULL AND Record2.BankAccountKeys IS NOT NULL AND STRPOS(Record2.BankAccountKeys, '|' || Record1.PrimaryAccountKey || '|') > 0)
          OR (Record2.PrimaryAccountKey IS NOT NULL AND Record1.BankAccountKeys IS NOT NULL AND STRPOS(Record1.BankAccountKeys, '|' || Record2.PrimaryAccountKey || '|') > 0)
        )
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
      label: "MAT-04 : Name Match Key + bank account number + bank country"
      matchScore: 96
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MAT05_NameIban
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND UPPER(BTRIM(Record1.NameMatchKey)) = UPPER(BTRIM(Record2.NameMatchKey))
        AND (
          (Record1.PrimaryIbanKey IS NOT NULL AND Record2.BankAccountKeys IS NOT NULL AND STRPOS(Record2.BankAccountKeys, '|' || Record1.PrimaryIbanKey || '|') > 0)
          OR (Record2.PrimaryIbanKey IS NOT NULL AND Record1.BankAccountKeys IS NOT NULL AND STRPOS(Record1.BankAccountKeys, '|' || Record2.PrimaryIbanKey || '|') > 0)
        )
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
      label: "MAT-05 : Name Match Key + IBAN (also for non-trade payees, MAT-17)"
      matchScore: 97
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MAT11_NameAddress
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameMatchKey)), UPPER(BTRIM(Record2.NameMatchKey))) >= 88
        AND Record1.PrimaryAddressLine1 IS NOT NULL
        AND Record2.PrimaryAddressLine1 IS NOT NULL
        AND SEM_EDIT_DISTANCE_SIMILARITY(Record1.PrimaryAddressLine1, Record2.PrimaryAddressLine1) >= 85
        AND Record1.PrimaryAddressCity IS NOT NULL
        AND Record1.PrimaryAddressCity = Record2.PrimaryAddressCity
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
      label: "MAT-11 : Name (>= 88) + address line 1 (>= 85) + city"
      matchScore: 80
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MAT12_NameEmailDomain
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameMatchKey)), UPPER(BTRIM(Record2.NameMatchKey))) >= 90
        AND (
          (Record1.PrimaryEmailDomain IS NOT NULL AND Record2.ContactEmailDomains IS NOT NULL AND STRPOS(Record2.ContactEmailDomains, '|' || Record1.PrimaryEmailDomain || '|') > 0)
          OR (Record2.PrimaryEmailDomain IS NOT NULL AND Record1.ContactEmailDomains IS NOT NULL AND STRPOS(Record1.ContactEmailDomains, '|' || Record2.PrimaryEmailDomain || '|') > 0)
        )
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
      label: "MAT-12 : Name (>= 90) + contact corporate e-mail domain"
      matchScore: 80
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: MAT13_NameSharedBank
      condition: |-
        Record1.NameMatchKey IS NOT NULL
        AND Record2.NameMatchKey IS NOT NULL
        AND SEM_EDIT_DISTANCE_SIMILARITY(UPPER(BTRIM(Record1.NameMatchKey)), UPPER(BTRIM(Record2.NameMatchKey))) >= 85
        AND (
          (Record1.PrimaryIbanKey IS NOT NULL AND Record2.BankAccountKeys IS NOT NULL AND STRPOS(Record2.BankAccountKeys, '|' || Record1.PrimaryIbanKey || '|') > 0)
          OR (Record2.PrimaryIbanKey IS NOT NULL AND Record1.BankAccountKeys IS NOT NULL AND STRPOS(Record1.BankAccountKeys, '|' || Record2.PrimaryIbanKey || '|') > 0)
          OR (Record1.PrimaryAccountKey IS NOT NULL AND Record2.BankAccountKeys IS NOT NULL AND STRPOS(Record2.BankAccountKeys, '|' || Record1.PrimaryAccountKey || '|') > 0)
          OR (Record2.PrimaryAccountKey IS NOT NULL AND Record1.BankAccountKeys IS NOT NULL AND STRPOS(Record1.BankAccountKeys, '|' || Record2.PrimaryAccountKey || '|') > 0)
        )
        AND UPPER(COALESCE(Record1.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND UPPER(COALESCE(Record2.AccountStatusCode, '')) NOT IN ('INACTIVE', 'I')
        AND NOT (Record1.TrnMatchKey IS NOT NULL AND Record2.TrnMatchKey IS NOT NULL AND Record1.TrnMatchKey <> Record2.TrnMatchKey)
        AND COALESCE(Record1.NonTradeFlag,'N') <> 'Y'
        AND COALESCE(Record2.NonTradeFlag,'N') <> 'Y'
        AND (Record1.IsHolding IS NULL OR Record1.IsHolding = '0')
        AND (Record2.IsHolding IS NULL OR Record2.IsHolding = '0')
