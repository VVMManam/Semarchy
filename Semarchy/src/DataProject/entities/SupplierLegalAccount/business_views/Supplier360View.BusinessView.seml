  referenceAttributeNavigationConfigs: []
  transitions:
  - _name: Sites
    _type: BusinessViewTransition
    transitionPath: SupplierSite
    transitionType: FULLY_QUALIFIED
    useCustomLabel: true
    iconUrl: images://mdi/office-building-marker.svg
    displayFormTabAs: ICON_LABEL
    displayTransitionNodeAs: ICON_LABEL
    enableHierarchy: '1'
    enableHierarchyInterpreter: LITERAL
    expandHierarchyByDefault: false
    transitionVisible: '1'
    transitionVisibleInterpreter: LITERAL
    businessViewEntity:
      _name: SitesEntity
      _type: BusinessViewEntity
      collection: DataProject.entities.SupplierSite.collection_views.SupplierSiteGolden
      displayRecordCount: ALWAYS
      enableUserDefinedSort: true
      entity: DataProject.entities.SupplierSite.SupplierSite
      form: DataProject.entities.SupplierSite.forms.Supplier360Site
      gridAllowed: false
      listAllowed: false
      outlineVisible: false
      overrideDefaultSort: false
      tableAllowed: true
      businessEntityBuiltInFilters: []
      businessEntitySearchConfigs:
      - _name: TextConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: TEXT
        enabled: true
      - _name: FormConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: BY_FORM
        enabled: true
      - _name: AdvancedConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: ADVANCED
        enabled: true
      - _name: SemqlConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: SEMQL
        enabled: true
      embeddedCollectionNavigations:
      - formCollection: DataProject.entities.SupplierSite.forms.Supplier360Site.SiteAssignmentsTab.SiteAsgSection.SiteAsgList
