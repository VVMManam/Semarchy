_name: Supplier360View
_package: DataProject.entities.SupplierLegalAccount.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: true
entity: DataProject.entities.SupplierLegalAccount.SupplierLegalAccount
rootLabel: Supplier Golden Record
rootPluralLabel: Supplier Golden Records
useHierarchyOnOpen: false
label: Supplier Golden Records
rootBusinessViewEntity:
  _name: Supplier
  _type: BusinessViewEntity
  collection: DataProject.entities.SupplierLegalAccount.collection_views.SupplierLegalAccount
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: DataProject.entities.SupplierLegalAccount.SupplierLegalAccount
  form: DataProject.entities.SupplierLegalAccount.forms.Supplier360
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: false
  tableAllowed: true
  actionSet: DataProject.entities.SupplierLegalAccount.ActionSets.SupplierGolden
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
  - _name: TextConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: TEXT
    enabled: true
  - _name: FormConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: BY_FORM
    enabled: true
  - _name: AdvancedConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: ADVANCED
    enabled: true
  - _name: SemqlConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: SEMQL
    enabled: true
  embeddedCollectionNavigations:
  - formCollection: DataProject.entities.SupplierLegalAccount.forms.Supplier360.IdentifiersTab.SupIdentifiers.SupIdentifierList
    browsingTarget: MODAL_FORM
    form: DataProject.entities.Identifier.forms.Supplier360Identifier
  - formCollection: DataProject.entities.SupplierLegalAccount.forms.Supplier360.TaxRegistrationsTab.SupTaxRegs.SupTaxRegList
    browsingTarget: MODAL_FORM
