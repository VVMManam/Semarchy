    - _type: FormContainer
      _name: OvMainC2
      layoutDirection: COLUMN
      content:
      - _name: OvPrimaryContact
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">Primary contact<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">focal point first</span></div>'' || COALESCE(LOOKUP first ''<div style="border:1px solid #E1E7EE;border-radius:6px;padding:12px 14px;background:#fff"><div style="font-size:14px;font-weight:500">'' || COALESCE(REPLACE(REPLACE(REPLACE(CONCAT_WS('' '', FirstName, MiddleName, LastName), ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || CASE WHEN JobTitle IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || '' · '' || REPLACE(REPLACE(REPLACE(JobTitle, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div><div style="margin-top:6px">'' || CASE WHEN PrimaryFocalPoint = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;">Focal point</span>'' ELSE '''' END || CASE WHEN PrimaryFinancialPoint = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Finance focal</span>'' ELSE '''' END || CASE WHEN PrimaryAdminContact = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Admin contact</span>'' ELSE '''' END || CASE WHEN ContactStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(ContactStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(ContactStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(ContactStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || ContactStatusCode || ''</span>'' WHEN UPPER(ContactStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || ContactStatusCode || ''</span>'' WHEN UPPER(ContactStatusCode) LIKE ''%PEND%'' OR UPPER(ContactStatusCode) LIKE ''%REVIEW%'' OR UPPER(ContactStatusCode) LIKE ''%PROCESS%'' OR UPPER(ContactStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || ContactStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || ContactStatusCode || ''</span>'' END || ''</div><div style="color:#66727F;font-size:14px;margin-top:4px">'' || COALESCE(REPLACE(REPLACE(REPLACE(Email, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || '' · '' || COALESCE(CONCAT_WS('' '', MobileDialCode, Mobile), ''—'') || ''</div><div style="font-size:14px;color:#66727F;margin-top:6px">Site '' || COALESCE(FDN_SupplierSite, ''—'') || '' · Contact ID '' || TO_CHAR(ContactId, ''FM999999999999990'') || ''</div></div>'' FROM SupplierSite.Contact ORDER BY PrimaryFocalPoint DESC, PrimaryFinancialPoint DESC END, ''<div style="color:#66727F">No contacts linked to any site of this supplier.</div>'') || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Primary contact
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
