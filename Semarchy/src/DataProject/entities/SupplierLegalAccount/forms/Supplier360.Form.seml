      - _name: OvCommercial
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">Commercial defaults<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">supplier-level; sites and BU assignments can override</span></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Payment term</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(FDN_PaymentTermCode, ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Currency</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(FDN_Currency, ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Default payment method</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(REPLACE(REPLACE(REPLACE(DefaultPaymentMethodCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Remittance advice</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(REPLACE(REPLACE(REPLACE(RemitAdviceDeliveryCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || CASE WHEN RemitAdviceEmail IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || '' · '' || REPLACE(REPLACE(REPLACE(RemitAdviceEmail, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Withholding tax</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN AllowWithholdingTax = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Allowed</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not allowed</span>'' END || CASE WHEN WithholdingTaxGroupCode IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || ''group '' || REPLACE(REPLACE(REPLACE(WithholdingTaxGroupCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Exclusive payment</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN ExclusivePayment = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">Yes</span>'' ELSE ''No'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Website</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN Website IS NULL THEN ''—'' ELSE ''<a target="_blank" href="'' || CASE WHEN LOWER(Website) LIKE ''http%'' THEN Website ELSE ''https://'' || Website END || ''">'' || REPLACE(REPLACE(REPLACE(Website, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</a>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Year established</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN YearEstablished IS NULL THEN ''—'' ELSE TO_CHAR(YearEstablished, ''FM999999999999990'') END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Chief executive</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(REPLACE(REPLACE(REPLACE(ChiefExecutiveName, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || CASE WHEN ChiefExecutiveTitle IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || '' · '' || REPLACE(REPLACE(REPLACE(ChiefExecutiveTitle, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 218px;text-align:left;padding:1px 16px 0 0;color:rgba(0,0,0,0.6);font-size:14px">Active from</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(TO_CHAR(StartDateActive, ''DD Mon YYYY''), ''—'') || CASE WHEN EndDateActive IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || '' · ends '' || TO_CHAR(EndDateActive, ''DD Mon YYYY'') || ''</span>'' END || ''</div></div>'' || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Commercial defaults
