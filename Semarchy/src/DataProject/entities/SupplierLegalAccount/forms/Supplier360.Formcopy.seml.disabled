  content:
  - _type: FormSection
    _name: AsgSection
    label: Site assignments by business unit
    layoutDirection: COLUMN
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    content:
    - _type: FormContainer
      _name: AsgC
      layoutDirection: COLUMN
      content:
      - _name: AsgTable
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="background:#FDF3DC;border-left:3px solid #F2B134;padding:8px 12px;font-size:14px;border-radius:0 4px 4px 0;margin:0 0 12px 0;color:#1B2530">A <b>Site Assignment</b> enables a supplier site for one client business unit and carries the BU-level terms: bill-to BU and location, ship-to location, payment term, withholding and default accounts. Lineage: Supplier → Site → Assignment.</div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Client BUs</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(LOOKUP distinct_string_agg CASE WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''CO%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#009FE3;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''DC%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''DIG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#A286BF;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''IZ%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''IND%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#F9423A;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''LG%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''LOG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#70D547;color:#12330A;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''MT%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''MAR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#14C5BD;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''PT%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''POR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#B0D6E3;color:#0D3B4C;">'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E0E0E0;color:#212121;">'' END || FDN_ClientBuCode || ''</span>'' SEPARATED BY '' '' FROM SupplierSite.SupplierSiteAssignment WHERE FID_ClientBuCode IS NOT NULL END, ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Assignments</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || TO_CHAR(LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END, ''FM999999999999990'') || ''<span style="color:#66727F;font-size:14px">'' || '' across '' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite END, ''FM999999999999990'') || '' sites'' || ''</span>'' || ''</div></div>'' || ''<div style="height:8px"></div>'' || ''<div style="overflow-x:auto;border:1px solid #E1E7EE;border-radius:6px"><table style="width:100%;border-collapse:collapse"><tr><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Site</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Client BU</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Bill-to BU</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Bill-to location</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Ship-to location</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Payment term</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Withholding</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Accounting</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Status</th></tr>'' || COALESCE(LOOKUP string_agg ''<tr>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || ''<b style="font-weight:500">'' || COALESCE(FDN_SupplierSite, ''—'') || ''</b><br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''Assignment '' || TO_CHAR(AssignmentId, ''FM999999999999990'') || ''</span>'' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN FDN_ClientBuCode IS NULL THEN ''—'' ELSE CASE WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''CO%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#009FE3;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''DC%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''DIG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#A286BF;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''IZ%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''IND%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#F9423A;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''LG%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''LOG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#70D547;color:#12330A;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''MT%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''MAR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#14C5BD;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''PT%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''POR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#B0D6E3;color:#0D3B4C;">'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E0E0E0;color:#212121;">'' END || FDN_ClientBuCode || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN FDN_BillToBuCode IS NULL THEN ''—'' ELSE CASE WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''CO%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#009FE3;color:#FFFFFF;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''DC%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''DIG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#A286BF;color:#FFFFFF;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''IZ%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''IND%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#F9423A;color:#FFFFFF;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''LG%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''LOG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#70D547;color:#12330A;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''MT%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''MAR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#14C5BD;color:#FFFFFF;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''PT%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''POR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#B0D6E3;color:#0D3B4C;">'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E0E0E0;color:#212121;">'' END || FDN_BillToBuCode || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(FDN_BillToLocationCode, ''—'') || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(FDN_ShipToLocationCode, ''—'') || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(FDN_PaymentTermCode, ''—'') || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN AllowWithholdingTax = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Allowed</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">No</span>'' END || CASE WHEN WithholdingTaxGroupCode IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || REPLACE(REPLACE(REPLACE(WithholdingTaxGroupCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || ''<span style="color:#66727F;font-size:14px">'' || ''Liability '' || ''</span>'' || CASE WHEN LiabilityDistributionAccount IS NULL THEN ''—'' ELSE ''<span style="font-family:Consolas,Menlo,monospace;font-size:14px">'' || REPLACE(REPLACE(REPLACE(LiabilityDistributionAccount, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''Prepayment '' || ''</span>'' || CASE WHEN PrepaymentAccount IS NULL THEN ''—'' ELSE ''<span style="font-family:Consolas,Menlo,monospace;font-size:14px">'' || REPLACE(REPLACE(REPLACE(PrepaymentAccount, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || CASE WHEN DistributionSet IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''Distribution set '' || REPLACE(REPLACE(REPLACE(DistributionSet, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN RecordStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(RecordStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(RecordStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(RecordStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) LIKE ''%PEND%'' OR UPPER(RecordStatusCode) LIKE ''%REVIEW%'' OR UPPER(RecordStatusCode) LIKE ''%PROCESS%'' OR UPPER(RecordStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || RecordStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || RecordStatusCode || ''</span>'' END || CASE WHEN InactiveDate IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''inactive from '' || TO_CHAR(InactiveDate, ''DD Mon YYYY'') || ''</span>'' END || ''</td>'' || ''</tr>'' SEPARATED BY '''' FROM SupplierSite.SupplierSiteAssignment END, ''<tr><td colspan="9" style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px;color:#66727F;text-align:center">No site assignments for this supplier</td></tr>'') || ''</table></div>'' || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Site assignments
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
        authoringMode: force-browsing
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          contentHeight: CASE WHEN LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END <= 0 THEN '254' WHEN LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END <= 1 THEN '254' WHEN LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END <= 2 THEN '318' WHEN LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END <= 4 THEN '446' WHEN LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END <= 6 THEN '574' WHEN LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END <= 9 THEN '766' WHEN LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END <= 12 THEN '820' ELSE '820' END
          contentHeightValueInterpreter: SEMQL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: body-1
          typographyValueInterpreter: LITERAL
          isVisible: '0'
          isVisibleValueInterpreter: LITERAL
- _name: ContactsTab
  _type: FormTab
  labelWidth: 180px
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  label: Contacts
  iconUrl: images://mdi/account-box-multiple.svg
  displayFormTabAs: ICON_LABEL
  content:
  - _type: FormSection
    _name: ConSection
    label: Contacts & purposes
    layoutDirection: COLUMN
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    content:
    - _type: FormContainer
      _name: ConC
      layoutDirection: COLUMN
      content:
      - _name: ConTables
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="background:#FDF3DC;border-left:3px solid #F2B134;padding:8px 12px;font-size:14px;border-radius:0 4px 4px 0;margin:0 0 12px 0;color:#1B2530">Contacts belong to a supplier site; each can hold several purposes (Contact → Contact Purpose). Emirates ID and passport numbers are masked here — open the contact record to see the full value where your role allows.</div>'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">Contacts<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">all sites</span></div>'' || ''<div style="overflow-x:auto;border:1px solid #E1E7EE;border-radius:6px"><table style="width:100%;border-collapse:collapse"><tr><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Contact</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Site</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Roles</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Email</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Mobile / phone</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Nationality</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Emirates ID</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Passport</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Portal user</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Status</th></tr>'' || COALESCE(LOOKUP string_agg ''<tr>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || ''<b style="font-weight:500">'' || COALESCE(REPLACE(REPLACE(REPLACE(CONCAT_WS('' '', FirstName, MiddleName, LastName), ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</b>'' || CASE WHEN FullNameAr IS NULL THEN '''' ELSE ''<div dir="auto" style="text-align:left;color:#66727F;unicode-bidi:plaintext">'' || REPLACE(REPLACE(REPLACE(FullNameAr, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</div>'' END || CASE WHEN JobTitle IS NULL THEN '''' ELSE ''<div>'' || ''<span style="color:#66727F;font-size:14px">'' || REPLACE(REPLACE(REPLACE(JobTitle, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' || ''</div>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(FDN_SupplierSite, ''—'') || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN PrimaryFocalPoint = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;">Focal point</span>'' ELSE '''' END || CASE WHEN PrimaryFinancialPoint = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Finance</span>'' ELSE '''' END || CASE WHEN PrimaryAdminContact = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Admin</span>'' ELSE '''' END || '''' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN Email IS NULL THEN ''—'' ELSE ''<a href="mailto:'' || Email || ''">'' || REPLACE(REPLACE(REPLACE(Email, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</a>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(CONCAT_WS('' '', MobileDialCode, Mobile), ''—'') || CASE WHEN BusinessPhone IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''office '' || CONCAT_WS('' '', BusinessPhoneDialCode, BusinessPhone) || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(FDN_NationalityCode, ''—'') || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || ''<span style="font-family:Consolas,Menlo,monospace">'' || CASE WHEN EmiratesId IS NULL THEN ''—'' ELSE LEFT(EmiratesId, 3) || ''-••••-•••••••-'' || RIGHT(EmiratesId, 1) END || ''</span>'' || CASE WHEN EmiratesIdExpiryDate IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''exp. '' || TO_CHAR(EmiratesIdExpiryDate, ''DD Mon YYYY'') || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || ''<span style="font-family:Consolas,Menlo,monospace">'' || CASE WHEN PassportNumber IS NULL THEN ''—'' ELSE LEFT(PassportNumber, 2) || ''•••••'' || RIGHT(PassportNumber, 1) END || ''</span>'' || CASE WHEN PassportExpiryDate IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''exp. '' || TO_CHAR(PassportExpiryDate, ''DD Mon YYYY'') || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN HasUserAccount = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">'' || COALESCE(REPLACE(REPLACE(REPLACE(UserName, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''User'') || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">None</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN ContactStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(ContactStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(ContactStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(ContactStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || ContactStatusCode || ''</span>'' WHEN UPPER(ContactStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || ContactStatusCode || ''</span>'' WHEN UPPER(ContactStatusCode) LIKE ''%PEND%'' OR UPPER(ContactStatusCode) LIKE ''%REVIEW%'' OR UPPER(ContactStatusCode) LIKE ''%PROCESS%'' OR UPPER(ContactStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || ContactStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || ContactStatusCode || ''</span>'' END || ''</td>'' || ''</tr>'' SEPARATED BY '''' FROM SupplierSite.Contact END, ''<tr><td colspan="10" style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px;color:#66727F;text-align:center">No contacts for this supplier</td></tr>'') || ''</table></div>'' || ''<div style="height:16px"></div>'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">Contact purposes<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">what each contact is authorised or responsible for</span></div>'' || ''<div style="overflow-x:auto;border:1px solid #E1E7EE;border-radius:6px"><table style="width:100%;border-collapse:collapse"><tr><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Contact</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Purpose / role</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Scope</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Primary</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Effective</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Status</th></tr>'' || COALESCE(LOOKUP string_agg ''<tr>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(FDN_ContactId, ''—'') || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">'' || COALESCE(COALESCE(FDN_ContactRoleCode, ContactRole), ''—'') || ''</span>'' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(ScopeTypeCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN IsPrimaryFocalPoint = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;">Focal</span>'' ELSE '''' END || CASE WHEN IsPrimaryFinanceFocal = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Finance</span>'' ELSE '''' END || '''' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN EffectiveFrom IS NULL THEN ''—'' ELSE TO_CHAR(EffectiveFrom, ''DD Mon YYYY'') END || '' → '' || CASE WHEN EffectiveTo IS NULL THEN ''open'' ELSE TO_CHAR(EffectiveTo, ''DD Mon YYYY'') END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN RecordStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(RecordStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(RecordStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(RecordStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) LIKE ''%PEND%'' OR UPPER(RecordStatusCode) LIKE ''%REVIEW%'' OR UPPER(RecordStatusCode) LIKE ''%PROCESS%'' OR UPPER(RecordStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || RecordStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || RecordStatusCode || ''</span>'' END || ''</td>'' || ''</tr>'' SEPARATED BY '''' FROM SupplierSite.Contact.ContactPurpose END, ''<tr><td colspan="6" style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px;color:#66727F;text-align:center">No contact purposes recorded</td></tr>'') || ''</table></div>'' || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Contacts
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
        authoringMode: force-browsing
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          contentHeight: CASE WHEN 64 * LOOKUP count ContactId FROM SupplierSite.Contact END + 46 * LOOKUP count ContactPurposeId FROM SupplierSite.Contact.ContactPurpose END <= 130 THEN '370' WHEN 64 * LOOKUP count ContactId FROM SupplierSite.Contact END + 46 * LOOKUP count ContactPurposeId FROM SupplierSite.Contact.ContactPurpose END <= 250 THEN '490' WHEN 64 * LOOKUP count ContactId FROM SupplierSite.Contact END + 46 * LOOKUP count ContactPurposeId FROM SupplierSite.Contact.ContactPurpose END <= 400 THEN '640' WHEN 64 * LOOKUP count ContactId FROM SupplierSite.Contact END + 46 * LOOKUP count ContactPurposeId FROM SupplierSite.Contact.ContactPurpose END <= 560 THEN '800' WHEN 64 * LOOKUP count ContactId FROM SupplierSite.Contact END + 46 * LOOKUP count ContactPurposeId FROM SupplierSite.Contact.ContactPurpose END <= 720 THEN '960' ELSE '1100' END
          contentHeightValueInterpreter: SEMQL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: body-1
          typographyValueInterpreter: LITERAL
          isVisible: '0'
          isVisibleValueInterpreter: LITERAL
- _name: AddressesTab
  _type: FormTab
  labelWidth: 180px
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  label: Addresses
  iconUrl: images://mdi/map-marker-multiple.svg
  displayFormTabAs: ICON_LABEL
  content:
  - _type: FormSection
    _name: AdrSection
    label: Addresses across all sites
    layoutDirection: COLUMN
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    content:
    - _type: FormContainer
      _name: AdrC
      layoutDirection: COLUMN
      content:
      - _name: AdrTable
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="background:#FDF3DC;border-left:3px solid #F2B134;padding:8px 12px;font-size:14px;border-radius:0 4px 4px 0;margin:0 0 12px 0;color:#1B2530">Addresses hang off a supplier site (Address → Site). A site can also point to its main address through its Address Name reference.</div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Address usages</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(LOOKUP distinct_string_agg AddressUsageCode SEPARATED BY '', '' FROM SupplierSite.Address WHERE AddressUsageCode IS NOT NULL END, ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Countries</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(LOOKUP distinct_string_agg COALESCE(FDN_CountryCode, Country) SEPARATED BY '', '' FROM SupplierSite.Address END, ''—'') || ''</div></div>'' || ''<div style="height:8px"></div>'' || ''<div style="overflow-x:auto;border:1px solid #E1E7EE;border-radius:6px"><table style="width:100%;border-collapse:collapse"><tr><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Usage</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Site</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Address</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">City / emirate / country</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">PO box</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Purposes</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Contact</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Status</th></tr>'' || COALESCE(LOOKUP string_agg ''<tr>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN AddressUsageCode IS NULL THEN ''—'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;">'' || REPLACE(REPLACE(REPLACE(AddressUsageCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || CASE WHEN IsPrimary = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0B2A4A;color:#FFFFFF;">Primary</span>'' ELSE '''' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(FDN_SupplierSite, ''—'') || CASE WHEN PartySiteName IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || REPLACE(REPLACE(REPLACE(PartySiteName, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(CONCAT_WS('', '', AddressLine1, AddressLine2, AddressLine3, AddressLine4), ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || CASE WHEN Area IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || REPLACE(REPLACE(REPLACE(Area, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''<br><a target="_blank" href="'' || CASE WHEN Latitude IS NOT NULL AND Longitude IS NOT NULL THEN ''https://www.google.com/maps/search/?api=1&query='' || SEM_NUMBER_TO_CHAR(Latitude) || '','' || SEM_NUMBER_TO_CHAR(Longitude) ELSE ''https://www.google.com/maps/search/?api=1&query='' || REGEXP_REPLACE(CONCAT_WS('', '', AddressLine1, AddressLine2, AddressLine3, AddressLine4, Area, City, FDN_EmirateCode, COALESCE(FDN_CountryCode, Country)), ''[&#?+, ]+'', ''+'', ''g'') END || ''">View on map</a>'' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(COALESCE(CityNormalised, City), ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || COALESCE(FDN_EmirateCode, ''—'') || '' · '' || COALESCE(COALESCE(FDN_CountryCode, Country), ''—'') || ''</span>'' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(PoBox, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || CASE WHEN PostalCode IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''postal '' || REPLACE(REPLACE(REPLACE(PostalCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN OrderingPurpose = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Ordering</span>'' ELSE '''' END || CASE WHEN RemittoPurpose = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Remit-to</span>'' ELSE '''' END || CASE WHEN RFQBiddingPurpose = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">RFQ / bidding</span>'' ELSE '''' END || '''' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(Email, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || COALESCE(CONCAT_WS('' '', PhoneCountryCode, PhoneAreaCode, Phone), ''—'') || ''</span>'' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN RecordStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(RecordStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(RecordStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(RecordStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) LIKE ''%PEND%'' OR UPPER(RecordStatusCode) LIKE ''%REVIEW%'' OR UPPER(RecordStatusCode) LIKE ''%PROCESS%'' OR UPPER(RecordStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || RecordStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || RecordStatusCode || ''</span>'' END || CASE WHEN InactiveDate IS NULL THEN '''' ELSE ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''inactive from '' || TO_CHAR(InactiveDate, ''DD Mon YYYY'') || ''</span>'' END || ''</td>'' || ''</tr>'' SEPARATED BY '''' FROM SupplierSite.Address END, ''<tr><td colspan="8" style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px;color:#66727F;text-align:center">No addresses for this supplier</td></tr>'') || ''</table></div>'' || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Addresses
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
        authoringMode: force-browsing
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          contentHeight: CASE WHEN LOOKUP count AddressId FROM SupplierSite.Address END <= 0 THEN '268' WHEN LOOKUP count AddressId FROM SupplierSite.Address END <= 1 THEN '268' WHEN LOOKUP count AddressId FROM SupplierSite.Address END <= 2 THEN '346' WHEN LOOKUP count AddressId FROM SupplierSite.Address END <= 4 THEN '502' WHEN LOOKUP count AddressId FROM SupplierSite.Address END <= 6 THEN '658' WHEN LOOKUP count AddressId FROM SupplierSite.Address END <= 9 THEN '892' WHEN LOOKUP count AddressId FROM SupplierSite.Address END <= 12 THEN '900' ELSE '900' END
          contentHeightValueInterpreter: SEMQL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: body-1
          typographyValueInterpreter: LITERAL
          isVisible: '0'
          isVisibleValueInterpreter: LITERAL
