_package: DataProject.entities.SupplierLegalAccount.forms
_type: Form
_name: Supplier360Copy
entity: DataProject.entities.SupplierLegalAccount.SupplierLegalAccount
default: false
formTabs:
- _name: Overview
  _type: FormTab
  labelWidth: 180px
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  label: Overview
  iconUrl: images://mdi/view-dashboard.svg
  displayFormTabAs: ICON_LABEL
  content:
  - _type: FormSection
    _name: OvHeaderSection
    label: Supplier at a glance
    layoutDirection: ROW
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    content:
    - _type: FormContainer
      _name: OvHeaderC
      layoutDirection: COLUMN
      content:
      - _name: OvHeader
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap">'' || ''<div style="flex:0 0 56px;width:56px;height:56px;border-radius:8px;background:#0F7C8C;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:24px">'' || UPPER(LEFT(COALESCE(NameEn, ''?''), 2)) || ''</div>'' || ''<div style="flex:1;min-width:300px">'' || ''<div style="font-size:22px;font-weight:500;line-height:1.2">'' || COALESCE(REPLACE(REPLACE(REPLACE(NameEn, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</div>'' || CASE WHEN NameAlternate IS NULL THEN '''' ELSE ''<div dir="auto" style="text-align:left;font-size:18px;color:#66727F;margin-top:2px;unicode-bidi:plaintext">'' || REPLACE(REPLACE(REPLACE(NameAlternate, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</div>'' END || ''<div style="margin-top:10px">'' || ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;border:1px solid #CBD5E0;font-family:Consolas,Menlo,monospace;font-weight:400">'' || ''SGID '' || TO_CHAR(Sgid, ''FM999999999999990'') || ''</span>'' || CASE WHEN SupplierNumber IS NULL THEN '''' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;border:1px solid #CBD5E0;font-family:Consolas,Menlo,monospace;font-weight:400">'' || ''Supplier # '' || REPLACE(REPLACE(REPLACE(SupplierNumber, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || CASE WHEN AccountStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(AccountStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(AccountStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(AccountStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || AccountStatusCode || ''</span>'' WHEN UPPER(AccountStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || AccountStatusCode || ''</span>'' WHEN UPPER(AccountStatusCode) LIKE ''%PEND%'' OR UPPER(AccountStatusCode) LIKE ''%REVIEW%'' OR UPPER(AccountStatusCode) LIKE ''%PROCESS%'' OR UPPER(AccountStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || AccountStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || AccountStatusCode || ''</span>'' END || CASE WHEN SupplierTypeCode IS NULL THEN '''' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;">'' || CASE WHEN SupplierTypeCode = ''LIMITED'' THEN ''Limited Liability Company'' WHEN SupplierTypeCode = ''BRANCH_OFFICE'' THEN ''Principal'' WHEN SupplierTypeCode = ''PARTNERSHIP'' THEN ''Intercompany Partner'' WHEN SupplierTypeCode = ''RELATED_PARTY'' THEN ''Related Party'' WHEN SupplierTypeCode = ''FOREIGN_COMPANY'' THEN ''Foreign Company'' WHEN SupplierTypeCode = ''GLOBAL_AGENCY_PARTNER'' THEN ''Global Agency Partner'' WHEN SupplierTypeCode = ''SOLE'' THEN ''Sole Proprietorship'' WHEN SupplierTypeCode = ''OTHERS'' THEN ''Others'' WHEN SupplierTypeCode = ''SUPPLIER'' THEN ''Supplier'' WHEN SupplierTypeCode = ''TAX_AUTHORITY'' THEN ''Tax Authority'' WHEN SupplierTypeCode = ''SUB_CONTRACTOR'' THEN ''Subcontractor'' WHEN SupplierTypeCode = ''PUBLIC_SECTOR_COMPANIES'' THEN ''Public Sector'' WHEN SupplierTypeCode = ''GOVERNMENT'' THEN ''Government'' WHEN SupplierTypeCode = ''INSURANCE'' THEN ''Insurance Company'' WHEN SupplierTypeCode = ''FEDERAL'' THEN ''Federal'' WHEN SupplierTypeCode = ''CONTRACTOR'' THEN ''Contractor'' WHEN SupplierTypeCode = ''TRANSPORTADOR'' THEN ''Carrier'' WHEN SupplierTypeCode = ''ATTORNEY'' THEN ''Attorney'' WHEN SupplierTypeCode = ''UTILITY'' THEN ''Utility'' WHEN SupplierTypeCode = ''TRUST'' THEN ''Trust'' WHEN SupplierTypeCode = ''SERVICES'' THEN ''Services'' WHEN SupplierTypeCode = ''MANUFACTURING'' THEN ''Manufacturing'' WHEN SupplierTypeCode = ''CRM_AGENT'' THEN ''CRM Agent'' ELSE SupplierTypeCode END || ''</span>'' END || CASE WHEN SupplierState IS NULL THEN '''' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">'' || ''State: '' || REPLACE(REPLACE(REPLACE(SupplierState, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || CASE WHEN IsGovernmentEntity = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0B2A4A;color:#FFFFFF;">Government entity</span>'' ELSE '''' END || CASE WHEN IsOneTimeSupplier = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">One-time supplier</span>'' ELSE '''' END || CASE WHEN IsHolding = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Holding company</span>'' ELSE '''' END || CASE WHEN LicenseNumber IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">No licence on file</span>'' WHEN LicenseExpiryDate IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">Licence expiry not set</span>'' WHEN LicenseExpiryDate < NOW() THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || ''Licence expired '' || TO_CHAR(LicenseExpiryDate, ''DD Mon YYYY'') || ''</span>'' WHEN LicenseExpiryDate < NOW() + MAKE_INTERVAL(0, 0, 0, 90, 0, 0, 0) THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || ''Licence expires '' || TO_CHAR(LicenseExpiryDate, ''DD Mon YYYY'') || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || ''Licence valid to '' || TO_CHAR(LicenseExpiryDate, ''DD Mon YYYY'') || ''</span>'' END || ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">'' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite END, ''FM999999999999990'') || '' sites · '' || TO_CHAR(LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END, ''FM999999999999990'') || '' BU assignments</span>'' || ''</div></div>'' || ''<div style="display:flex;gap:18px;flex-wrap:wrap;padding-top:4px">'' || ''<div style="text-align:right;min-width:78px"><div style="font-size:22px;font-weight:500;line-height:1;color:#0F7C8C">'' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite END, ''FM999999999999990'') || ''</div><div style="font-size:14px;color:#66727F;margin-top:3px">Sites</div></div>'' || ''<div style="text-align:right;min-width:78px"><div style="font-size:22px;font-weight:500;line-height:1;color:#0F7C8C">'' || TO_CHAR(LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END, ''FM999999999999990'') || ''</div><div style="font-size:14px;color:#66727F;margin-top:3px">Assignments</div></div>'' || ''<div style="text-align:right;min-width:78px"><div style="font-size:22px;font-weight:500;line-height:1;color:#0F7C8C">'' || TO_CHAR(LOOKUP count ContactId FROM SupplierSite.Contact END, ''FM999999999999990'') || ''</div><div style="font-size:14px;color:#66727F;margin-top:3px">Contacts</div></div>'' || ''<div style="text-align:right;min-width:78px"><div style="font-size:22px;font-weight:500;line-height:1;color:#0F7C8C">'' || TO_CHAR(LOOKUP count AddressId FROM SupplierSite.Address END, ''FM999999999999990'') || ''</div><div style="font-size:14px;color:#66727F;margin-top:3px">Addresses</div></div>'' || ''<div style="text-align:right;min-width:78px"><div style="font-size:22px;font-weight:500;line-height:1;color:#0F7C8C">'' || TO_CHAR(LOOKUP count BankAccountID FROM SupplierBankAccount END, ''FM999999999999990'') || ''</div><div style="font-size:14px;color:#66727F;margin-top:3px">Bank accounts</div></div>'' || CASE WHEN LOOKUP count ConstraintName FROM Errors END > 0 THEN ''<div style="text-align:right;min-width:78px"><div style="font-size:22px;font-weight:500;line-height:1;color:#B8321E">'' || TO_CHAR(LOOKUP count ConstraintName FROM Errors END, ''FM999999999999990'') || ''</div><div style="font-size:14px;color:#66727F;margin-top:3px">Open DQ issues</div></div>'' ELSE ''<div style="text-align:right;min-width:78px"><div style="font-size:22px;font-weight:500;line-height:1;color:#1F7A4D">'' || ''0'' || ''</div><div style="font-size:14px;color:#66727F;margin-top:3px">Open DQ issues</div></div>'' END || ''</div></div>'' || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Header
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
        authoringMode: force-browsing
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          contentHeight: '140'
          contentHeightValueInterpreter: LITERAL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: body-1
          typographyValueInterpreter: LITERAL
          isVisible: '0'
          isVisibleValueInterpreter: LITERAL
  - _type: FormSection
    _name: OvMainSection
    label: Supplier profile
    layoutDirection: ROW
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    content:
    - _type: FormContainer
      _name: OvMainC1
      layoutDirection: COLUMN
      content:
      - _name: OvIdentity
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">Legal identity & licence<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">golden values</span></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Legal name (EN)</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(REPLACE(REPLACE(REPLACE(NameEn, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Alternate name</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN NameAlternate IS NULL THEN ''—'' ELSE ''<span dir="auto" style="text-align:left;unicode-bidi:plaintext">'' || REPLACE(REPLACE(REPLACE(NameAlternate, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Supplier number</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN SupplierNumber IS NULL THEN ''—'' ELSE ''<span style="font-family:Consolas,Menlo,monospace;font-size:14px">'' || REPLACE(REPLACE(REPLACE(SupplierNumber, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Fusion supplier ID</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN FusionSupplierId IS NULL THEN ''—'' ELSE ''<span style="font-family:Consolas,Menlo,monospace;font-size:14px">'' || REPLACE(REPLACE(REPLACE(FusionSupplierId, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Supplier code</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN SupplierCode IS NULL THEN ''—'' ELSE ''<span style="font-family:Consolas,Menlo,monospace;font-size:14px">'' || REPLACE(REPLACE(REPLACE(SupplierCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Supplier type</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(CASE WHEN SupplierTypeCode = ''LIMITED'' THEN ''Limited Liability Company'' WHEN SupplierTypeCode = ''BRANCH_OFFICE'' THEN ''Principal'' WHEN SupplierTypeCode = ''PARTNERSHIP'' THEN ''Intercompany Partner'' WHEN SupplierTypeCode = ''RELATED_PARTY'' THEN ''Related Party'' WHEN SupplierTypeCode = ''FOREIGN_COMPANY'' THEN ''Foreign Company'' WHEN SupplierTypeCode = ''GLOBAL_AGENCY_PARTNER'' THEN ''Global Agency Partner'' WHEN SupplierTypeCode = ''SOLE'' THEN ''Sole Proprietorship'' WHEN SupplierTypeCode = ''OTHERS'' THEN ''Others'' WHEN SupplierTypeCode = ''SUPPLIER'' THEN ''Supplier'' WHEN SupplierTypeCode = ''TAX_AUTHORITY'' THEN ''Tax Authority'' WHEN SupplierTypeCode = ''SUB_CONTRACTOR'' THEN ''Subcontractor'' WHEN SupplierTypeCode = ''PUBLIC_SECTOR_COMPANIES'' THEN ''Public Sector'' WHEN SupplierTypeCode = ''GOVERNMENT'' THEN ''Government'' WHEN SupplierTypeCode = ''INSURANCE'' THEN ''Insurance Company'' WHEN SupplierTypeCode = ''FEDERAL'' THEN ''Federal'' WHEN SupplierTypeCode = ''CONTRACTOR'' THEN ''Contractor'' WHEN SupplierTypeCode = ''TRANSPORTADOR'' THEN ''Carrier'' WHEN SupplierTypeCode = ''ATTORNEY'' THEN ''Attorney'' WHEN SupplierTypeCode = ''UTILITY'' THEN ''Utility'' WHEN SupplierTypeCode = ''TRUST'' THEN ''Trust'' WHEN SupplierTypeCode = ''SERVICES'' THEN ''Services'' WHEN SupplierTypeCode = ''MANUFACTURING'' THEN ''Manufacturing'' WHEN SupplierTypeCode = ''CRM_AGENT'' THEN ''CRM Agent'' ELSE SupplierTypeCode END, ''—'') || CASE WHEN OrganizationTypeCode IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || '' · org type '' || REPLACE(REPLACE(REPLACE(OrganizationTypeCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Business relationship</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(REPLACE(REPLACE(REPLACE(BusinessRelationshipCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Registered in</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(FDN_RegistrationCountry, ''—'') || CASE WHEN FDN_RegistrationEmirateCode IS NULL THEN '''' ELSE '' · '' || FDN_RegistrationEmirateCode END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Trade licence</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN LicenseNumber IS NULL THEN ''—'' ELSE ''<span style="font-family:Consolas,Menlo,monospace;font-size:14px">'' || REPLACE(REPLACE(REPLACE(LicenseNumber, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || '' '' || CASE WHEN LicenseValidityStatusCode IS NULL THEN '''' ELSE CASE WHEN LicenseValidityStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(LicenseValidityStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(LicenseValidityStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(LicenseValidityStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || LicenseValidityStatusCode || ''</span>'' WHEN UPPER(LicenseValidityStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || LicenseValidityStatusCode || ''</span>'' WHEN UPPER(LicenseValidityStatusCode) LIKE ''%PEND%'' OR UPPER(LicenseValidityStatusCode) LIKE ''%REVIEW%'' OR UPPER(LicenseValidityStatusCode) LIKE ''%PROCESS%'' OR UPPER(LicenseValidityStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || LicenseValidityStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || LicenseValidityStatusCode || ''</span>'' END END || CASE WHEN LicenseIsPlaceholder = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">Placeholder value</span>'' ELSE '''' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Licence type</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(FDN_LicenseTypeCode, ''—'') || CASE WHEN FDN_IssuingAuthorityCode IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || '' · issued by '' || FDN_IssuingAuthorityCode || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Licence term</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN LicenseStartDate IS NULL THEN ''—'' ELSE TO_CHAR(LicenseStartDate, ''DD Mon YYYY'') END || '' → '' || CASE WHEN LicenseExpiryDate IS NULL THEN ''open'' ELSE TO_CHAR(LicenseExpiryDate, ''DD Mon YYYY'') END || ''<br>'' || CASE WHEN LicenseNumber IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">No licence on file</span>'' WHEN LicenseExpiryDate IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">Licence expiry not set</span>'' WHEN LicenseExpiryDate < NOW() THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || ''Licence expired '' || TO_CHAR(LicenseExpiryDate, ''DD Mon YYYY'') || ''</span>'' WHEN LicenseExpiryDate < NOW() + MAKE_INTERVAL(0, 0, 0, 90, 0, 0, 0) THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || ''Licence expires '' || TO_CHAR(LicenseExpiryDate, ''DD Mon YYYY'') || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || ''Licence valid to '' || TO_CHAR(LicenseExpiryDate, ''DD Mon YYYY'') || ''</span>'' END || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">VAT TRN</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || CASE WHEN VATRegistrationNumber IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not registered</span>'' ELSE ''<span style="font-family:Consolas,Menlo,monospace;font-size:14px">'' || REPLACE(REPLACE(REPLACE(VATRegistrationNumber, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</div></div>'' || ''</div>'''
        dataType: STRING
