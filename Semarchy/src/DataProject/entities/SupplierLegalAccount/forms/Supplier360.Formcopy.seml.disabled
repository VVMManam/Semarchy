          isVisibleValueInterpreter: LITERAL
      - _name: OvPrimaryAddress
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">Primary address<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">primary flag first</span></div>'' || COALESCE(LOOKUP first ''<div style="border:1px solid #E1E7EE;border-radius:6px;padding:12px 14px;background:#fff"><div style="margin-bottom:6px">'' || CASE WHEN AddressUsageCode IS NULL THEN '''' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;">'' || REPLACE(REPLACE(REPLACE(AddressUsageCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || CASE WHEN IsPrimary = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0B2A4A;color:#FFFFFF;">Primary</span>'' ELSE '''' END || CASE WHEN RecordStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(RecordStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(RecordStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(RecordStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) LIKE ''%PEND%'' OR UPPER(RecordStatusCode) LIKE ''%REVIEW%'' OR UPPER(RecordStatusCode) LIKE ''%PROCESS%'' OR UPPER(RecordStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || RecordStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || RecordStatusCode || ''</span>'' END || ''</div><div style="font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(CONCAT_WS('', '', AddressLine1, AddressLine2, AddressLine3, AddressLine4, Area, City, FDN_EmirateCode, COALESCE(FDN_CountryCode, Country)), ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</div>'' || CASE WHEN PoBox IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || ''PO Box '' || REPLACE(REPLACE(REPLACE(PoBox, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''<div style="font-size:14px;color:#66727F;margin-top:6px">Site '' || COALESCE(FDN_SupplierSite, ''—'') || '' · '' || ''<a target="_blank" href="'' || CASE WHEN Latitude IS NOT NULL AND Longitude IS NOT NULL THEN ''https://www.google.com/maps/search/?api=1&query='' || SEM_NUMBER_TO_CHAR(Latitude) || '','' || SEM_NUMBER_TO_CHAR(Longitude) ELSE ''https://www.google.com/maps/search/?api=1&query='' || REGEXP_REPLACE(CONCAT_WS('', '', AddressLine1, AddressLine2, AddressLine3, AddressLine4, Area, City, FDN_EmirateCode, COALESCE(FDN_CountryCode, Country)), ''[&#?+, ]+'', ''+'', ''g'') END || ''">View on map</a></div></div>'' FROM SupplierSite.Address ORDER BY IsPrimary DESC END, ''<div style="color:#66727F">No addresses linked to any site of this supplier.</div>'') || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Primary address
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
        authoringMode: force-browsing
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          contentHeight: '190'
          contentHeightValueInterpreter: LITERAL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: body-1
          typographyValueInterpreter: LITERAL
          isVisible: '0'
          isVisibleValueInterpreter: LITERAL
      - _name: OvFootprint
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">BU footprint<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">where ADPG buys from this supplier</span></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Procurement BUs</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(LOOKUP distinct_string_agg CASE WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''CO%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#009FE3;color:#FFFFFF;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''DC%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''DIG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#A286BF;color:#FFFFFF;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''IZ%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''IND%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#F9423A;color:#FFFFFF;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''LG%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''LOG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#70D547;color:#12330A;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''MT%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''MAR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#14C5BD;color:#FFFFFF;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''PT%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''POR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#B0D6E3;color:#0D3B4C;">'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E0E0E0;color:#212121;">'' END || FDN_ProcurementBuCode || ''</span>'' SEPARATED BY '' '' FROM SupplierSite WHERE FID_ProcurementBuCode IS NOT NULL END, ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Client BUs (assigned)</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(LOOKUP distinct_string_agg CASE WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''CO%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#009FE3;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''DC%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''DIG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#A286BF;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''IZ%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''IND%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#F9423A;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''LG%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''LOG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#70D547;color:#12330A;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''MT%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''MAR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#14C5BD;color:#FFFFFF;">'' WHEN UPPER(ClientBuCode.FID_ClusterCode) LIKE ''PT%'' OR UPPER(ClientBuCode.FID_ClusterCode) LIKE ''POR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#B0D6E3;color:#0D3B4C;">'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E0E0E0;color:#212121;">'' END || FDN_ClientBuCode || ''</span>'' SEPARATED BY '' '' FROM SupplierSite.SupplierSiteAssignment WHERE FID_ClientBuCode IS NOT NULL END, ''—'') || ''</div></div>'' || ''<div style="display:flex;align-items:flex-start;margin:0 0 6px 0"><div style="flex:0 0 165px;text-align:right;padding:1px 14px 0 0;color:#66727F;font-size:14px">Bill-to BUs</div><div style="flex:1;font-size:14px;min-width:0;word-break:break-word">'' || COALESCE(LOOKUP distinct_string_agg CASE WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''CO%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#009FE3;color:#FFFFFF;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''DC%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''DIG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#A286BF;color:#FFFFFF;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''IZ%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''IND%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#F9423A;color:#FFFFFF;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''LG%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''LOG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#70D547;color:#12330A;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''MT%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''MAR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#14C5BD;color:#FFFFFF;">'' WHEN UPPER(BillToBuCode.FID_ClusterCode) LIKE ''PT%'' OR UPPER(BillToBuCode.FID_ClusterCode) LIKE ''POR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#B0D6E3;color:#0D3B4C;">'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E0E0E0;color:#212121;">'' END || FDN_BillToBuCode || ''</span>'' SEPARATED BY '' '' FROM SupplierSite.SupplierSiteAssignment WHERE FID_BillToBuCode IS NOT NULL END, ''—'') || ''</div></div>'' || ''<div style="font-size:14px;color:#66727F;margin-top:6px">Chip colour = cluster: <span style="color:#009FE3">■</span> Corporate <span style="color:#A286BF">■</span> Digital <span style="color:#F9423A">■</span> Industrial <span style="color:#70D547">■</span> Logistics <span style="color:#14C5BD">■</span> Maritime <span style="color:#B0D6E3">■</span> Ports</div>'' || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: BU footprint
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
        authoringMode: force-browsing
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          contentHeight: '170'
          contentHeightValueInterpreter: LITERAL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: body-1
          typographyValueInterpreter: LITERAL
          isVisible: '0'
          isVisibleValueInterpreter: LITERAL
      - _name: OvDataQuality
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">Data quality & steward hints<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">validation errors on the golden record, plus completeness checks</span></div>'' || COALESCE(LOOKUP string_agg ''<div style="display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #E1E7EE;font-size:14px"><span style="width:8px;height:8px;border-radius:50%;background:#B8321E;margin-top:6px;flex:none"></span><div>'' || CASE WHEN ConstraintName LIKE ''%SupplierNameMandatory%'' THEN ''Supplier name is missing'' WHEN ConstraintName LIKE ''%SupplierTypeMandatory%'' THEN ''Supplier type is missing or not in the Supplier Type list'' WHEN ConstraintName LIKE ''%LicenceNotExpired%'' THEN ''Licence dates are missing or inconsistent'' WHEN ConstraintName LIKE ''%IssuingAuthorityCodeResolved%'' THEN ''Issuing authority could not be resolved to a reference code'' WHEN ConstraintName LIKE ''%ValidatingIssuingAuthority%'' THEN ''Issuing authority check failed for the licence'' WHEN ConstraintName LIKE ''%LicenseTypeResolved%'' THEN ''Licence type could not be resolved to a reference code'' WHEN ConstraintName LIKE ''%BusinessRelationshipDomain%'' THEN ''Business relationship value is outside the allowed list'' ELSE ConstraintName END || ''<div style="font-size:14px;color:#66727F">'' || ''Validation · '' || ConstraintType || ''</div></div></div>'' SEPARATED BY '''' FROM Errors END, '''') || CASE WHEN LOOKUP count SiteId FROM SupplierSite WHERE PrimaryPaySiteFlag = ''1'' END = 0 THEN ''<div style="display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #E1E7EE;font-size:14px"><span style="width:8px;height:8px;border-radius:50%;background:#F2B134;margin-top:6px;flex:none"></span><div>'' || ''No primary pay site is flagged'' || ''<div style="font-size:14px;color:#66727F">'' || ''Completeness · sites'' || ''</div></div></div>'' ELSE '''' END || CASE WHEN LOOKUP count SiteId FROM SupplierSite END > 0 AND LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END = 0 THEN ''<div style="display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #E1E7EE;font-size:14px"><span style="width:8px;height:8px;border-radius:50%;background:#F2B134;margin-top:6px;flex:none"></span><div>'' || ''Sites exist but none is assigned to a client BU'' || ''<div style="font-size:14px;color:#66727F">'' || ''Completeness · site assignments'' || ''</div></div></div>'' ELSE '''' END || CASE WHEN LOOKUP count ContactId FROM SupplierSite.Contact WHERE PrimaryFocalPoint = ''1'' END = 0 THEN ''<div style="display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #E1E7EE;font-size:14px"><span style="width:8px;height:8px;border-radius:50%;background:#0F7C8C;margin-top:6px;flex:none"></span><div>'' || ''No contact is marked as primary focal point'' || ''<div style="font-size:14px;color:#66727F">'' || ''Completeness · contacts'' || ''</div></div></div>'' ELSE '''' END || CASE WHEN LOOKUP count AddressId FROM SupplierSite.Address WHERE IsPrimary = ''1'' END = 0 THEN ''<div style="display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #E1E7EE;font-size:14px"><span style="width:8px;height:8px;border-radius:50%;background:#0F7C8C;margin-top:6px;flex:none"></span><div>'' || ''No primary address on any site'' || ''<div style="font-size:14px;color:#66727F">'' || ''Completeness · addresses'' || ''</div></div></div>'' ELSE '''' END || CASE WHEN LicenseExpiryDate IS NOT NULL AND LicenseExpiryDate < NOW() + MAKE_INTERVAL(0, 0, 0, 90, 0, 0, 0) THEN ''<div style="display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #E1E7EE;font-size:14px"><span style="width:8px;height:8px;border-radius:50%;background:#F2B134;margin-top:6px;flex:none"></span><div>'' || ''Licence '' || CASE WHEN LicenseExpiryDate < NOW() THEN ''expired on '' ELSE ''expires on '' END || TO_CHAR(LicenseExpiryDate, ''DD Mon YYYY'') || ''<div style="font-size:14px;color:#66727F">'' || ''Compliance · trade licence'' || ''</div></div></div>'' ELSE '''' END || CASE WHEN LOOKUP count ConstraintName FROM Errors END = 0 THEN ''<div style="font-size:14px;color:#1F7A4D;padding-top:6px">✔ No validation errors on the golden record</div>'' ELSE '''' END || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Data quality
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
        authoringMode: force-browsing
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          contentHeight: CASE WHEN LOOKUP count ConstraintName FROM Errors END <= 0 THEN '250' WHEN LOOKUP count ConstraintName FROM Errors END <= 1 THEN '250' WHEN LOOKUP count ConstraintName FROM Errors END <= 2 THEN '300' WHEN LOOKUP count ConstraintName FROM Errors END <= 4 THEN '400' WHEN LOOKUP count ConstraintName FROM Errors END <= 6 THEN '480' WHEN LOOKUP count ConstraintName FROM Errors END <= 9 THEN '480' WHEN LOOKUP count ConstraintName FROM Errors END <= 12 THEN '480' ELSE '480' END
          contentHeightValueInterpreter: SEMQL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: body-1
          typographyValueInterpreter: LITERAL
          isVisible: '0'
          isVisibleValueInterpreter: LITERAL
  - _type: FormSection
    _name: OvLineageSection
    label: Record lineage
    layoutDirection: ROW
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    content:
    - _type: FormContainer
      _name: OvLineageC
      layoutDirection: COLUMN
      content:
      - _name: OvLineage
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="font-size:14px;font-weight:500;color:#0B2A4A;border-bottom:1px solid #E1E7EE;padding-bottom:5px;margin:0 0 9px 0">Record lineage<span style="font-weight:400;color:#66727F;font-size:14px;margin-left:8px">how this supplier and its child records hang together</span></div>'' || ''<ul style="list-style:none;margin:0;padding:0"><li style="padding:0">'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #0F7C8C;background:#E3F2F4;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Supplier</b>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">SupplierLegalAccount · this record</span>'' || '' <span style="font-size:12px;color:#66727F">source: '' || COALESCE(FDN_SourceSystemCode, ''—'') || ''</span>'' || ''</span>'' || ''<ul style="list-style:none;margin:6px 0 0 18px;padding:0 0 0 16px;border-left:1px solid #CBD5E0">'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Supplier Sites</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">SupplierSite.Sgid → Supplier</span>'' || ''</span>'' || ''<ul style="list-style:none;margin:6px 0 0 18px;padding:0 0 0 16px;border-left:1px solid #CBD5E0">'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Site Assignments</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count AssignmentId FROM SupplierSite.SupplierSiteAssignment END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">SupplierSiteAssignment.SupplierSite → Site · BU-level terms</span>'' || ''</span>'' || ''</li>'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Contacts</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count ContactId FROM SupplierSite.Contact END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">Contact.SupplierSite → Site</span>'' || ''</span>'' || ''<ul style="list-style:none;margin:6px 0 0 18px;padding:0 0 0 16px;border-left:1px solid #CBD5E0">'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Contact Purposes</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count ContactPurposeId FROM SupplierSite.Contact.ContactPurpose END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">ContactPurpose.ContactId → Contact</span>'' || ''</span>'' || ''</li>'' || ''</ul>'' || ''</li>'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Addresses</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count AddressId FROM SupplierSite.Address END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">Address.SupplierSite → Site</span>'' || ''</span>'' || ''</li>'' || ''</ul>'' || ''</li>'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Identifiers</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count IdentifierId FROM Identifier END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">Identifier.Sgid → Supplier</span>'' || ''</span>'' || ''</li>'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Tax Registrations</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count TaxRegistrationId FROM TaxRegistration END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">TaxRegistration.Sgid → Supplier</span>'' || ''</span>'' || ''</li>'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Bank Accounts</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count BankAccountID FROM SupplierBankAccount END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">SupplierBankAccount.Sgid → Supplier</span>'' || ''</span>'' || ''</li>'' || ''<li style="position:relative;padding:5px 0"><span style="position:absolute;left:-16px;top:17px;width:12px;border-top:1px solid #CBD5E0"></span>'' || ''<span style="display:inline-flex;align-items:center;gap:6px;border:1px solid #E1E7EE;background:#FFFFFF;border-radius:6px;padding:5px 10px;font-size:14px"><b style="font-weight:500">Licence Activities</b>'' || '' <span style="display:inline-block;background:#0B2A4A;color:#fff;border-radius:9px;font-size:14px;padding:0 7px;margin-left:6px">'' || TO_CHAR(LOOKUP count LicenseActivityId FROM LicenseActivity END, ''FM999999999999990'') || ''</span>'' || ''<span style="font-size:12px;color:#66727F;margin-left:6px">LicenseActivity.Sgid → Supplier</span>'' || ''</span>'' || ''</li>'' || ''</ul></li></ul>'' || ''<div style="font-size:14px;color:#66727F;margin-top:8px">Open a site from the <b>Supplier Sites</b> tab or the navigation tree to drill into its assignments, contacts and addresses as individual records.</div>'' || ''</div>'''
        dataType: STRING
