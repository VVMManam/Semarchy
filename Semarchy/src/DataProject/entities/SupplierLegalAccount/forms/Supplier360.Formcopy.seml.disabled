- _name: SupplierSitesTab
  _type: FormTab
  labelWidth: 180px
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  label: Supplier Sites
  iconUrl: images://mdi/office-building-marker.svg
  displayFormTabAs: ICON_LABEL
  content:
  - _type: FormSection
    _name: SitesSummarySection
    label: Sites overview
    layoutDirection: COLUMN
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    content:
    - _type: FormContainer
      _name: SitesSummaryC
      layoutDirection: COLUMN
      content:
      - _name: SitesSummary
        value: '''<div style="margin:0;padding:0;font-family:Roboto,Segoe UI,Arial,sans-serif;color:#1B2530;line-height:1.45">'' || ''<div style="background:#FDF3DC;border-left:3px solid #F2B134;padding:8px 12px;font-size:14px;border-radius:0 4px 4px 0;margin:0 0 12px 0;color:#1B2530">A <b>Supplier Site</b> is where ADPG transacts with the supplier (purchasing and/or paying). Each site carries its own BU assignments, contacts and addresses. Open a site in the list below to see those as editable records.</div>'' || ''<div style="margin:0 0 10px 0">'' || ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0B2A4A;color:#FFFFFF;">'' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite END, ''FM999999999999990'') || '' sites</span>'' || ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">'' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite WHERE PurchasingSiteFlag = ''1'' END, ''FM999999999999990'') || '' purchasing</span>'' || ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">'' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite WHERE PaySiteFlag = ''1'' END, ''FM999999999999990'') || '' pay</span>'' || ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;">'' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite WHERE PrimaryPaySiteFlag = ''1'' END, ''FM999999999999990'') || '' primary pay</span>'' || CASE WHEN LOOKUP count SiteId FROM SupplierSite WHERE HoldAllPaymentsFlag = ''1'' END > 0 THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || TO_CHAR(LOOKUP count SiteId FROM SupplierSite WHERE HoldAllPaymentsFlag = ''1'' END, ''FM999999999999990'') || '' on payment hold</span>'' ELSE '''' END || ''</div>'' || ''<div style="overflow-x:auto;border:1px solid #E1E7EE;border-radius:6px"><table style="width:100%;border-collapse:collapse"><tr><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Site</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Procurement BU</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Purpose</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Payment</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Currency (invoice / payment)</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Communication</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Controls</th><th style="text-align:left;font-weight:500;color:#66727F;font-size:14px;padding:7px 10px;border-bottom:1px solid #E1E7EE;white-space:nowrap;background:#F7F9FB">Status</th></tr>'' || COALESCE(LOOKUP string_agg ''<tr>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || ''<b style="font-weight:500">'' || COALESCE(REPLACE(REPLACE(REPLACE(SiteCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</b><br>'' || ''<span style="color:#66727F;font-size:14px">'' || ''ID '' || TO_CHAR(SiteId, ''FM999999999999990'') || ''</span>'' || CASE WHEN FDN_AddressName IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || ''<br>Address: '' || REPLACE(REPLACE(REPLACE(FDN_AddressName, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN FDN_ProcurementBuCode IS NULL THEN ''—'' ELSE CASE WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''CO%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#009FE3;color:#FFFFFF;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''DC%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''DIG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#A286BF;color:#FFFFFF;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''IZ%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''IND%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#F9423A;color:#FFFFFF;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''LG%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''LOG%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#70D547;color:#12330A;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''MT%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''MAR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#14C5BD;color:#FFFFFF;">'' WHEN UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''PT%'' OR UPPER(ProcurementBuCode.FID_ClusterCode) LIKE ''POR%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#B0D6E3;color:#0D3B4C;">'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E0E0E0;color:#212121;">'' END || FDN_ProcurementBuCode || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN PurchasingSiteFlag = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Purchasing</span>'' ELSE '''' END || CASE WHEN PaySiteFlag = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E7EEF7;color:#0B2A4A;">Pay</span>'' ELSE '''' END || CASE WHEN PrimaryPaySiteFlag = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#0F7C8C;color:#FFFFFF;">Primary pay</span>'' ELSE '''' END || CASE WHEN RfqOnlySiteFlag = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">RFQ only</span>'' ELSE '''' END || CASE WHEN PcardSiteFlag = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">P-card</span>'' ELSE '''' END || CASE WHEN TaxReportingSiteFlag = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">Tax reporting</span>'' ELSE '''' END || '''' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(FDN_PaymentTermCode, ''—'') || ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(PaymentMethodCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || '' · pay group '' || COALESCE(REPLACE(REPLACE(REPLACE(PayGroupCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</span>'' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(InvoiceCurrencyCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || '' / '' || COALESCE(REPLACE(REPLACE(REPLACE(PaymentCurrencyCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || COALESCE(REPLACE(REPLACE(REPLACE(Email, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;''), ''—'') || ''<br>'' || ''<span style="color:#66727F;font-size:14px">'' || COALESCE(CONCAT_WS('' '', PhoneCountryCode, PhoneAreaCode, Phone), ''—'') || ''</span>'' || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN HoldAllPaymentsFlag = ''1'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Payments on hold</span>'' ELSE '''' END || CASE WHEN MatchOptionCode IS NULL THEN '''' ELSE ''<span style="color:#66727F;font-size:14px">'' || ''match '' || REPLACE(REPLACE(REPLACE(MatchOptionCode, ''&'', ''&amp;''), ''<'', ''&lt;''), ''>'', ''&gt;'') || ''</span>'' END || ''</td>'' || ''<td style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px">'' || CASE WHEN RecordStatusCode IS NULL THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#fff;color:#66727F;border:1px dashed #CBD5E0;font-weight:400">Not set</span>'' WHEN UPPER(RecordStatusCode) IN (''A'', ''ACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">Active</span>'' WHEN UPPER(RecordStatusCode) IN (''I'', ''INACTIVE'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">Inactive</span>'' WHEN UPPER(RecordStatusCode) IN (''VALID'', ''APPROVED'', ''CURRENT'', ''ENABLED'', ''REGISTERED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#E2F3EA;color:#1F7A4D;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) IN (''EXPIRED'', ''DENIED'', ''REJECTED'', ''SUSPENDED'', ''BLOCKED'', ''DISABLED'', ''CLOSED'') THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FBE7E3;color:#B8321E;">'' || RecordStatusCode || ''</span>'' WHEN UPPER(RecordStatusCode) LIKE ''%PEND%'' OR UPPER(RecordStatusCode) LIKE ''%REVIEW%'' OR UPPER(RecordStatusCode) LIKE ''%PROCESS%'' OR UPPER(RecordStatusCode) LIKE ''%DRAFT%'' THEN ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#FDF3DC;color:#8A5A00;">'' || RecordStatusCode || ''</span>'' ELSE ''<span style="display:inline-block;border-radius:12px;padding:2px 10px;margin:0 6px 4px 0;font-size:14px;font-weight:500;line-height:18px;white-space:nowrap;background:#EEF1F4;color:#3C4652;">'' || RecordStatusCode || ''</span>'' END || ''</td>'' || ''</tr>'' SEPARATED BY '''' FROM SupplierSite END, ''<tr><td colspan="8" style="padding:8px 10px;border-bottom:1px solid #E1E7EE;vertical-align:top;font-size:14px;color:#66727F;text-align:center">No sites for this supplier</td></tr>'') || ''</table></div>'' || ''</div>'''
        dataType: STRING
        useCustomLabel: true
        label: Sites
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        _type: MarkdownField
        authoringMode: force-browsing
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          contentHeight: CASE WHEN LOOKUP count SiteId FROM SupplierSite END <= 0 THEN '252' WHEN LOOKUP count SiteId FROM SupplierSite END <= 1 THEN '252' WHEN LOOKUP count SiteId FROM SupplierSite END <= 2 THEN '334' WHEN LOOKUP count SiteId FROM SupplierSite END <= 4 THEN '498' WHEN LOOKUP count SiteId FROM SupplierSite END <= 6 THEN '662' WHEN LOOKUP count SiteId FROM SupplierSite END <= 9 THEN '760' WHEN LOOKUP count SiteId FROM SupplierSite END <= 12 THEN '760' ELSE '760' END
          contentHeightValueInterpreter: SEMQL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: body-1
          typographyValueInterpreter: LITERAL
          isVisible: '0'
          isVisibleValueInterpreter: LITERAL
