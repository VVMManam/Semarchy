_package: DataProject.entities.SupplierLegalAccount.forms
_type: Form
_name: SupplierPartyLink
entity: DataProject.entities.SupplierLegalAccount.SupplierLegalAccount
default: false
formTabs:
  - _name: Main
    _type: FormTab
    labelWidth: "180px"
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    label: "Link to Party"
    iconUrl: images://mdi/link-variant.svg
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: LinkSection
        label: "Link the selected supplier(s) to a party"
        layoutDirection: ROW
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: LinkC1
            layoutDirection: COLUMN
            content:
              - _name: Party
                value: FDN_Pgid
                dataType: STRING
                referencedEntity: DataProject.entities.Party.Party
                useCustomLabel: true
                label: "Party"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: ReferenceField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  displayType: chip
                  displayTypeValueInterpreter: LITERAL
                  useAvatarInChip: '0'
                  useAvatarInChipValueInterpreter: LITERAL
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
      - _type: FormSection
        _name: SupplierSection
        label: "Supplier"
        layoutDirection: ROW
        documentationInterpreter: LITERAL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: SupplierC1
            layoutDirection: COLUMN
            content:
              - _name: NameEn
                value: NameEn
                dataType: STRING
                useCustomLabel: true
                label: "Supplier Name"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: '0'
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: '3'
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: '1'
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: '0'
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
              - _name: LicenseNumber
                value: LicenseNumber
                dataType: STRING
                useCustomLabel: true
                label: "Licence Number"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: '0'
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: '3'
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: '1'
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: '0'
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
          - _type: FormContainer
            _name: SupplierC2
            layoutDirection: COLUMN
            content:
              - _name: IssuingAuthority
                value: FDN_IssuingAuthorityCode
                dataType: STRING
                referencedEntity: DataProject.entities.IssuingAuthority.IssuingAuthority
                useCustomLabel: true
                label: "Issuing Authority"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: ReferenceField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  displayType: chip
                  displayTypeValueInterpreter: LITERAL
                  useAvatarInChip: '0'
                  useAvatarInChipValueInterpreter: LITERAL
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
              - _name: RegistrationCountry
                value: FDN_RegistrationCountry
                dataType: STRING
                referencedEntity: DataProject.entities.Country.CountryReference
                useCustomLabel: true
                label: "Country"
                documentationInterpreter: LITERAL
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                _type: ReferenceField
                authoringMode: force-browsing
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  displayType: chip
                  displayTypeValueInterpreter: LITERAL
                  useAvatarInChip: '0'
                  useAvatarInChipValueInterpreter: LITERAL
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: subhead
                  textTypographyValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: body-1
                  typographyValueInterpreter: LITERAL
                  isVisible: '1'
                  isVisibleValueInterpreter: LITERAL
