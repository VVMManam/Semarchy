              - _name: OvDqStatus
                value: CASE WHEN LOOKUP count ConstraintName FROM Errors END > 0 THEN 'Has data quality issues' ELSE 'No data quality issues' END
                dataType: STRING
                useCustomLabel: true
                documentationInterpreter: LITERAL
                visibleValue: '1'
