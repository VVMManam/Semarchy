              - _name: OvDqIssues
                value: 'LOOKUP distinct_string_agg CASE WHEN ConstraintName LIKE ''%LicenceNotExpired%'' THEN ''Licence expiry date is not after the start date'' WHEN ConstraintName LIKE ''%ValidatingIssuingAuthority%'' THEN ''Issuing authority check failed for the licence'' ELSE ConstraintName || '' ('' || ConstraintType || '')'' END SEPARATED BY ''

                  '' FROM Errors END'
                dataType: STRING
                useCustomLabel: true
                documentationInterpreter: LITERAL
