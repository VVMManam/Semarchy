_name: PartySteward
_package: DataProject.model_privilage_grant
_type: DataProductPrivGrant
description: "Party stewards - Party Application only. Full access to Party; customers and suppliers are read-only except the Party link (Pgid). No access to bank, payment or outstanding data."
allowApiPublishingAsUser: false
allowDataQualityDocumentation: true
allowEnrichmentDocumentation: false
dataAdminRole: false
integrationWsRole: false
label: Party Steward
roleName: MDM_Party_Steward
entityPrivGrants:
  - _name: Party
    _type: EntityPrivGrant
    entity: DataProject.entities.Party.Party
    attributePrivGrants: []
    defaultAccessType: READ_WRITE
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: false
